            if h then
                SetStatus("Đã lấy được Valkyrie Helm! Hop Low để refresh...")
                HopLow()
                return
            end
        end
    end
    return
end

if not hasMirror then
    if TweenTo(POS_CAKE_LOAF) and LaunchRealKidHop(DESTINATIONS.DOUGH_KING) then
        while not Stopped() and task.wait(2) do
            SetStatus("Thiếu Mirror Fractal -> Hop Dough King...")
            local _, m = CheckInvItems()
            if m then
                SetStatus("Đã lấy được Mirror Fractal! Hop Low để refresh...")
                HopLow()
                return
            end
        end
    end
    return
