        SleepCheck(1.5)
    end
    WaitAlive()
    SleepCheck(0.8)
end

local Data = LocalPlayer:WaitForChild("Data")
local function GetRace() return tostring(Data:WaitForChild("Race").Value) end
local function GetBeli() return tonumber(Data:WaitForChild("Beli").Value) or 0 end
local function GetFragments() return tonumber(Data:WaitForChild("Fragments").Value) or 0 end
local function GetSea() return SEA_PLACES[game.PlaceId] or 0 end

local function IsNight()
    local ct = Lighting.ClockTime
    return ct >= 18 or ct < 5
end

local function HasBlueFlower()
    local bp = LocalPlayer:FindFirstChild("Backpack")
    local ch = LocalPlayer.Character
    return (bp and (bp:FindFirstChild("Flower 1") or bp:FindFirstChild("Flower1")) ~= nil)
        or (ch and (ch:FindFirstChild("Flower 1") or ch:FindFirstChild("Flower1")) ~= nil)
        or false
end

local V3Abilities = {
    Human = "Last Resort",
    Angel = "Heavenly Blood", Skypiea = "Heavenly Blood",
    Shark = "Water Body",     Fishman = "Water Body",
    Rabbit = "Agility",       Mink = "Agility",
    Ghoul = "Heightened Senses",
    Cyborg = "Energy Core",
    Draco = "Primordial Reign",
}

local function HasRaceV3()
    local ability = V3Abilities[GetRace()]
    if not ability then return false end
    local bp = LocalPlayer:FindFirstChild("Backpack")
    local ch = LocalPlayer.Character
    return (bp and bp:FindFirstChild(ability) ~= nil) or (ch and ch:FindFirstChild(ability) ~= nil) or false
end

local function HasRaceV2()
    if HasRaceV3() then return true end
    local ok, st = pcall(function() return CommF:InvokeServer("Alchemist", "1") end)
    return ok and st == -2
end

-- Rút gọn từ script check inventory (ItemReplicationService + fallback getInventory)
local function CheckInvItems()
    local hasHelm, hasMirror = false, false
    local okR, ItemReplication = pcall(require, ReplicatedStorage:WaitForChild("ItemReplicationService", 8))
    local okK, KEYS = false, nil
    local okI, ItemId = false, nil
    if okR and ItemReplication then
        okK, KEYS = pcall(require, ReplicatedStorage.ItemReplicationService:WaitForChild("KEYS", 8))
        local econ = ReplicatedStorage:WaitForChild("Economy", 8)
        if econ then
            okI, ItemId = pcall(require, econ:WaitForChild("ItemId", 8))
        end
    end

    if okR and okK and okI and ItemReplication and KEYS and ItemId then
        local t0 = os.clock()
        while not Stopped() and not ItemReplication.IsInitialized and (os.clock() - t0) < 20 do
            task.wait(0.5)
        end
        if Stopped() then return false, false end
        if ItemReplication.IsInitialized then
            for _, item in pairs(ItemReplication:GetItems(KEYS.QUANTITY)) do
                if (item.Value or 0) > 0 then
                    local okD, d = pcall(function() return ItemId.getDataFromId(item.ItemId):unwrap() end)
                    if okD and d then
                        local k = (tostring(d.StorageKey or "") .. " " .. tostring(d.DisplayName or d.Name or "")):lower()
                        if k:find("valkyrie") then hasHelm = true end
                        if k:find("mirror") and k:find("fractal") then hasMirror = true end
                    end
                end
            end
            return hasHelm, hasMirror
        end
    end

    local okG, inv = pcall(function() return CommF:InvokeServer("getInventory") end)
    if okG and type(inv) == "table" then
        for _, v in pairs(inv) do
            local n = tostring(v.Name or ""):lower()
            if n:find("valkyrie") then hasHelm = true end
            if n:find("mirror") and n:find("fractal") then hasMirror = true end
        end
    end
    return hasHelm, hasMirror
end

local function IsLeverPulled()
    local ok, res = pcall(function() return CommF:InvokeServer("CheckTempleDoor") end)
    return ok and res == true
end

local function TravelToSea(targetSea)
    while not Stopped() and GetSea() ~= targetSea do
        SetStatus("Đang chuyển sang Sea " .. tostring(targetSea) .. "...")
        if targetSea == 2 then
            pcall(function() CommF:InvokeServer("TravelDressrosa") end)
        elseif targetSea == 3 then
            pcall(function() CommF:InvokeServer("TravelZou") end)
            if not SleepCheck(3) then return false end
            if GetSea() ~= 3 then
                pcall(function() CommF:InvokeServer("TravelDressrosa") end)
            end
        end
        if not SleepCheck(4) then return false end
    end
    return not Stopped() and GetSea() == targetSea
end

local function TryRerollHuman()
    while not Stopped() and GetRace() ~= "Human" and GetFragments() >= 3000 do
        SetStatus(("Đang roll race (%s) tìm Human | Frag: %d"):format(GetRace(), GetFragments()))
        pcall(function() CommF:InvokeServer("BlackbeardReward", "Reroll", "1") end)
        pcall(function() CommF:InvokeServer("BlackbeardReward", "Reroll", "2") end)
        if not SleepCheck(0.9) then return false end
    end
    return GetRace() == "Human"
end

-- ============================================================================
-- LUỒNG CHÍNH (STATE MACHINE)
-- ============================================================================
EnsureTeam()
if Stopped() then return end

-- 1. CHECK RACE HIỆN TẠI -> CHƯA HUMAN THÌ ROLL (3K FRAG)
if GetRace() ~= "Human" then
    if GetFragments() >= 3000 then
        if GetSea() == 1 then TravelToSea(3) end
        if Stopped() then return end
        TryRerollHuman()
    end

    if not Stopped() and GetRace() ~= "Human" then
        if GetSea() ~= 3 then TravelToSea(3) end
        if not Stopped() and TweenTo(POS_CAKE_LOAF) and LaunchRealKidHop(DESTINATIONS.CAKE_PRINCE) then
            while not Stopped() and task.wait(2) do
                SetStatus(("Farm Frag roll Human | Race: %s | Frag: %d/3000"):format(GetRace(), GetFragments()))
                if GetFragments() >= 3000 then
                    if TryRerollHuman() then
                        SetStatus("Đã ra Human! Hop Low để refresh...")
                        HopLow()
                        return
                    end
                end
            end
        end
        return
    end
end
if Stopped() then return end

-- 2. ĐÃ LÀ HUMAN -> CHECK V2, V3 & BELI, FRAGMENT
local hasV3 = HasRaceV3()
local hasV2 = HasRaceV2()

if not hasV3 then
    local reqBeli = hasV2 and 2000000 or 2500000 -- 500k cho V2 (nếu chưa V2) + 2M cho V3
    local reqFrag = 10000

    if GetBeli() < reqBeli then
        if GetSea() ~= 3 then TravelToSea(3) end
        if not Stopped() and LaunchRealKidMain({ Chest = true }, ("Farm Chest lấy Beli (%d/%d)"):format(GetBeli(), reqBeli)) then
            while not Stopped() and task.wait(1.5) do
                SetStatus(("Đang farm Beli: %d / %d"):format(GetBeli(), reqBeli))
                if GetBeli() >= reqBeli then
                    SetStatus("Đã đủ Beli! Hop Low để refresh...")
                    HopLow()
                    return
                end
            end
        end
        return
    end

    if GetFragments() < reqFrag then
        if GetSea() ~= 3 then TravelToSea(3) end
        if not Stopped() and TweenTo(POS_CAKE_LOAF) and LaunchRealKidHop(DESTINATIONS.CAKE_PRINCE) then
            while not Stopped() and task.wait(1.5) do
                SetStatus(("Đang farm Fragment (Cake Prince): %d / %d"):format(GetFragments(), reqFrag))
                if GetFragments() >= reqFrag then
                    SetStatus("Đã đủ 10k Fragment! Hop Low để refresh...")
                    HopLow()
                    return
                end
            end
        end
        return
    end

    -- Đã đủ Beli & 10k Frag nhưng thiếu V2/V3 -> TP Sea 2 -> nếu đang up V2 mà trời sáng thì Hop Low liên tục tới khi gặp trời tối
    if GetSea() ~= 2 then TravelToSea(2) end
    if Stopped() then return end

    if not HasRaceV2() and not HasBlueFlower() and not IsNight() then
        SetStatus(("Đang up V2 nhưng trời sáng (Clock: %.1f) -> Hop Low tìm trời tối..."):format(Lighting.ClockTime))
        HopLow()
        return
    end

    if LaunchRealKidMain({ AutoUpgradeRaceV3 = true }, "Auto Upgrade Human V2/V3 (Sea 2)") then
        while not Stopped() and task.wait(2) do
            if not HasRaceV2() and not HasBlueFlower() and not IsNight() then
                SetStatus(("Đang up V2 mà trời chuyển sáng (Clock: %.1f) -> Hop Low tìm trời tối..."):format(Lighting.ClockTime))
                HopLow()
                return
            end
            SetStatus(("Đang làm Human V2/V3 ở Sea 2 (Clock: %.1f)..."):format(Lighting.ClockTime))
            if HasRaceV3() then
                SetStatus("Đã xong Human V3! Đang TP sang Sea 3...")
                TravelToSea(3)
                return
            end
        end
    end
    return
end
if Stopped() then return end

-- 3. ĐÃ ĐỦ HUMAN V3 -> ĐẢM BẢO ĐỦ 10K FRAGMENT TRƯỚC KHI CHECK INVENTORY
if GetFragments() < 10000 then
    if GetSea() ~= 3 then TravelToSea(3) end
    if not Stopped() and TweenTo(POS_CAKE_LOAF) and LaunchRealKidHop(DESTINATIONS.CAKE_PRINCE) then
        while not Stopped() and task.wait(1.5) do
            SetStatus(("Đã có Human V3 | Farm nốt Frag: %d / 10000"):format(GetFragments()))
            if GetFragments() >= 10000 then
                SetStatus("Đã đủ 10k Fragment! Hop Low để refresh...")
                HopLow()
                return
            end
        end
    end
    return
end
if Stopped() then return end

-- Đảm bảo đang ở Sea 3 để săn Boss / Pull Lever
if GetSea() ~= 3 then TravelToSea(3) end
if Stopped() then return end

-- 4. CHECK INVENTORY: VALKYRIE HELM & MIRROR FRACTAL
local hasHelm, hasMirror = CheckInvItems()
if Stopped() then return end

if not hasHelm then
    if TweenTo(POS_SEA_CASTLE) and LaunchRealKidHop(DESTINATIONS.RIP_INDRA) then
        while not Stopped() and task.wait(2) do
            SetStatus("Thiếu Valkyrie Helm -> Hop Rip Indra...")
