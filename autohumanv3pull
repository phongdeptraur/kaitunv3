local function U32LE(b, o) return b[o] + b[o + 1] * 256 + b[o + 2] * 65536 + b[o + 3] * 16777216 end
local function QR(s, a, b, c, d)
    s[a] = (s[a] + s[b]) % 4294967296; s[d] = lrotate(bxor(s[d], s[a]), 16)
    s[c] = (s[c] + s[d]) % 4294967296; s[b] = lrotate(bxor(s[b], s[c]), 12)
