-- ============================================================================
local function WaitAlive()
    while not Stopped() do
        local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        local hum = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 5)
        local hrp = char:FindFirstChild("HumanoidRootPart") or char:WaitForChild("HumanoidRootPart", 5)
        if hum and hrp and hum.Health > 0 then
            LocalPlayer:WaitForChild("Backpack", 5)
            return char, hum, hrp
        end
        task.wait(0.3)
    end
    return nil, nil, nil
end

local function TweenTo(targetPos)
    if Stopped() then return false end
    if getgenv()._RealKidMainRunning or getgenv()._RealKidHopRunning then
        SetStatus("RealKid đang chạy -> Không được tự tween, hop low refresh!")
        HopLow()
        return false
    end

    while not Stopped() do
        local char, hum, hrp = WaitAlive()
        if Stopped() or not char then return false end

        if hum.Sit then
            hum.Sit = false
            hum:ChangeState(Enum.HumanoidStateType.Jumping)
            task.wait(0.2)
        end

        local dist = (hrp.Position - targetPos).Magnitude
        if dist <= 8 then return true end

        SetStatus(("Pre-Tween (190 stud/s) -> còn %.0f studs"):format(dist))
        ActiveBV = Instance.new("BodyVelocity")
        ActiveBV.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        ActiveBV.Velocity = Vector3.zero
        ActiveBV.Parent = hrp

        ActiveNoclip = RunService.Stepped:Connect(function()
            if char and char.Parent then
                for _, p in ipairs(char:GetDescendants()) do
                    if p:IsA("BasePart") and p.CanCollide then p.CanCollide = false end
                end
            end
        end)

        ActiveTween = TweenService:Create(hrp, TweenInfo.new(dist / TWEEN_SPEED, Enum.EasingStyle.Linear), { CFrame = CFrame.new(targetPos) })
        ActiveTween:Play()

        while not Stopped() and ActiveTween and ActiveTween.PlaybackState == Enum.PlaybackState.Playing do
            if getgenv()._RealKidMainRunning or getgenv()._RealKidHopRunning then
                CleanupMovement()
                HopLow()
                return false
            end
            if not char.Parent or hum.Health <= 0 or (hrp.Position - targetPos).Magnitude <= 8 then
                break
            end
            task.wait(0.1)
        end

        local arrived = (not Stopped()) and hum.Health > 0 and hrp.Parent and (hrp.Position - targetPos).Magnitude <= 12
        CleanupMovement()
        if Stopped() then return false end
        if arrived then return true end
        task.wait(1)
    end
    return false
end

