                                        byJob[id] = { id = id, playing = cnt, ping = ping }
                                    end
                                end
                            end
                            break
                        end
                        task.wait(0.04)
                    end
                    done = done + 1
                end)
            end
            local t0 = os.clock()
            repeat task.wait(0.05) until Stopped() or done >= 150 or (os.clock() - t0) >= 3.5
            for _, s in pairs(byJob) do table.insert(list, s) end
        end

        if Stopped() then break end

        if #list == 0 then
            local cursor = ""
            for _ = 1, 5 do
                if Stopped() then break end
                local url = ("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100%s")
                    :format(game.PlaceId, cursor ~= "" and ("&cursor=" .. cursor) or "")
