local function CheckLawPedestalStatus()
    if Stopped() then return "MICROCHIP" end

    -- 1. Kiểm tra file CyborgProgress/coresupply.txt trước tiên (đặc biệt khi có Boss Law không bấm bệ được)
    if HasCoreSupplyRecorded() then
        local lawAlive = IsLawBossAliveRemote()
        SetStatus(("Đã có tên trong CyborgProgress/coresupply.txt%s -> Vào thẳng Supply Core Brain!"):format(
            lawAlive and " (Phát hiện Boss Law từ xa qua ReplicatedStorage)" or ""
        ))
        return "CORE_BRAIN"
    end

    local hasFist, itemName = HasFistOrCoreBrain()
    if hasFist then
        MarkCoreSupplyRecorded()
        SetStatus("Đang có " .. tostring(itemName) .. " -> Lưu coresupply.txt & chuyển sang Supply Core Brain!")
        return "CORE_BRAIN"
    end

    PedestalSignal = nil
    local attempt = 0
    while not Stopped() and not PedestalSignal do
        if HasCoreSupplyRecorded() then
            return "CORE_BRAIN"
        end
        local hasFistNow, itemNow = HasFistOrCoreBrain()
        if hasFistNow then
            MarkCoreSupplyRecorded()
            SetStatus("Đang có " .. tostring(itemNow) .. " -> Lưu coresupply.txt & chuyển sang Supply Core Brain!")
            return "CORE_BRAIN"
        end
        if IsCyborg() then return "CORE_BRAIN" end

        -- Nếu chưa có trong coresupply.txt mà phát hiện Boss Law đang sống từ xa (không bấm bệ được) hoặc quá 25 lần click
        attempt = attempt + 1
        if attempt > 25 then
            SetStatus("Click bệ Law quá 25 lần không có kết quả (hoặc kẹt Boss Law) -> Hop Low...")
            RecordJobCache(HOP_CACHE_FILE, TriedJobs, tostring(game.JobId))
            HopLow()
            return "HOPPED"
        end

        pcall(function()
            local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if hum then hum:UnequipTools() end
        end)

        SetStatus(("Đang FireClickDetector bệ Law chờ kết quả (Lần %d/25)..."):format(attempt))
        FireLawPedestal()

        local t0 = os.clock()
        while not Stopped() and not PedestalSignal and (os.clock() - t0) < 1.0 do
            local pGui = LocalPlayer:FindFirstChild("PlayerGui")
            local notifFolder = pGui and pGui:FindFirstChild("Notifications") or pGui
            if notifFolder then
                for _, d in ipairs(notifFolder:GetDescendants()) do
                    if (d:IsA("TextLabel") or d:IsA("TextButton")) and d.Text and d.Text ~= "" then
                        ParseNotifText(d.Text)
                    end
                end
            end
            if PedestalSignal then break end
            task.wait(0.1)
        end
    end

    if PedestalSignal == "CORE_BRAIN" then
        MarkCoreSupplyRecorded()
        SetStatus("Bệ Law báo: Supply Core Brain -> Đã lưu CyborgProgress/coresupply.txt & kích hoạt Coop/Solo Kill Law!")
        return "CORE_BRAIN"
    end

    SetStatus("Bệ Law báo: Cần Microchip (chưa nạp Fist) -> Bắt đầu nhặt 30 Chest Sea 2!")
    return "MICROCHIP"
end

