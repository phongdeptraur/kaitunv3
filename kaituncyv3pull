local function ReadCoreSupplyMap()
    EnsureFolders()
    local map = {}
    if isfile and readfile and isfile(CORE_SUPPLY_FILE) then
        local okR, raw = pcall(readfile, CORE_SUPPLY_FILE)
        if okR and type(raw) == "string" and raw ~= "" then
            local okD, data = pcall(function() return HttpService:JSONDecode(raw) end)
            if okD and type(data) == "table" then
                for k, v in pairs(data) do
                    if v then map[tostring(k)] = v end
                end
            else
                for line in raw:gmatch("[^\r\n]+") do
                    local clean = line:match("^%s*(.-)%s*$")
                    if clean ~= "" then map[clean] = true end
                end
            end
        end
    end
    return map
end

local function WriteCoreSupplyMap(map)
    EnsureFolders()
    if writefile then
        pcall(writefile, CORE_SUPPLY_FILE, HttpService:JSONEncode(map))
    end
end

local function HasCoreSupplyRecorded()
    local map = ReadCoreSupplyMap()
    return map[LocalPlayer.Name] ~= nil
end

local function MarkCoreSupplyRecorded()
    local map = ReadCoreSupplyMap()
    if not map[LocalPlayer.Name] then
        map[LocalPlayer.Name] = os.time()
        WriteCoreSupplyMap(map)
    end
end

local function UnmarkCoreSupplyRecorded()
    local map = ReadCoreSupplyMap()
    if map[LocalPlayer.Name] ~= nil then
        map[LocalPlayer.Name] = nil
        WriteCoreSupplyMap(map)
    end
end

