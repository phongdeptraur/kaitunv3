local NON_FRUIT_ITEMS = {
    ["fist of darkness"] = true, ["core brain"] = true, ["microchip"] = true, ["order microchip"] = true,
    ["god's chalice"] = true, ["sweet chalice"] = true, ["flower 1"] = true, ["flower 2"] = true,
    ["flower 3"] = true, ["library key"] = true, ["water key"] = true, ["hidden key"] = true,
    ["torch"] = true, ["hellfire torch"] = true, ["holy torch"] = true,
}

local function IsFruitTool(item)
    if not item or not item:IsA("Tool") then return false end
    -- Loại bỏ toàn bộ vũ khí & bộ chiêu trái ác quỷ đang ăn (ToolTip == "Blox Fruit")
    if item.ToolTip == "Melee" or item.ToolTip == "Sword" or item.ToolTip == "Gun" or item.ToolTip == "Blox Fruit" then
        return false
    end

    local ln = item.Name:lower()
    -- Loại bỏ trái ác quỷ hiện tại nhân vật đang sử dụng trong Data.DevilFruit (vd: "Ice-Ice")
    local df = Data and Data:FindFirstChild("DevilFruit")
    if df and tostring(df.Value) ~= "" and ln == tostring(df.Value):lower() then
        return false
    end
    -- Loại bỏ định dạng tên chiêu thức "<Tên>-<Tên>" (vd: "ice-ice", "buddha-buddha")
    if ln:match("^(.+)%-%1$") then
        return false
    end

    if NON_FRUIT_ITEMS[ln] then return false end
    for _, ab in pairs(V3Abilities) do
        if ln == ab:lower() then return false end
    end

    -- Chỉ nhận diện trái vật lý trong balo (tên có chữ "fruit" hoặc có EatRemote)
    return ln:find("fruit", 1, true) ~= nil or item:FindFirstChild("EatRemote") ~= nil
end

