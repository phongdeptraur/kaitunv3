local ActiveSea2Session = false

local function ReadAutoCySessions()
    EnsureFolders()
    local cleaned = {}
    if isfile and readfile and isfile(AUTOCY_SESSION_FILE) then
        local okR, raw = pcall(readfile, AUTOCY_SESSION_FILE)
        if okR and type(raw) == "string" and raw ~= "" then
            local okD, data = pcall(function() return HttpService:JSONDecode(raw) end)
            if okD and type(data) == "table" then
                local now = os.time()
                for acc, info in pairs(data) do
                    if type(info) == "table" and (now - (tonumber(info.Heartbeat) or 0)) < AUTOCY_TTL then
                        cleaned[tostring(acc)] = info
                    end
                end
            end
        end
    end
    return cleaned
end

local function WriteAutoCySessions(sessions)
    EnsureFolders()
    if writefile then
        pcall(writefile, AUTOCY_SESSION_FILE, HttpService:JSONEncode(sessions))
    end
end

local function BroadcastAutoCySession(reservedJobId)
    if not ActiveSea2Session or Stopped() then return end
    local sessions = ReadAutoCySessions()
    local myName = LocalPlayer.Name
    local curJob = tostring(game.JobId)
    local prev = sessions[myName]
    local myJoin = (prev and prev.JobId == curJob and tonumber(prev.JoinTime)) or ServerJoinEpoch

    sessions[myName] = {
        JobId         = curJob,
        ReservedJobId = reservedJobId or (prev and prev.ReservedJobId) or "",
        JoinTime      = myJoin,
        Heartbeat     = os.time(),
    }
    WriteAutoCySessions(sessions)
end

UnregisterAutoCySession = function()
    ActiveSea2Session = false
    local sessions = ReadAutoCySessions()
    if sessions[LocalPlayer.Name] then
        sessions[LocalPlayer.Name] = nil
        WriteAutoCySessions(sessions)
    end
end

local function GetOccupiedAutoCyJobs()
    local occupied = {}
    local sessions = ReadAutoCySessions()
    local myName = LocalPlayer.Name
    for acc, info in pairs(sessions) do
        if acc ~= myName and type(info) == "table" then
            if info.JobId and info.JobId ~= "" then occupied[tostring(info.JobId)] = acc end
            if info.ReservedJobId and info.ReservedJobId ~= "" then occupied[tostring(info.ReservedJobId)] = acc end
        end
    end
    return occupied
end

local function LoadJobCache(file, ttl)
    EnsureFolders()
    local cache = {}
    if isfile and readfile and isfile(file) then
        local okR, raw = pcall(readfile, file)
        if okR and type(raw) == "string" then
            local okD, data = pcall(function() return HttpService:JSONDecode(raw) end)
            if okD and type(data) == "table" then
                local now = os.time()
                for jid, ts in pairs(data) do
                    if type(ts) == "number" and (now - ts) < ttl then cache[tostring(jid)] = ts end
                end
            end
        end
    end
    return cache
end

local function RecordJobCache(file, cache, jobId)
    EnsureFolders()
    cache[tostring(jobId)] = os.time()
    if writefile then pcall(writefile, file, HttpService:JSONEncode(cache)) end
end

