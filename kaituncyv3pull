                    end
                end
                cursor = data.nextPageCursor
                if not cursor or cursor == "" then break end
            end
        end

        if Stopped() then break end

        if #list == 0 then
            TriedJobs = { [tostring(game.JobId)] = os.time() }
        else
            local pool = {}
            local prefMax = math.min(maxCnt, 7)
            for _, s in ipairs(list) do
                if s.ping <= 70 and s.playing <= prefMax then table.insert(pool, s) end
            end
            if #pool == 0 then pool = list end

            table.sort(pool, function(a, b)
                local aTier, bTier = math.floor(a.ping / 30), math.floor(b.ping / 30)
                if aTier ~= bTier then return aTier < bTier end
                if a.playing ~= b.playing then return a.playing < b.playing end
                return a.ping < b.ping
            end)

            for i = 1, math.min(#pool, 5) do
                if Stopped() then break end
                local target = pool[i]
                local latestOccupied = GetOccupiedAutoCyJobs()
                local latestChestBL  = ReadChestBlacklist()
                if not latestOccupied[target.id] and not latestChestBL[target.id] and not skipMap[target.id] then
