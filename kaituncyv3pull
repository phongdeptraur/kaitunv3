        local tRoot = targetModel:FindFirstChild("HumanoidRootPart") or tHead or targetModel:FindFirstChildOfClass("BasePart")
        if tRoot then
            enemyPart = tHead or tRoot
            table.insert(targets, { targetModel, tRoot })
            addedModels[targetModel] = true
        end
    end

    for _, folder in ipairs({ workspace:FindFirstChild("Enemies"), workspace:FindFirstChild("Characters") }) do
        if folder then
            for _, mob in ipairs(folder:GetChildren()) do
                if not addedModels[mob] and not Players:GetPlayerFromCharacter(mob) then
                    local mHum = mob:FindFirstChildOfClass("Humanoid")
                    local mRoot = mob:FindFirstChild("HumanoidRootPart") or mob:FindFirstChild("Head")
                    if mHum and mRoot and mHum.Health > 0 and (mRoot.Position - hrp.Position).Magnitude <= 100 then
                        addedModels[mob] = true
                        table.insert(targets, { mob, mRoot })
                        if not enemyPart then
                            enemyPart = mob:FindFirstChild("Head") or mRoot
                        end
                    end
                end
            end
        end
    end

    if enemyPart and #targets > 0 then
        local sessionTag = tostring(LocalPlayer.UserId):sub(2, 4) .. tostring(os.clock()):sub(3, 7)
        if netMod then
            pcall(function()
                netMod:RemoteEvent("RegisterAttack", true):FireServer(0)
                netMod:RemoteEvent("RegisterHit", true):FireServer(enemyPart, targets, {}, "078da5141")
            end)
        end
        pcall(function()
            regAttack:FireServer()
            regHit:FireServer(enemyPart, targets, {}, sessionTag)
        end)
        if obfR and obfId and netSeed then
            pcall(function()
                local k = string.gsub("RE/RegisterHit", ".", function(ch)
                    return string.char(bit32.bxor(string.byte(ch), math.floor(workspace:GetServerTimeNow() / 10 % 10) + 1))
                end)
                obfR:FireServer(k, bit32.bxor(obfId + 909090, netSeed:InvokeServer() * 2), enemyPart, targets)
            end)
        end
    end
end

