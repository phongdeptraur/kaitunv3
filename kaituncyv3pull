                    if ActiveSea2Session then BroadcastAutoCySession(target.id) end
                    SetStatus(("Hop Low -> %s | Players: %d | Ping: %dms"):format(target.id:sub(1, 8), target.playing, target.ping))
                    DirectTeleport(target.id, game.PlaceId)
                    if not SleepCheck(3) then break end
                end
            end
        end
        if not SleepCheck(1) then break end
    end
    getgenv()._HoppingLow = false
