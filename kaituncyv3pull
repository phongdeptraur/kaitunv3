local CoopJoinOrder = os.time()

local function ReadCoopState()
    EnsureFolders()
    local defaultState = { Players = {}, Groups = {}, ChipLocks = {} }
    if isfile and readfile and isfile(COOP_LAW_FILE) then
        local okR, raw = pcall(readfile, COOP_LAW_FILE)
        if okR and type(raw) == "string" and raw ~= "" then
            local okD, data = pcall(function() return HttpService:JSONDecode(raw) end)
            if okD and type(data) == "table" then
                if type(data.Players) ~= "table" then data.Players = {} end
                if type(data.Groups) ~= "table" then data.Groups = {} end
                if type(data.ChipLocks) ~= "table" then data.ChipLocks = {} end
                return data
            end
        end
    end
    return defaultState
end

local function WriteCoopState(data)
    EnsureFolders()
    if writefile then
        pcall(writefile, COOP_LAW_FILE, HttpService:JSONEncode(data))
    end
end

UnregisterCoopLaw = function()
    local data = ReadCoopState()
    local myName = LocalPlayer.Name
    data.Players[myName] = nil
    for i = #data.Groups, 1, -1 do
        local g = data.Groups[i]
        if type(g.Members) == "table" then
            for j = #g.Members, 1, -1 do
                if g.Members[j] == myName then
                    table.remove(g.Members, j)
                end
            end
            if #g.Members == 0 then
                table.remove(data.Groups, i)
            end
        else
            table.remove(data.Groups, i)
        end
    end
    WriteCoopState(data)
end

-- Đồng bộ, phân chia Group (max 5 acc):
-- 1. Ưu tiên tuyệt đối cho các acc chính/clone cần Supply Core Brain (IsBackHelp == false) gộp đầy 5 người/group.
-- 2. Các acc Back Help (IsBackHelp == true) chỉ lấp vào các Group đã có ít nhất 1 acc chính và đang thiếu người (< 5).
-- 3. Nếu có acc chính/clone mới vào khiến Group đủ người, acc Back Help tự động bị đẩy ra để nhường chỗ!
local function SyncAndRebalanceCoop(myAtPos, isBackHelpMode)
    local data = ReadCoopState()
    local now = os.time()
    local myName = LocalPlayer.Name
    local curJob = tostring(game.JobId)

    -- 1. Cập nhật thông tin của bản thân
    local prevMe = data.Players[myName]
    data.Players[myName] = {
        Name       = myName,
        JobId      = curJob,
        Fragments  = GetFragments(),
        HasChip    = (not isBackHelpMode) and (HasMicrochipItem() == true) or false,
        IsBackHelp = (isBackHelpMode == true),
        AtPos      = (myAtPos == true),
        JoinOrder  = (prevMe and tonumber(prevMe.JoinOrder)) or CoopJoinOrder,
        Heartbeat  = now,
    }

    -- 2. Xóa các acc & khóa mua Chip hết hạn TTL
    for acc, pInfo in pairs(data.Players) do
        if type(pInfo) ~= "table" or (now - (tonumber(pInfo.Heartbeat) or 0)) > COOP_LAW_TTL then
            data.Players[acc] = nil
        end
    end

    for jobKey, lockInfo in pairs(data.ChipLocks) do
        local buyerName = type(lockInfo) == "table" and tostring(lockInfo.Buyer or "") or ""
        local lockTime = type(lockInfo) == "table" and (tonumber(lockInfo.Time) or 0) or 0
        local buyerInfo = data.Players[buyerName]
        if buyerName == "" or (now - lockTime) > 15 or not buyerInfo or tostring(buyerInfo.JobId) ~= tostring(jobKey) then
            data.ChipLocks[jobKey] = nil
        end
    end

    -- 3. Giữ lại các thành viên CHÍNH (IsBackHelp == false) trong các Group hiện có trước
    local assignedNormal = {}
    local cleanGroups = {}
    for _, g in ipairs(data.Groups) do
        if type(g) == "table" and type(g.Members) == "table" then
            local normalMembers = {}
            for _, m in ipairs(g.Members) do
                local mStr = tostring(m)
                local pInfo = data.Players[mStr]
                if pInfo and not pInfo.IsBackHelp and not assignedNormal[mStr] and #normalMembers < 5 then
                    assignedNormal[mStr] = true
                    table.insert(normalMembers, mStr)
                end
            end
            if #normalMembers > 0 then
                g.Members = normalMembers
                g.CreatedAt = tonumber(g.CreatedAt) or now
                g.Id = tostring(g.Id or ("G_" .. normalMembers[1]))
                g.InitialOwner = (g.InitialOwner and data.Players[g.InitialOwner] and not data.Players[g.InitialOwner].IsBackHelp and g.InitialOwner) or normalMembers[1]
                g.TargetJobId = tostring(g.TargetJobId or data.Players[g.InitialOwner].JobId or curJob)
                g.ServerLocked = (g.ServerLocked == true)
                table.insert(cleanGroups, g)
            end
        end
    end

    -- 4. Xếp các acc CHÍNH (IsBackHelp == false) chưa có Group vào các Group chưa đủ 5 acc chính hoặc tạo Group mới
    local unassignedNormals = {}
    for acc, pInfo in pairs(data.Players) do
        if not pInfo.IsBackHelp and not assignedNormal[acc] then
            table.insert(unassignedNormals, acc)
        end
    end
    table.sort(unassignedNormals, function(a, b)
        local oa = tonumber(data.Players[a].JoinOrder) or 0
        local ob = tonumber(data.Players[b].JoinOrder) or 0
        if oa ~= ob then return oa < ob end
        return a < b
    end)

    table.sort(cleanGroups, function(a, b)
        if #a.Members ~= #b.Members then return #a.Members > #b.Members end
        if a.CreatedAt ~= b.CreatedAt then return a.CreatedAt < b.CreatedAt end
        return a.Id < b.Id
    end)

    for _, acc in ipairs(unassignedNormals) do
        local placed = false
        for _, g in ipairs(cleanGroups) do
            if #g.Members < 5 then
                table.insert(g.Members, acc)
                placed = true
                break
            end
        end
        if not placed then
            local pInfo = data.Players[acc]
            table.insert(cleanGroups, {
                Id           = "G_" .. tostring(now) .. "_" .. acc,
                CreatedAt    = tonumber(pInfo.JoinOrder) or now,
                InitialOwner = acc,
                TargetJobId  = tostring(pInfo.JobId or curJob),
                ServerLocked = false,
                Members      = { acc },
            })
        end
    end

    -- 5. Gộp các Group của acc CHÍNH để ưu tiên lấp đầy 5 acc chính/group
    table.sort(cleanGroups, function(a, b)
        if #a.Members ~= #b.Members then return #a.Members > #b.Members end
        if a.CreatedAt ~= b.CreatedAt then return a.CreatedAt < b.CreatedAt end
        return a.Id < b.Id
    end)

    local idx = 1
    while idx < #cleanGroups do
        local targetG = cleanGroups[idx]
        while #targetG.Members < 5 and #cleanGroups > idx do
            local donorG = cleanGroups[#cleanGroups]
            local movedAcc = table.remove(donorG.Members)
            if movedAcc then
                table.insert(targetG.Members, movedAcc)
            end
            if #donorG.Members == 0 then
                table.remove(cleanGroups, #cleanGroups)
            end
        end
        idx = idx + 1
    end

    -- 6. Sau khi toàn bộ acc CHÍNH đã có chỗ (nhường chỗ xong), phân bổ các acc BACK HELP vào các Group còn thiếu (< 5 người)
    local backHelpList = {}
    for acc, pInfo in pairs(data.Players) do
        if pInfo.IsBackHelp then
            table.insert(backHelpList, acc)
        end
    end
    table.sort(backHelpList, function(a, b)
        local oa = tonumber(data.Players[a].JoinOrder) or 0
        local ob = tonumber(data.Players[b].JoinOrder) or 0
        if oa ~= ob then return oa < ob end
        return a < b
    end)

    local assignedBackHelp = {}
    -- Ưu tiên giữ Back Help ở lại Group mà họ đang đứng cùng TargetJobId nếu Group đó vẫn còn slot trống (< 5)
    for _, bhAcc in ipairs(backHelpList) do
        local bhJob = tostring(data.Players[bhAcc].JobId or "")
        for _, g in ipairs(cleanGroups) do
            if #g.Members < 5 and bhJob ~= "" and tostring(g.TargetJobId) == bhJob then
                table.insert(g.Members, bhAcc)
                assignedBackHelp[bhAcc] = true
                break
            end
        end
    end
    -- Các Back Help còn lại lấp vào bất kỳ Group nào còn thiếu người (< 5)
    for _, bhAcc in ipairs(backHelpList) do
        if not assignedBackHelp[bhAcc] then
            for _, g in ipairs(cleanGroups) do
                if #g.Members < 5 then
                    table.insert(g.Members, bhAcc)
                    assignedBackHelp[bhAcc] = true
                    break
                end
            end
        end
    end

    -- 7. Cập nhật trạng thái TargetJobId & ServerLocked cho từng Group (InitialOwner luôn là acc chính cần Core Brain)
    for _, g in ipairs(cleanGroups) do
        local ownerStillInGroup = false
        for _, m in ipairs(g.Members) do
            local pInfo = data.Players[m]
            if m == g.InitialOwner and pInfo and not pInfo.IsBackHelp then
                ownerStillInGroup = true
                break
            end
        end
        if not ownerStillInGroup then
            for _, m in ipairs(g.Members) do
                local pInfo = data.Players[m]
                if pInfo and not pInfo.IsBackHelp then
                    g.InitialOwner = m
                    break
                end
            end
        end

        if not g.ServerLocked then
            local ownerInfo = data.Players[g.InitialOwner]
            if ownerInfo and ownerInfo.JobId and ownerInfo.JobId ~= "" then
                g.TargetJobId = tostring(ownerInfo.JobId)
            end
        end

        local inTargetCount = 0
        local normalInTargetCount = 0
        for _, m in ipairs(g.Members) do
            local pInfo = data.Players[m]
            if pInfo and tostring(pInfo.JobId) == tostring(g.TargetJobId) then
                inTargetCount = inTargetCount + 1
                if not pInfo.IsBackHelp then
                    normalInTargetCount = normalInTargetCount + 1
                end
            end
        end

        if inTargetCount >= 2 and normalInTargetCount >= 1 then
            g.ServerLocked = true
        elseif normalInTargetCount == 0 then
            g.ServerLocked = false
            local firstInfo = data.Players[g.InitialOwner]
            if firstInfo then g.TargetJobId = tostring(firstInfo.JobId) end
        end
    end

    data.Groups = cleanGroups
    WriteCoopState(data)

    -- Tìm Group của bản thân
    local myGroup = nil
    for _, g in ipairs(cleanGroups) do
        for _, m in ipairs(g.Members) do
            if m == myName then
                myGroup = g
                break
            end
        end
        if myGroup then break end
    end

    return data, myGroup
end

-- Kiểm tra xem một thành viên trong cùng server đã đứng vào vị trí được phân công chưa
local function IsPlayerNearPos(playerName, targetPos, threshold)
    local plr = Players:FindFirstChild(playerName)
    local char = plr and plr.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    return (hrp.Position - targetPos).Magnitude <= (threshold or 12)
end

-- Hàm đánh Boss Law (Order) dùng chung cho cả Buyer, Clone và Back Help
local function FightLawBossLoop(inServerCount, groupTotalCount, isBackHelpMode)
    while not Stopped() do
        if not isBackHelpMode and (HasCoreBrainItem() or IsCyborg()) then break end
        local lawBoss, lawHum, lawHrp, lawPos = FindBossAlive({ "Order" })
        if not (lawBoss and lawHum and lawHum.Health > 0) then
            break
        end

        if not lawHrp or (lawBoss and not lawBoss:IsDescendantOf(workspace)) then
            pcall(function() LocalPlayer:RequestStreamAroundAsync(lawPos or POS_LAW_ARENA, 5) end)
        end

        -- Nếu lawBoss bị nhặt nhầm từ ReplicatedStorage, lập tức tìm kiếm đối tượng thực trong Workspace
        if lawBoss and not lawBoss:IsDescendantOf(workspace) then
            for _, folder in ipairs({ workspace:FindFirstChild("Enemies"), workspace:FindFirstChild("Characters") }) do
                if folder then
                    for _, mob in ipairs(folder:GetChildren()) do
                        if not Players:GetPlayerFromCharacter(mob) and mob.Name:lower():find("order", 1, true) then
                            local mHum = mob:FindFirstChildOfClass("Humanoid")
                            if mHum and mHum.Health > 0 then
                                lawBoss = mob
                                lawHum = mHum
                                lawHrp = mob:FindFirstChild("Head") or mob:FindFirstChild("HumanoidRootPart")
                                break
                            end
                        end
                    end
                end
                if lawBoss:IsDescendantOf(workspace) then break end
            end
        end

        local attackPos = ((lawHrp and lawHrp.Position) or lawPos or POS_LAW_ARENA) + Vector3.new(0, 12, 0)
        ContinuousTweenStep(attackPos)
        PerformFastAttack(lawBoss)

        SetStatus(("%sĐang đánh Order (Law) [HP: %d/%d] | Group: %d/%d acc"):format(
            isBackHelpMode and "[BackHelp] " or "",
            math.floor(lawHum.Health),
            math.floor(lawHum.MaxHealth),
            inServerCount or 1,
            groupTotalCount or 1
        ))
        task.wait()
    end
    CleanupMovement()
end

-- Hủy đăng ký Coop và hoàn tất Supply Core Brain tại bệ Raid
local function SupplyCoreBrainAndFinish()
    UnregisterCoopLaw()
    CleanupMovement()
    SetStatus("Đã có Core Brain! Đang tween tới bệ Raid để Supply Core Brain...")

    while not Stopped() do
        if IsCyborg() then
            UnmarkCoreSupplyRecorded()
            SetStatus("Đã lấy được tộc Cyborg! Hop Low để refresh sang V2/V3...")
            HopLow()
            return
        end

        local hasCB = HasCoreBrainItem()
        if not hasCB then
            pcall(function() CommF:InvokeServer("CyborgTrainer", "Buy") end)
            if IsCyborg() then
                UnmarkCoreSupplyRecorded()
                SetStatus("Đã mua thành công tộc Cyborg! Hop Low để refresh...")
                HopLow()
                return
            end
            if LaunchRealKidMain({ auto_cyborg = true }, "Hoàn tất mua tộc Cyborg sau khi Supply Core Brain") then
                while not Stopped() and task.wait(1.5) do
                    pcall(function() CommF:InvokeServer("CyborgTrainer", "Buy") end)
                    if IsCyborg() then
                        UnmarkCoreSupplyRecorded()
                        SetStatus("Đã lấy được tộc Cyborg! Hop Low để refresh sang V2/V3...")
                        HopLow()
                        return
                    end
                    if GetFragments() < 3000 then
                        return
                    end
                end
            end
            return
        end

        local mainBtn = GetLawButtonMain()
        local targetPedestal = (mainBtn and mainBtn.Position) or POS_LAW_PEDESTAL
        TweenTo(targetPedestal, function()
            return IsCyborg() or (not HasCoreBrainItem())
        end)

        for _ = 1, 6 do
            if Stopped() or IsCyborg() or (not HasCoreBrainItem()) then break end
            SetStatus("Đang bấm bệ Raid để Supply Core Brain...")
            FireLawPedestal()
            pcall(function() CommF:InvokeServer("CyborgTrainer", "Buy") end)
            task.wait(0.35)
        end
        task.wait(0.2)
    end
end

-- Hàm mua Microchip an toàn: Chặn tuyệt đối khi có Core Brain, đã có acc khác mua/đang mua Chip, hoặc Boss Law đang sống
local LastChipBuyTick = 0
local function TryBuyMicrochipSafe(curJob, inServerMembers)
    if Stopped() then return false, "stopped" end
    if IsCyborg() then return false, "is_cyborg" end
    if HasCoreBrainItem() then return false, "has_core_brain" end
    if HasMicrochipItem() then return true, "already_has_chip" end

    local lawBoss, lawHum = FindBossAlive({ "Order" })
    if lawBoss and lawHum and lawHum.Health > 0 then
        return false, "boss_alive"
    end

    local myName = LocalPlayer.Name

    -- 1. Kiểm tra trực tiếp túi đồ của tất cả thành viên cùng server & dữ liệu Coop
    for _, m in ipairs(inServerMembers or {}) do
        if m.Name ~= myName then
            local otherPlr = Players:FindFirstChild(m.Name)
            if m.HasChip or PlayerHasMicrochip(otherPlr) then
                return false, "other_has_chip"
            end
        end
    end

    -- 2. Kiểm tra khóa mua Chip hiện tại của server này trong killlawcoop.txt
    local now = os.time()
    local coopNow = ReadCoopState()
    local curLock = coopNow.ChipLocks[curJob]
    if type(curLock) == "table" and curLock.Buyer and curLock.Buyer ~= myName and (now - (tonumber(curLock.Time) or 0)) < 12 then
        local holderPlr = Players:FindFirstChild(curLock.Buyer)
        local holderInfo = coopNow.Players[curLock.Buyer]
        if holderPlr and holderInfo and tostring(holderInfo.JobId) == curJob then
            return false, "locked_by_other"
        end
    end

    -- 3. Chống spam bấm mua quá nhanh trong lúc chờ server trả vật phẩm về balo
    if (os.clock() - LastChipBuyTick) < 3.5 then
        return false, "cooldown"
    end

    -- 4. Ghi khóa mua Chip & xác minh lại sau 0.15s để chống 2 acc bấm cùng 1 mili-giây
    coopNow.ChipLocks[curJob] = {
        Buyer = myName,
        Time  = now,
    }
    WriteCoopState(coopNow)
    task.wait(0.15)

    local verifyData = ReadCoopState()
    local verifyLock = verifyData.ChipLocks[curJob]
    if type(verifyLock) == "table" and verifyLock.Buyer and verifyLock.Buyer ~= myName then
        if verifyLock.Buyer < myName then
            return false, "race_lost"
        end
        verifyData.ChipLocks[curJob] = {
            Buyer = myName,
            Time  = os.time(),
        }
        WriteCoopState(verifyData)
    end

    -- 5. Kiểm tra lại lần cuối ngay trước khi gọi Remote mua Chip (chặn tuyệt đối Core Brain vừa rơi vào túi)
    if Stopped() then return false, "stopped" end
    if IsCyborg() then return false, "is_cyborg" end
    if HasCoreBrainItem() then return false, "has_core_brain" end
    if HasMicrochipItem() then return true, "already_has_chip" end

    for _, m in ipairs(inServerMembers or {}) do
        if m.Name ~= myName and PlayerHasMicrochip(Players:FindFirstChild(m.Name)) then
            return false, "other_has_chip"
        end
    end

    LastChipBuyTick = os.clock()
    SetStatus(("Coop (%d acc) | Đã khóa quyền mua Chip -> Đang mua Microchip..."):format(#(inServerMembers or {})))
    pcall(function() CommF:InvokeServer("BlackbeardReward", "Microchip", "2") end)

    -- 6. Chờ vật phẩm Microchip xuất hiện trong balo (tối đa 1.8s) và cập nhật ngay lên file Coop
    local tWait = os.clock()
    while not Stopped() and (os.clock() - tWait) < 1.8 do
        if HasCoreBrainItem() or IsCyborg() then
            return false, "has_core_brain"
        end
        if HasMicrochipItem() then
            local afterData = ReadCoopState()
            if afterData.Players[myName] then
                afterData.Players[myName].HasChip = true
                afterData.Players[myName].Heartbeat = os.time()
            end
            WriteCoopState(afterData)
            return true, "bought"
        end
        task.wait(0.15)
    end

    return HasMicrochipItem(), "pending_replication"
end

-- Luồng chính điều phối Coop & Solo đánh Law khi ở trạng thái Supply Core Brain
local function RunCoopSupplyCoreBrain(TravelToSeaFn)
    UnregisterAutoCySession()
    MarkCoreSupplyRecorded()

    -- Nếu đang cầm Fist of Darkness trên tay/balo thì nộp vào bệ trước
    if HasFistItem() and not HasCoreBrainItem() then
        SetStatus("Đang cầm Fist of Darkness -> Tween tới bệ Law nạp Fist...")
        local mainBtn = GetLawButtonMain()
        TweenTo((mainBtn and mainBtn.Position) or POS_LAW_PEDESTAL, function() return not HasFistItem() end)
        for _ = 1, 8 do
            if Stopped() or not HasFistItem() then break end
            FireLawPedestal()
            task.wait(0.3)
        end
        MarkCoreSupplyRecorded()
    end

    if HasCoreBrainItem() then
        SupplyCoreBrainAndFinish()
        return
    end

    local checkedInitialServerCapacity = false
    local checkedJobId = ""
    local lastTeleportAttempt = 0
    local myAtPosFlag = false

    while not Stopped() do
        if IsCyborg() then
            UnmarkCoreSupplyRecorded()
            UnregisterCoopLaw()
            CleanupMovement()
            SetStatus("Đã có tộc Cyborg! Hop Low để refresh...")
            HopLow()
            return
        end

        if HasCoreBrainItem() then
            SupplyCoreBrainAndFinish()
            return
        end

        if GetFragments() < 3000 then
            UnregisterCoopLaw()
            CleanupMovement()
            SetStatus(("Fragment tụt dưới 3k (%d/3000) -> TP sang Sea 3 farm lại 10k Frag!"):format(GetFragments()))
            TravelToSeaFn(3)
            return
        end

        local coopData, myGroup = SyncAndRebalanceCoop(myAtPosFlag, false)
        local myName = LocalPlayer.Name
        local curJob = tostring(game.JobId)

        if myGroup then
            local targetJob = tostring(myGroup.TargetJobId or curJob)

            if targetJob ~= "" and targetJob ~= curJob then
                myAtPosFlag = false
                CleanupMovement()
                SetStatus(("Coop Group [%s] (%d/5 acc) -> Đang join sang server Group: %s..."):format(
                    tostring(myGroup.Id):sub(1, 10), #myGroup.Members, targetJob:sub(1, 8)
                ))
                if (os.clock() - lastTeleportAttempt) >= 4 then
                    lastTeleportAttempt = os.clock()
                    DirectTeleport(targetJob, game.PlaceId)
                end
                task.wait(1)
            else
                local activeChipLock = type(coopData.ChipLocks) == "table" and coopData.ChipLocks[curJob] or nil
                local lockedBuyerName = (type(activeChipLock) == "table" and (os.time() - (tonumber(activeChipLock.Time) or 0)) < 12)
                    and tostring(activeChipLock.Buyer or "") or ""

                local inServerMembers = {}
                for _, mName in ipairs(myGroup.Members) do
                    local plr = Players:FindFirstChild(mName)
                    local pInfo = coopData.Players[mName]
                    if plr and pInfo and tostring(pInfo.JobId) == curJob then
                        local liveHasChip = (not pInfo.IsBackHelp) and (
                            (mName == myName and (HasMicrochipItem() == true))
                            or PlayerHasMicrochip(plr)
                            or (pInfo.HasChip == true)
                        ) or false

                        table.insert(inServerMembers, {
                            Name       = mName,
                            Fragments  = (mName == myName and GetFragments()) or (tonumber(pInfo.Fragments) or 0),
                            HasChip    = liveHasChip,
                            HasBuyLock = (not pInfo.IsBackHelp) and (lockedBuyerName == mName),
                            IsBackHelp = (pInfo.IsBackHelp == true),
                            AtPos      = (pInfo.AtPos == true),
                        })
                    end
                end

                local hasAtLeastOneMemberJoined = myGroup.ServerLocked or (#inServerMembers >= 2)

                if not hasAtLeastOneMemberJoined and myGroup.InitialOwner == myName then
                    if not checkedInitialServerCapacity or checkedJobId ~= curJob then
                        local maxP = tonumber(Players.MaxPlayers) or 12
                        local curP = #Players:GetPlayers()
                        if curP > (maxP - 4) then
                            SetStatus(("Group Owner check lần đầu: Server %d/%d không đủ 5 chỗ -> Hop Low tìm server <= %d người..."):format(
                                curP, maxP, maxP - 4
                            ))
                            RecordJobCache(HOP_CACHE_FILE, TriedJobs, curJob)
                            HopLow(maxP - 4)
                            return
                        else
                            checkedInitialServerCapacity = true
                            checkedJobId = curJob
                        end
                    end
                end

                -- Kiểm tra xem Boss Law (Order) có đang xuất hiện không (kể cả trong ReplicatedStorage)
                local lawBoss, lawHum = FindBossAlive({ "Order" })
                if lawBoss and lawHum and lawHum.Health > 0 then
                    myAtPosFlag = false
                    -- Xóa khóa mua Chip cũ của server này vì Boss Law đã xuất hiện
                    local clearLockData = ReadCoopState()
                    if clearLockData.ChipLocks[curJob] then
                        clearLockData.ChipLocks[curJob] = nil
                        WriteCoopState(clearLockData)
                    end

                    FightLawBossLoop(#inServerMembers, #myGroup.Members, false)
                    SleepCheck(1.8)
                    if HasCoreBrainItem() or IsCyborg() then
                        SupplyCoreBrainAndFinish()
                        return
                    end
                else
                    if #inServerMembers <= 1 then
                        -- CƠ CHẾ SOLO (Khi trong server chỉ có 1 mình)
                        myAtPosFlag = true
                        SetStatus(("Chế độ Solo Kill Law (Group %d/5) | Frag: %d -> Kiểm tra & mua Chip..."):format(
                            #myGroup.Members, GetFragments()
                        ))

                        if not HasMicrochipItem() then
                            local _, buyReason = TryBuyMicrochipSafe(curJob, inServerMembers)
                            if buyReason == "has_core_brain" or buyReason == "is_cyborg" then
                                SupplyCoreBrainAndFinish()
                                return
                            end
                        end

                        local mainBtn = GetLawButtonMain()
                        local startPos = (mainBtn and mainBtn.Position) or LAW_CLONE_PODS[1]
                        ContinuousTweenStep(startPos)

                        if IsPlayerNearPos(myName, startPos, 15) then
                            pcall(function()
                                local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
                                if hum then hum:UnequipTools() end
                            end)
                            FireLawPedestal()
                        end
                        task.wait(0.4)
                    else
                        -- CƠ CHẾ COOP (>= 2 acc trong cùng server): Chỉ chọn Buyer từ các acc KHÔNG PHẢI BackHelp
                        local sortedForBuyer = {}
                        for _, m in ipairs(inServerMembers) do
                            if not m.IsBackHelp then
                                table.insert(sortedForBuyer, m)
                            end
                        end
                        if #sortedForBuyer == 0 then
                            for _, m in ipairs(inServerMembers) do table.insert(sortedForBuyer, m) end
                        end

                        -- Ưu tiên 1: Acc đã có sẵn Chip -> Ưu tiên 2: Acc đang giữ khóa mua Chip -> Ưu tiên 3: Nhiều Frag nhất
                        table.sort(sortedForBuyer, function(a, b)
                            if a.HasChip ~= b.HasChip then return a.HasChip end
                            if a.HasBuyLock ~= b.HasBuyLock then return a.HasBuyLock end
                            if a.Fragments ~= b.Fragments then return a.Fragments > b.Fragments end
                            return a.Name < b.Name
                        end)

                        local buyerAcc = sortedForBuyer[1].Name

                        local cloneList = {}
                        for _, m in ipairs(inServerMembers) do
                            if m.Name ~= buyerAcc then
                                table.insert(cloneList, m.Name)
                            end
                        end
                        table.sort(cloneList)

                        local clonePodAssignment = {}
                        for idx, cName in ipairs(cloneList) do
                            local podIdx = ((idx - 1) % #LAW_CLONE_PODS) + 1
                            clonePodAssignment[cName] = LAW_CLONE_PODS[podIdx]
                        end

                        if myName == buyerAcc then
                            if not HasMicrochipItem() then
                                local okChip, buyReason = TryBuyMicrochipSafe(curJob, inServerMembers)
                                if buyReason == "has_core_brain" or buyReason == "is_cyborg" then
                                    SupplyCoreBrainAndFinish()
                                    return
                                end
                                if not okChip then
                                    SetStatus(("Coop (%d acc) | Đang chờ đồng bộ Chip (%s)..."):format(
                                        #inServerMembers, tostring(buyReason)
                                    ))
                                    task.wait(0.25)
                                end
                            end

                            local mainBtn = GetLawButtonMain()
                            local buyerPos = (mainBtn and mainBtn.Position) or POS_LAW_BUYER
                            local arrivedBuyer = ContinuousTweenStep(buyerPos)
                            myAtPosFlag = arrivedBuyer

                            local allClonesReady = true
                            local readyCount = 0
                            for _, cName in ipairs(cloneList) do
                                local targetPod = clonePodAssignment[cName]
                                if targetPod and IsPlayerNearPos(cName, targetPod, 12) then
                                    readyCount = readyCount + 1
                                else
                                    allClonesReady = false
                                end
                            end

                            if arrivedBuyer and allClonesReady then
                                SetStatus(("Coop: Tất cả %d/%d Clone/BackHelp đã vào buồng -> Bấm Start Law Raid!"):format(
                                    readyCount, #cloneList
                                ))
                                pcall(function()
                                    local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
                                    if hum then hum:UnequipTools() end
                                end)
                                FireLawPedestal()
                                task.wait(0.5)
                            else
                                SetStatus(("Coop Buyer (%d Frag) | Đang chờ Clone/BackHelp vào buồng (%d/%d sẵn sàng)..."):format(
                                    GetFragments(), readyCount, #cloneList
                                ))
                                task.wait(0.25)
                            end
                        else
                            local myPodPos = clonePodAssignment[myName] or LAW_CLONE_PODS[1]
                            local arrivedPod = ContinuousTweenStep(myPodPos)
                            myAtPosFlag = arrivedPod
                            SetStatus(("Coop Clone | Buyer: %s | Giữ vị trí buồng (%s)..."):format(
                                buyerAcc, arrivedPod and "Đã vào buồng" or "Đang tween"
                            ))
                            task.wait(0.2)
                        end
                    end
                end
            end
        else
            task.wait(0.5)
        end
    end
end

-- ============================================================================
-- CƠ CHẾ BACK HELP SAU KHI PULL LEVER CYBORG V3 (VỪA FARM FRAG VỪA TRỰC CHỜ COOP)
-- ============================================================================
local function RunBackHelpCoopLaw(TravelToSeaFn)
    UnregisterAutoCySession()
    UnmarkCoreSupplyRecorded()

    local lastTeleportAttempt = 0
    local myAtPosFlag = false

    while not Stopped() do
        local coopData, myGroup = SyncAndRebalanceCoop(myAtPosFlag, true)
        local myName = LocalPlayer.Name
        local curJob = tostring(game.JobId)

        if myGroup then
            -- Khi có Group cần phụ -> Đảm bảo đang ở Sea 2
            if GetSea() ~= 2 then
                SetStatus("[BackHelp] Phát hiện Group cần phụ Law -> Chuyển về Sea 2...")
                TravelToSeaFn(2)
                if Stopped() then return end
            end

            local targetJob = tostring(myGroup.TargetJobId or curJob)

            if targetJob ~= "" and targetJob ~= curJob then
                myAtPosFlag = false
                CleanupMovement()
                SetStatus(("[BackHelp] Sang phụ Group [%s] (%d/5 acc) tại server %s..."):format(
                    tostring(myGroup.Id):sub(1, 10), #myGroup.Members, targetJob:sub(1, 8)
                ))
                if (os.clock() - lastTeleportAttempt) >= 4 then
                    lastTeleportAttempt = os.clock()
                    DirectTeleport(targetJob, game.PlaceId)
                end
                task.wait(1)
            else
                local inServerMembers = {}
                for _, mName in ipairs(myGroup.Members) do
                    local plr = Players:FindFirstChild(mName)
                    local pInfo = coopData.Players[mName]
                    if plr and pInfo and tostring(pInfo.JobId) == curJob then
                        table.insert(inServerMembers, {
                            Name       = mName,
                            Fragments  = tonumber(pInfo.Fragments) or 0,
                            HasChip    = (not pInfo.IsBackHelp) and (pInfo.HasChip == true) or false,
                            IsBackHelp = (pInfo.IsBackHelp == true),
                            AtPos      = (pInfo.AtPos == true),
                        })
                    end
                end

                -- Nếu có Boss Law đang sống (kể cả phát hiện qua ReplicatedStorage), bay lên đánh phụ ngay
                local lawBoss, lawHum = FindBossAlive({ "Order" })
                if lawBoss and lawHum and lawHum.Health > 0 then
                    myAtPosFlag = false
                    FightLawBossLoop(#inServerMembers, #myGroup.Members, true)
                    task.wait(0.3)
                else
                    -- Chọn Buyer trong các acc chính (không bao giờ chọn BackHelp mua chip)
                    local normalCandidates = {}
                    for _, m in ipairs(inServerMembers) do
                        if not m.IsBackHelp then
                            table.insert(normalCandidates, m)
                        end
                    end

                    if #normalCandidates == 0 then
                        myAtPosFlag = false
                        CleanupMovement()
                        SetStatus(("[BackHelp] Đang chờ chủ nhóm (%s) vào server..."):format(tostring(myGroup.InitialOwner)))
                        task.wait(0.5)
                    else
                        table.sort(normalCandidates, function(a, b)
                            if a.HasChip ~= b.HasChip then return a.HasChip end
                            if a.Fragments ~= b.Fragments then return a.Fragments > b.Fragments end
                            return a.Name < b.Name
                        end)
                        local buyerAcc = normalCandidates[1].Name

