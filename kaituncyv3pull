local function TravelToSea(targetSea)
    if targetSea == 3 then
        UnregisterAutoCySession()
        UnregisterCoopLaw()
        EnsureNoFruitInInventory()
    end
    while not Stopped() and GetSea() ~= targetSea do
        SetStatus("Đang chuyển sang Sea " .. tostring(targetSea) .. "...")
        if targetSea == 2 then
            pcall(function() CommF:InvokeServer("TravelDressrosa") end)
        elseif targetSea == 3 then
            EnsureNoFruitInInventory()
            pcall(function() CommF:InvokeServer("TravelZou") end)
            if not SleepCheck(3) then return false end
            if GetSea() ~= 3 then pcall(function() CommF:InvokeServer("TravelDressrosa") end) end
        end
        if not SleepCheck(4) then return false end
    end
    return not Stopped() and GetSea() == targetSea
end

RunSea3BossTarget = function(destination, preTweenPos, waitMsgFn, doneCheckFn)
    if Stopped() then return end
    if GetSea() ~= 3 then TravelToSea(3) end
    if Stopped() then return end

    if TweenTo(preTweenPos) and LaunchRealKidHop(destination) then
        local aliases = NH_BOSS_ALIASES[destination]
        local launchTick = os.clock()
        local lastNhCheck = 0
        local wasBossAlive = false
        local bossDiedTick = 0

        while not Stopped() and task.wait(1.5) do
            SetStatus(waitMsgFn())
            if doneCheckFn() then return end

            local bossAlive = aliases and (FindBossAlive(aliases) ~= nil) or false
            if bossAlive then
                wasBossAlive = true
                bossDiedTick = 0
            else
                if wasBossAlive and bossDiedTick == 0 then
                    bossDiedTick = os.clock()
                end
                local passedLaunch = (os.clock() - launchTick) >= 3
                local passedDropWait = (not wasBossAlive) or ((os.clock() - bossDiedTick) >= 5)
                if passedLaunch and passedDropWait and (os.clock() - lastNhCheck) >= 6 then
                    lastNhCheck = os.clock()
                    TryNightHubHop(destination, doneCheckFn)
                end
            end
        end
    end
end

