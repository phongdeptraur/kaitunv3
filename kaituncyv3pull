local function TweenTo(targetPos, abortFn)
    if Stopped() then return false end
    if IsTweenBlockedByHub() then
        SetStatus("RealKid đang chạy -> Không được tự tween, hop low refresh!")
        HopLow()
        return false
    end

    while not Stopped() do
        if abortFn and abortFn() then
            CleanupMovement()
            return false
        end
        local char, hum, hrp = WaitAlive()
        if Stopped() or not char then return false end

        if hum.Sit then
            hum.Sit = false
            hum:ChangeState(Enum.HumanoidStateType.Jumping)
            task.wait(0.2)
        end

        local dist = (hrp.Position - targetPos).Magnitude
        if dist <= 8 then return true end

        EnsureNoclipAndBV(char, hrp)

        ActiveTween = TweenService:Create(hrp, TweenInfo.new(dist / TWEEN_SPEED, Enum.EasingStyle.Linear), { CFrame = CFrame.new(targetPos) })
        ActiveTween:Play()

        while not Stopped() and ActiveTween and ActiveTween.PlaybackState == Enum.PlaybackState.Playing do
            if IsTweenBlockedByHub() then
                CleanupMovement()
                HopLow()
                return false
            end
            if abortFn and abortFn() then
                CleanupMovement()
                return false
            end
            if not char.Parent or hum.Health <= 0 or (hrp.Position - targetPos).Magnitude <= 8 then
                break
            end
            task.wait(0.08)
        end

        local arrived = (not Stopped()) and hum.Health > 0 and hrp.Parent and (hrp.Position - targetPos).Magnitude <= 12
        CleanupMovement()
        if Stopped() then return false end
        if arrived then return true end
        task.wait(0.5)
    end
    return false
end

-- Hàm cập nhật Tween liên tục mỗi 0.05s (dùng khi bám sát Order/Law hoặc giữ vị trí buồng)
local function ContinuousTweenStep(targetPos)
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not (char and hum and hrp and hum.Health > 0) then return false end

    if hum.Sit then
        hum.Sit = false
        hum:ChangeState(Enum.HumanoidStateType.Jumping)
    end

    EnsureNoclipAndBV(char, hrp)
    local dist = (hrp.Position - targetPos).Magnitude
    if ActiveTween then
        pcall(function() ActiveTween:Cancel() end)
        ActiveTween = nil
    end
    if dist > 1.5 then
        local dur = math.max(dist / TWEEN_SPEED, 0.05)
        ActiveTween = TweenService:Create(hrp, TweenInfo.new(dur, Enum.EasingStyle.Linear), { CFrame = CFrame.new(targetPos) })
        ActiveTween:Play()
    else
        hrp.CFrame = CFrame.new(targetPos)
    end
    return dist <= 10
end

