local function GetDistanceToPlayer(player)
    local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local tHRP = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if myHRP and tHRP then
        return (tHRP.Position - myHRP.Position).Magnitude
    end
    return nil
end

local function GetEnclosingSafeZone(pos, margin)
    local m = margin or 0
    local origin = workspace:FindFirstChild("_WorldOrigin")
    local szFolder = (origin and origin:FindFirstChild("SafeZones")) or workspace:FindFirstChild("SafeZones")
    if not szFolder then return nil end
    for _, z in ipairs(szFolder:GetChildren()) do
        if z:IsA("BasePart") then
            local rel = z.CFrame:PointToObjectSpace(pos)
            local half = z.Size / 2
            if math.abs(rel.X) <= (half.X + m) and math.abs(rel.Y) <= (half.Y + m) and math.abs(rel.Z) <= (half.Z + m) then
                return z
            end
        end
    end
    return nil
end

local function IsInSafeZone(player)
    if player == LocalPlayer then
        local pgui = LocalPlayer:FindFirstChild("PlayerGui")
        local main = pgui and pgui:FindFirstChild("Main")
        local sz = main and main:FindFirstChild("SafeZone")
        if sz and sz.Visible then return true end
        if pgui then
            for _, d in ipairs(pgui:GetDescendants()) do
                if d:IsA("TextLabel") and d.Visible and d.Text:lower():find("safe zone") then return true end
            end
        end
    end

    local char = player.Character
    if not char then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp and GetEnclosingSafeZone(hrp.Position, 0) then return true end
    if char:FindFirstChild("SafeZone") or char:FindFirstChild("InSafeZone") then return true end
    for k, v in pairs(char:GetAttributes()) do
        if k:lower():find("safezone") and (v == true or (type(v) == "number" and v > 0)) then return true end
    end
    local pData = player:FindFirstChild("Data")
    if pData then
        for _, v in ipairs(pData:GetChildren()) do
            if v.Name:lower():find("safezone") and (v.Value == true or (type(v.Value) == "number" and v.Value > 0)) then return true end
        end
    end
    for k, v in pairs(player:GetAttributes()) do
        if k:lower():find("safezone") and (v == true or (type(v) == "number" and v > 0)) then return true end
    end
    return false
end

local function HasTruePvPDisabled(player)
    if player == LocalPlayer then
        local pgui = LocalPlayer:FindFirstChild("PlayerGui")
        local main = pgui and pgui:FindFirstChild("Main")
        local pd = main and main:FindFirstChild("PvpDisabled")
        if pd and pd.Visible then return true end
        if pgui then
            for _, d in ipairs(pgui:GetDescendants()) do
                if d:IsA("TextLabel") and d.Visible then
                    local t = d.Text:lower()
                    if t:find("pvp disabled") or t:find("died recently") then return true end
                end
            end
        end
    end

    local char = player.Character
    if not char then return true end
    if char:FindFirstChildOfClass("ForceField") or char:FindFirstChild("PvpDisabled") then return true end
    for k, v in pairs(char:GetAttributes()) do
        if k:lower():find("pvpdisabled") and (v == true or (type(v) == "number" and v > 0)) then return true end
    end
    local pData = player:FindFirstChild("Data")
    if pData then
        local lvl = pData:FindFirstChild("Level")
        if lvl and type(lvl.Value) == "number" and lvl.Value < 20 then return true end
        for _, v in ipairs(pData:GetChildren()) do
            local l = v.Name:lower()
            if l:find("pvpdisabled") and (v.Value == true or (type(v.Value) == "number" and v.Value > 0)) then return true end
            if l == "pvp" and v.Value == false then return true end
        end
    end
    for k, v in pairs(player:GetAttributes()) do
        local l = k:lower()
        if l:find("pvpdisabled") and (v == true or (type(v) == "number" and v > 0)) then return true end
        if l == "pvp" and v == false then return true end
    end
    return false
end

