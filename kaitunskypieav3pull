    local okW, wStat = pcall(function() return CommF:InvokeServer("Wenlocktoad", "1") end)
    if okW and wStat == -2 then
        hasV3 = true
        ConfirmedHasV3 = true
    end
end

local hasV2 = HasRaceV2()

if not hasV3 then
    local reqBeli = hasV2 and 2000000 or 2500000
    local reqFrag = 10000

    if GetBeli() < reqBeli then
        if GetSea() ~= 3 then TravelToSea(3) end
        if not Stopped() and LaunchRealKidMain({ Chest = true }, ("Farm Chest lấy Beli (%d/%d)"):format(GetBeli(), reqBeli)) then
            while not Stopped() and task.wait(1.5) do
                SetStatus(("Đang farm Beli: %d / %d"):format(GetBeli(), reqBeli))
                if GetBeli() >= reqBeli then
                    SetStatus("Đã đủ Beli! Hop Low để refresh...")
                    HopLow()
                    return
                end
            end
        end
        return
    end

    if GetFragments() < reqFrag then
        RunSea3BossTarget(
            DESTINATIONS.CAKE_PRINCE,
            POS_CAKE_LOAF,
            function() return ("Đang farm Fragment (Cake Prince): %d / %d"):format(GetFragments(), reqFrag) end,
            function()
                if GetFragments() >= reqFrag then
                    SetStatus("Đã đủ 10k Fragment! Hop Low để refresh...")
                    HopLow()
                    return true
                end
                return false
            end
        )
        return
    end

    -- 2A. CHƯA CÓ SKYPIEA V2 -> TP SEA 2 CHẠY REALKID MAIN ĐỂ UP V2
    if GetSea() ~= 2 then TravelToSea(2) end
    if Stopped() then return end

    if not hasV2 then
        if not HasBlueFlower() and not IsNight() then
            SetStatus(("Đang up Skypiea V2 nhưng trời sáng (Clock: %.1f) -> Hop Low tìm trời tối..."):format(Lighting.ClockTime))
            HopLow()
            return
        end

        if LaunchRealKidMain({ AutoUpgradeRaceV3 = true }, "Auto Skypiea V2 (Sea 2)") then
            while not Stopped() and task.wait(2) do
                if HasRaceV2() then
                    SetStatus("Đã xong Skypiea V2! Hop High (11/12) để tự up Skypiea V3...")
                    HopHigh()
                    return
                end
                if not HasBlueFlower() and not IsNight() then
                    SetStatus(("Đang up Skypiea V2 mà trời chuyển sáng (Clock: %.1f) -> Hop Low tìm trời tối..."):format(Lighting.ClockTime))
                    HopLow()
                    return
                end
                SetStatus(("Đang làm Skypiea V2 ở Sea 2 (Clock: %.1f)..."):format(Lighting.ClockTime))
            end
        end
        return
    end

    -- 2B. ĐÃ XONG SKYPIEA V2 -> UP SKYPIEA V3 (SOLO KILL 1 SKYPIEA + CO-OP)
    RunSkypieaV3Phase()
    return
end
if Stopped() then return end

RemoveFromSkypieaSession()

-- 3. ĐÃ ĐỦ SKYPIEA V3 -> ĐẢM BẢO ĐỦ 10K FRAGMENT TRƯỚC KHI CHECK INVENTORY (THEO DÕI BACK-HELP)
if GetFragments() < 10000 then
    RunSea3BossTarget(
        DESTINATIONS.CAKE_PRINCE,
        POS_CAKE_LOAF,
        function() return ("Đã có Skypiea V3 | Farm nốt Frag: %d / 10000"):format(GetFragments()) end,
        function()
            if GetFragments() >= 10000 then
                SetStatus("Đã đủ 10k Fragment! Hop Low để refresh...")
                HopLow()
                return true
            end
            return false
        end
    )
    return
end
if Stopped() then return end

if CheckAndClaimBackHelp() then CleanupMovement(); TravelToSea(2); return end
if GetSea() ~= 3 then TravelToSea(3) end
if Stopped() then return end

-- 4. CHECK INVENTORY: VALKYRIE HELM & MIRROR FRACTAL
local hasHelm, hasMirror = CheckInvItems()
if Stopped() then return end

if not hasHelm then
    RunSea3BossTarget(
        DESTINATIONS.RIP_INDRA,
        POS_SEA_CASTLE,
        function() return "Thiếu Valkyrie Helm -> Đang săn Rip Indra..." end,
        function()
            local h = CheckInvItems()
            if h then
                SetStatus("Đã lấy được Valkyrie Helm! Hop Low để refresh...")
                HopLow()
                return true
            end
            return false
        end
    )
    return
end

if not hasMirror then
    RunSea3BossTarget(
        DESTINATIONS.DOUGH_KING,
        POS_CAKE_LOAF,
        function() return "Thiếu Mirror Fractal -> Đang săn Dough King..." end,
        function()
            local _, m = CheckInvItems()
            if m then
                SetStatus("Đã lấy được Mirror Fractal! Hop Low để refresh...")
                HopLow()
                return true
            end
            return false
        end
    )
    return
end

-- 5. ĐỦ SKYPIEA V3 + 10K FRAG + MŨ + MẢNH -> CHECK & AUTO PULL LEVER (VẪN THEO DÕI BACK-HELP)
if not IsLeverPulled() then
    if LaunchRealKidMain({ AutoPullLever = true }, "Auto Pull Lever (Temple of Time)") then
        while not Stopped() and task.wait(2) do
            if CheckAndClaimBackHelp() then CleanupMovement(); TravelToSea(2); return end
            SetStatus("Đang chạy Auto Pull Lever...")
            if IsLeverPulled() then break end
        end
    end
end

if Stopped() then return end
SetStatus("CHÚC MỪNG! Đã hoàn thành Skypiea V3 + Pull Lever! (Đang trực Back-Help)")
while not Stopped() and task.wait(2.5) do
    if CheckAndClaimBackHelp() then
        CleanupMovement()
        TravelToSea(2)
        return
    end
end
