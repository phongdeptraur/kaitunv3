            placeId = game.PlaceId,
            playersCount = #Players:GetPlayers(),
            maxPlayers = Players.MaxPlayers or 12,
            updatedAt = now,
        }
    end)
    if not cleaned then return nil, {}, nil, {} end
    local activeList, hostEntry, cloneList = AnalyzeSkypieaSession(cleaned)
    local myEntry = cleaned[MY_UID]
    return myEntry and myEntry.role or "host", activeList, hostEntry, cloneList
end

