local function ReadSkypieaSessionRaw()
    if not (isfile and readfile and isfile(SESSION_FILE)) then return {}, true end
    for _ = 1, 3 do
        local okR, raw = pcall(readfile, SESSION_FILE)
        if okR and type(raw) == "string" then
            if raw:match("^%s*$") then return {}, true end
            local okD, data = pcall(function() return HttpService:JSONDecode(raw) end)
            if okD and type(data) == "table" then return data, true end
        end
        task.wait(0.05)
    end
    return nil, false
end

local function UpdateSkypieaSession(mutatorFn)
    local data, ok = ReadSkypieaSessionRaw()
    if not ok or not data then return nil end
    local now = os.time()
    local cleaned = {}
    for uid, entry in pairs(data) do
        if type(entry) == "table" and type(entry.updatedAt) == "number" and (now - entry.updatedAt) <= SESSION_TTL then
            cleaned[tostring(uid)] = entry
        end
    end
    if mutatorFn then
        mutatorFn(cleaned, now)
    end
    if writefile then
        pcall(writefile, SESSION_FILE, HttpService:JSONEncode(cleaned))
    end
    return cleaned
end

RemoveFromSkypieaSession = function()
    UpdateSkypieaSession(function(tbl)
        tbl[MY_UID] = nil
    end)
end

local function AnalyzeSkypieaSession(tbl)
    local activeList, hosts, clones = {}, {}, {}
    for _, e in pairs(tbl or {}) do
        table.insert(activeList, e)
        if e.role == "host" then
            table.insert(hosts, e)
        elseif e.role == "clone" then
            table.insert(clones, e)
        end
    end
    local primaryHost = nil
    if #hosts > 0 then
        table.sort(hosts, function(a, b)
            if (a.isBackHelp and not b.isBackHelp) then return true end
            if (not a.isBackHelp and b.isBackHelp) then return false end
            return tostring(a.userId) < tostring(b.userId)
        end)
        primaryHost = hosts[1]
    end
    return activeList, primaryHost, clones
end

local function SyncV3SessionEntry()
    local cleaned = UpdateSkypieaSession(function(tbl, now)
        local me = tbl[MY_UID]
        local otherHost = nil
        local lowestUid = tonumber(MY_UID) or 0
        for uid, e in pairs(tbl) do
            if uid ~= MY_UID and e.role == "host" then
                otherHost = e
            end
            local num = tonumber(uid) or math.huge
            if num < lowestUid then lowestUid = num end
        end

        local role
        if me and me.role == "clone" and otherHost then
            role = "clone"
        elseif otherHost then
            role = "clone"
        elseif me and me.role == "host" then
            role = "host"
        else
            -- Không có host: nếu chỉ có 1 mình hoặc mình có UserId nhỏ nhất thì nhận host
            role = (lowestUid == (tonumber(MY_UID) or 0)) and "host" or "clone"
        end

        tbl[MY_UID] = {
            userId = LocalPlayer.UserId,
            name = LocalPlayer.Name,
            role = role,
            isBackHelp = false,
            needsV3 = true,
            sea = GetSea(),
