        else
            getgenv()._AutoSkypieaAimHRP = nil
            getgenv()._AutoSkypieaAimPos = nil
        end

        if (tHRP.Position - myHRP.Position).Magnitude > MAX_PVP_DIST then
            CancelActiveTween()
            return
        end

        local goalPos = hoverAboveMode
            and (tHRP.Position + Vector3.new(0, 60, 0))
            or (tHRP.CFrame * CFrame.new(0, 0.5, 2)).Position
        local goalDist = (goalPos - myHRP.Position).Magnitude

        if goalDist <= 3 then
            CancelActiveTween()
            local lookAt = Vector3.new(tHRP.Position.X, myHRP.Position.Y, tHRP.Position.Z)
            if (lookAt - myHRP.Position).Magnitude > 0.1 then
                myHRP.CFrame = CFrame.new(myHRP.Position, lookAt)
            end
            return
        end

        local now = os.clock()
        if (now - lastTween) >= 0.1 then
            lastTween = now
            CancelActiveTween()
            local dur = math.max(goalDist / TWEEN_SPEED, 0.02)
            local lookAt = Vector3.new(tHRP.Position.X, goalPos.Y, tHRP.Position.Z)
            local goalCF = (not hoverAboveMode and (lookAt - goalPos).Magnitude > 0.1)
                and CFrame.new(goalPos, lookAt)
                or CFrame.new(goalPos)
            ActiveTween = TweenService:Create(myHRP, TweenInfo.new(dur, Enum.EasingStyle.Linear), { CFrame = goalCF })
            ActiveTween:Play()
        end
    end)
end

