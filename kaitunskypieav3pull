local function HopServer(mode)
    if Stopped() or getgenv()._HoppingServer then return end
    getgenv()._HoppingServer = true
    local isHigh = (mode == "high")
    SetStatus(isHigh and "Đang tìm server đông (11/12 player)..." or "Đang tìm server low player & ping thấp để refresh...")

    while not Stopped() and task.wait(0.3) do
        local list = {}
        local browser = ReplicatedStorage:FindFirstChild("__ServerBrowser")
        if browser then
            local done, byJob = 0, {}
            for page = 1, 150 do
                if Stopped() then break end
                task.spawn(function()
                    for _ = 1, 2 do
                        if Stopped() then break end
                        local ok, res = pcall(function() return browser:InvokeServer(page) end)
                        if ok and type(res) == "table" then
                            for jid, d in pairs(res) do
                                local id = tostring(jid)
                                if not TriedJobs[id] and not byJob[id] then
                                    local cnt = (type(d) == "table" and tonumber(d.Count)) or tonumber(d) or 1
                                    local reg = (type(d) == "table" and tostring(d.Region or "")) or ""
                                    local ping = reg:find("Sing") and 40 or reg:find("Japan") and 95 or reg:find("Germ") and 190 or (reg:find("US") or reg:find("United States")) and 230 or 140
                                    if (isHigh and cnt >= 6 and cnt < 12) or (not isHigh and cnt >= 1 and cnt < 11) then
                                        byJob[id] = { id = id, playing = cnt, ping = ping }
                                    end
                                end
                            end
                            break
                        end
                        task.wait(0.04)
                    end
                    done = done + 1
                end)
            end
            local t0 = os.clock()
            repeat task.wait(0.05) until Stopped() or done >= 150 or (os.clock() - t0) >= 3.5
            for _, s in pairs(byJob) do table.insert(list, s) end
        end

        if Stopped() then break end

        if #list == 0 then
            local cursor = ""
            local sortDir = isHigh and "Desc" or "Asc"
            for _ = 1, 5 do
                if Stopped() then break end
                local url = ("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=%s&limit=100%s")
                    :format(game.PlaceId, sortDir, cursor ~= "" and ("&cursor=" .. cursor) or "")
                local ok, raw = pcall(function() return game:HttpGet(url) end)
                local okJ, data = false, nil
                if ok and raw then okJ, data = pcall(function() return HttpService:JSONDecode(raw) end) end
                if not okJ or not data or not data.data then break end
                for _, s in ipairs(data.data) do
                    local id = tostring(s.id)
                    local cnt = tonumber(s.playing) or 0
                    local maxP = tonumber(s.maxPlayers) or 12
                    if not TriedJobs[id] and cnt < maxP and ((isHigh and cnt >= 6) or (not isHigh and cnt >= 1)) then
                        table.insert(list, { id = id, playing = cnt, ping = tonumber(s.ping) or 999 })
                    end
                end
                cursor = data.nextPageCursor
                if not cursor or cursor == "" then break end
            end
        end

        if Stopped() then break end

        if #list == 0 then
            TriedJobs = { [tostring(game.JobId)] = os.time() }
        else
            local pool = {}
            if isHigh then
                for _, s in ipairs(list) do
                    if s.playing == 11 then table.insert(pool, s) end
                end
                if #pool == 0 then pool = list end
                table.sort(pool, function(a, b)
                    if a.playing ~= b.playing then return a.playing > b.playing end
                    return a.ping < b.ping
                end)
            else
                for _, s in ipairs(list) do
                    if s.ping <= 70 and s.playing <= 8 then table.insert(pool, s) end
                end
                if #pool == 0 then pool = list end
                table.sort(pool, function(a, b)
                    local aTier, bTier = math.floor(a.ping / 30), math.floor(b.ping / 30)
                    if aTier ~= bTier then return aTier < bTier end
                    if a.playing ~= b.playing then return a.playing < b.playing end
                    return a.ping < b.ping
                end)
            end

            for i = 1, math.min(#pool, 5) do
                if Stopped() then break end
                local target = pool[i]
                RecordJobCache(HOP_CACHE_FILE, TriedJobs, target.id)
                SetStatus(("%s -> %s | Players: %d | Ping: %dms"):format(isHigh and "Hop High" or "Hop Low", target.id:sub(1, 8), target.playing, target.ping))
                DirectTeleport(target.id, game.PlaceId)
                if not SleepCheck(3) then break end
            end
        end
        if not SleepCheck(1) then break end
    end
    getgenv()._HoppingServer = false
end

