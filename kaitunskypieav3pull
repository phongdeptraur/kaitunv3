end

local function RunSea3BossTarget(destination, preTweenPos, waitMsgFn, doneCheckFn)
    if Stopped() then return end
    if CheckAndClaimBackHelp() then CleanupMovement(); TravelToSea(2); return end
    if GetSea() ~= 3 then TravelToSea(3) end
    if Stopped() then return end

    if TweenTo(preTweenPos) and LaunchRealKidHop(destination) then
        local aliases = NH_BOSS_ALIASES[destination]
        local launchTick = os.clock()
        local lastNhCheck = 0
        local wasBossAlive = false
        local bossDiedTick = 0

        while not Stopped() and task.wait(1.5) do
            if CheckAndClaimBackHelp() then CleanupMovement(); TravelToSea(2); return end
            SetStatus(waitMsgFn())
            if doneCheckFn() then return end

            local bossAlive = aliases and (FindBossAlive(aliases) ~= nil) or false
            if bossAlive then
                wasBossAlive = true
                bossDiedTick = 0
            else
                if wasBossAlive and bossDiedTick == 0 then
                    bossDiedTick = os.clock()
                end
                local passedLaunch = (os.clock() - launchTick) >= 3
                local passedDropWait = (not wasBossAlive) or ((os.clock() - bossDiedTick) >= 5)
                if passedLaunch and passedDropWait and (os.clock() - lastNhCheck) >= 6 then
                    lastNhCheck = os.clock()
                    TryNightHubHop(destination, doneCheckFn)
                end
            end
        end
    end
end

-- ============================================================================
-- CHẾ ĐỘ SKYPIEA V3 CHÍNH (SOLO KILL 1 SKYPIEA 3M/SAFEZONE + CO-OP CLONE/HOST)
-- ============================================================================
local function RunSkypieaV3Phase()
    if GetSea() ~= 2 then TravelToSea(2) end
    if Stopped() then return end

    local chosenSword = nil
    local statsChecked = false
    local deprioritized = {}

    local function CheckWenlock()
        local ok, rs = pcall(function() return CommF:InvokeServer("Wenlocktoad", "1") end)
        if not ok then return nil end
        if rs == -2 then
            ConfirmedHasV3 = true
            return -2
        end
        if rs == 0 then
            SetStatus("Starting Trial (Wenlocktoad 2)...")
            pcall(function() CommF:InvokeServer("Wenlocktoad", "2") end)
            SleepCheck(0.4)
        elseif rs == 2 then
            SetStatus("Đủ kill Skypiea -> Trả nhiệm vụ Skypiea V3 (Wenlocktoad 3)...")
            pcall(function() CommF:InvokeServer("Wenlocktoad", "3") end)
            SleepCheck(0.5)
        end
        return rs
    end

    local function PrepareV3Weapons()
        if statsChecked then
            if chosenSword and not FindToolByKind(nil, chosenSword) then
                pcall(function() CommF:InvokeServer("LoadItem", chosenSword) end)
            end
            return
        end
        chosenSword = GetPvPV3Sword()
        if chosenSword then EnsureSwordStats2800() end
        statsChecked = true
    end

    local function EngageTargetStep(targetPlayer, tChar, myHRP, startTick, labelPrefix)
        local tHRP = tChar:FindFirstChild("HumanoidRootPart")
        local tHum = tChar:FindFirstChildOfClass("Humanoid")
        if not (tHRP and tHum and tHum.Health > 0) then return false end

        local elapsedMin = (os.clock() - startTick) / 60
        local realDist = (tHRP.Position - myHRP.Position).Magnitude

        if IsInSafeZone(targetPlayer) then
            hoverAboveMode = true
            SetStatus(("%s: %s vào Safe Zone (giữ khóa, +60 stud) | %.0fm"):format(labelPrefix, targetPlayer.DisplayName, elapsedMin))
            SleepCheck(0.2)
            return true
        end

        local weapons = {}
        if chosenSword then
            local sw = FindToolByKind(nil, chosenSword)
            if sw then table.insert(weapons, sw) end
        end
        local ml = FindToolByKind("Melee")
        if ml then table.insert(weapons, ml) end

        local activeTool, readyKeys = nil, nil
        for _, w in ipairs(weapons) do
            local rk = GetReadySkillsForTool(w)
            if #rk > 0 then
                activeTool, readyKeys = w, rk
                break
            end
        end

        if activeTool then
            hoverAboveMode = false
            SetStatus(("%s: %s [%.0f stud] | Spam %s | %.0fm"):format(labelPrefix, targetPlayer.DisplayName, realDist, activeTool.Name, elapsedMin))
            if realDist <= 22 then
                CastReadySkills(activeTool, readyKeys, tHRP)
                if not Stopped() and (not tHum.Parent or tHum.Health <= 0) then
                    pcall(function() CommF:InvokeServer("Wenlocktoad", "3") end)
                    SleepCheck(0.25)
                end
            else
                SleepCheck(0.1)
            end
        else
            hoverAboveMode = true
            SetStatus(("%s: %s [%.0f stud] | Hồi chiêu (+60 stud) | %.0fm"):format(labelPrefix, targetPlayer.DisplayName, realDist, elapsedMin))
            SleepCheck(0.15)
        end
        return true
    end

    while not Stopped() do
        local stW = CheckWenlock()
        if HasRaceV3() or stW == -2 then
            ConfirmedHasV3 = true
            StopPvPTween()
            RemoveFromSkypieaSession()
            SetStatus("Đã xong Skypiea V3! Đang TP sang Sea 3...")
            TravelToSea(3)
            return
        end

        local myRole, activeList, hostEntry = SyncV3SessionEntry()

        -- CO-OP MODE (>= 2 acc trong skypieasession.txt)
        if #activeList >= 2 then
            if myRole == "host" then
                RunCoopHost(false)
            else
                -- CLONE MODE
                StopPvPTween()
                if not hostEntry or hostEntry.sea ~= 2 or tostring(hostEntry.jobId or "") == "" then
                    SetStatus("Co-op Clone: Đợi Host vào Sea 2...")
                    SleepCheck(2)
                elseif tostring(hostEntry.jobId) ~= tostring(game.JobId) then
                    SetStatus(("Co-op Clone -> Join server Host (%s)..."):format(tostring(hostEntry.name)))
                    DirectTeleport(tostring(hostEntry.jobId), tonumber(hostEntry.placeId) or game.PlaceId)
                    SleepCheck(4)
                else
                    -- Chung server Sea 2 với Host -> bật PvP & đánh Host đến khi lên V3
                    EnsureTeam("Pirates")
                    EnsureMyPvPEnabled()
                    PrepareV3Weapons()
                    local cloneStart = os.clock()
                    local hostPlayer = nil
                    EnsurePvPTweenLoop(function() return hostPlayer end)

                    local lastSync = 0
                    while not Stopped() do
                        local curW = CheckWenlock()
                        if HasRaceV3() or curW == -2 then
                            ConfirmedHasV3 = true
                            StopPvPTween()
                            RemoveFromSkypieaSession()
                            SetStatus("Co-op Clone xong Skypiea V3! Đang sang Sea 3...")
                            TravelToSea(3)
                            return
                        end

                        if (os.clock() - lastSync) >= 2 then
                            lastSync = os.clock()
                            local r2, list2, h2 = SyncV3SessionEntry()
                            hostEntry = h2
                            if #list2 < 2 or r2 == "host" or not h2 or h2.sea ~= 2 or tostring(h2.jobId) ~= tostring(game.JobId) then
                                StopPvPTween()
                                break
                            end
                        end

                        local char, _, myHRP = WaitAlive()
                        if Stopped() or not char then break end
                        if not char:FindFirstChild("HasBuso") then pcall(function() CommF:InvokeServer("Buso") end) end
                        if not LocalPlayer.Team or LocalPlayer.Team.Name ~= "Pirates" then EnsureTeam("Pirates") end
                        EnsureMyPvPEnabled()
                        PrepareV3Weapons()

                        hostPlayer = Players:GetPlayerByUserId(tonumber(hostEntry.userId)) or Players:FindFirstChild(tostring(hostEntry.name))
                        if hostPlayer and hostPlayer.Character and IsLockedTargetValid(hostPlayer, hostPlayer.Character, false) then
                            EngageTargetStep(hostPlayer, hostPlayer.Character, myHRP, cloneStart, "Co-op Kill Host")
                        else
                            hoverAboveMode = false
                            SetStatus(("Co-op Clone: Đợi Host (%s) ra khỏi Safe Zone / bật PvP..."):format(tostring(hostEntry.name)))
                            SleepCheck(0.4)
                        end
                    end
                    StopPvPTween()
                end
            end
        else
            -- SOLO MODE (< 2 acc trong skypieasession.txt): chỉ cần kill 1 người có race Skypiea
            EnsureTeam("Pirates")
            EnsureMyPvPEnabled()
            if Stopped() then break end

            -- Đợi ngắn 2.5s cho player/Data load sau hop, đồng thời vẫn bắt chuyển Co-op nếu có acc khác vừa vào session
            local switchToCoop = false
            if CountSkypieaPvPPlayers() < 1 then
                local waitRep = os.clock()
                while not Stopped() and (os.clock() - waitRep) < 2.5 do
                    local rWait, lWait = SyncV3SessionEntry()
                    if #lWait >= 2 or rWait == "clone" then
                        switchToCoop = true
                        break
                    end
                    if CountSkypieaPvPPlayers() >= 1 then break end
                    task.wait(0.25)
                end
            end

            if not switchToCoop then
                local rCheck, lCheck = SyncV3SessionEntry()
                if #lCheck >= 2 or rCheck == "clone" then
                    switchToCoop = true
                end
            end

            if not switchToCoop then
                if CountSkypieaPvPPlayers() < 1 then
                    SetStatus(("Solo Skypiea V3: Có %d/1 Skypiea PvP ON (Tổng Skypiea: %d) -> Hop High (11/12)..."):format(CountSkypieaPvPPlayers(), CountSkypieaPlayersInServer()))
                    HopHigh()
                    return
                end

                PrepareV3Weapons()
                if Stopped() then break end

                local v3Start = os.clock()
                local currentTarget, lockedChar, lockStart = nil, nil, 0
                local noTargetSince = 0
                local lastSync = 0
                EnsurePvPTweenLoop(function() return currentTarget end)

                while not Stopped() do
                    if (os.clock() - v3Start) >= SKYPIEA_V3_TIMEOUT then
                        StopPvPTween()
                        SetStatus("Up Skypiea V3 quá 45 phút trong server này -> Hop Low!")
                        HopLow()
                        return
                    end

                    local curStat = CheckWenlock()
                    if HasRaceV3() or curStat == -2 then
                        ConfirmedHasV3 = true
                        StopPvPTween()
                        RemoveFromSkypieaSession()
                        SetStatus("Đã hoàn thành Skypiea V3! Đang TP sang Sea 3...")
                        TravelToSea(3)
                        return
                    end

                    if (os.clock() - lastSync) >= 2 then
                        lastSync = os.clock()
                        local r2, list2 = SyncV3SessionEntry()
                        if #list2 >= 2 or r2 == "clone" then
                            StopPvPTween()
                            SetStatus("Phát hiện Co-op / Back-Help -> Chuyển sang chế độ Co-op!")
                            break
                        end
                    end

                    local char, _, myHRP = WaitAlive()
                    if Stopped() or not char then break end
                    if not char:FindFirstChild("HasBuso") then pcall(function() CommF:InvokeServer("Buso") end) end
                    if not LocalPlayer.Team or LocalPlayer.Team.Name ~= "Pirates" then EnsureTeam("Pirates") end
                    EnsureMyPvPEnabled()
                    PrepareV3Weapons()

                    -- Kiểm tra hết hạn lock 3 phút hoặc mục tiêu chết / PvP OFF thật / đổi race / out game
                    if currentTarget then
                        if not IsLockedTargetValid(currentTarget, lockedChar, true) then
                            local deadOrRespawn = (not currentTarget.Parent) or (currentTarget.Character ~= lockedChar)
                                or (not lockedChar or not lockedChar:FindFirstChildOfClass("Humanoid") or lockedChar:FindFirstChildOfClass("Humanoid").Health <= 0)
                            if deadOrRespawn then
                                pcall(function() CommF:InvokeServer("Wenlocktoad", "3") end)
                            end
                            currentTarget, lockedChar, lockStart = nil, nil, 0
                        elseif (os.clock() - lockStart) >= LOCK_TIMEOUT then
                            deprioritized[currentTarget.UserId] = os.clock()
                            SetStatus(("Quá 3p chưa kill được %s -> Đổi mục tiêu Skypiea khác!"):format(currentTarget.DisplayName))
                            currentTarget, lockedChar, lockStart = nil, nil, 0
                        end
                    end

                    if not currentTarget then
                        local nextT = GetNextSoloSkypieaTarget(deprioritized)
                        if nextT and nextT.Character then
                            currentTarget = nextT
                            lockedChar = nextT.Character
                            lockStart = os.clock()
                            noTargetSince = 0
                        end
                    else
                        noTargetSince = 0
                    end

                    if currentTarget and lockedChar and lockedChar.Parent then
                        local kept = EngageTargetStep(currentTarget, lockedChar, myHRP, lockStart, "Solo Lock Skypiea")
                        if not kept then
                            currentTarget, lockedChar, lockStart = nil, nil, 0
                            SleepCheck(0.15)
                        end
                    else
                        hoverAboveMode = false
                        if noTargetSince == 0 then noTargetSince = os.clock() end
                        local skypieaTotal = CountSkypieaPlayersInServer()
                        local waitElapsed = os.clock() - noTargetSince
                        if (skypieaTotal == 0 and waitElapsed >= 5) or waitElapsed >= 15 then
                            StopPvPTween()
                            SetStatus(("Không còn mục tiêu Skypiea PvP ON (%d Skypiea) -> Hop High (11/12)!"):format(skypieaTotal))
                            HopHigh()
                            return
                        end
                        SetStatus(("Chờ player Skypiea PvP ON (<= 50k stud)... | %.0fm/45m"):format((os.clock() - v3Start) / 60))
                        SleepCheck(0.4)
                    end
                end
                StopPvPTween()
            end
        end
    end
end

