-- CO-OP HOST TẾ MẠNG (RA KHỎI SAFE ZONE, BẬT PVP CHO CLONE ĐÁNH)
-- ============================================================================
local function FindSafeOutdoorSpot(myPos)
    local z = GetEnclosingSafeZone(myPos, 4)
    if z then
        local half = z.Size / 2
        local dirs = {
            z.CFrame.LookVector * (half.Z + 35),
            -z.CFrame.LookVector * (half.Z + 35),
            z.CFrame.RightVector * (half.X + 35),
            -z.CFrame.RightVector * (half.X + 35),
        }
        local bestPos, bestDist = nil, math.huge
        for _, off in ipairs(dirs) do
            local cand = Vector3.new(z.Position.X + off.X, math.max(myPos.Y, z.Position.Y) + 18, z.Position.Z + off.Z)
            if not GetEnclosingSafeZone(cand, 4) then
                local d = (cand - myPos).Magnitude
                if d < bestDist then
                    bestPos, bestDist = cand, d
                end
            end
        end
        if bestPos then return bestPos end
    end
    return Vector3.new(-380, 95, 300)
end

local function RunCoopHost(isBackHelp)
    StopPvPTween()
    if GetSea() ~= 2 then
        TravelToSea(2)
        return
    end
    if getgenv()._RealKidMainRunning or getgenv()._RealKidHopRunning then
        HopLow()
        return
    end

    -- Chọn team Marines để không bị trùng Crew Pirate chặn sát thương với clone
    EnsureTeam("Marines")
    if Stopped() then return end

    local fullWaitSince = 0
    while not Stopped() do
        local keepGoing, clones
        if isBackHelp then
            local okNeed, _, cl = SyncBackHelpHost()
            keepGoing, clones = okNeed, cl
            if not keepGoing then
                CleanupMovement()
                SetStatus("Back-Help hoàn tất (Clone đã lên Skypiea V3)! Quay lại Sea 3...")
                TravelToSea(3)
                return
            end
        else
            local myRole, activeList, _, cl = SyncV3SessionEntry()
            clones = cl
            if HasRaceV3() then
                CleanupMovement()
                return
            end
            if myRole ~= "host" or #activeList < 2 then
                CleanupMovement()
                return
            end
        end

        -- Kiểm tra slot server: nếu full khiến clone chưa kịp join -> Hop Low
        local missingClones = 0
        for _, c in ipairs(clones or {}) do
            if tostring(c.jobId) ~= tostring(game.JobId) then
                missingClones = missingClones + 1
            end
        end
        local maxP = Players.MaxPlayers or 12
        local freeSlots = maxP - #Players:GetPlayers()
        if missingClones > 0 and freeSlots < missingClones then
            CleanupMovement()
            SetStatus(("Server đầy (%d/%d) còn %d Clone chưa vào -> Hop Low!"):format(#Players:GetPlayers(), maxP, missingClones))
            HopLow()
            return
        elseif missingClones > 0 and #Players:GetPlayers() >= (maxP - 1) then
            if fullWaitSince == 0 then fullWaitSince = os.clock() end
            if (os.clock() - fullWaitSince) >= 20 then
                CleanupMovement()
                SetStatus("Server quá đông, Clone chưa join kịp -> Hop Low!")
                HopLow()
                return
            end
        else
            fullWaitSince = 0
        end

        local char, hum, myHRP = WaitAlive()
        if Stopped() or not char then break end
        if not LocalPlayer.Team or LocalPlayer.Team.Name ~= "Marines" then
            EnsureTeam("Marines")
        end

        -- Giữ Anti-Gravity + Noclip liên tục để đứng ngoài Safe Zone chờ clone đánh
        if not ActiveNoclip then
            ActiveNoclip = RunService.Stepped:Connect(function()
                if Stopped() then return end
                local ch = LocalPlayer.Character
                local h = ch and ch:FindFirstChildOfClass("Humanoid")
                local r = ch and ch:FindFirstChild("HumanoidRootPart")
                if ch and ch.Parent then
                    for _, p in ipairs(ch:GetDescendants()) do
                        if p:IsA("BasePart") and p.CanCollide then p.CanCollide = false end
                    end
                end
                if h and h.Health > 0 and h.Sit then h.Sit = false end
                if r and r.Parent then
                    EnsureAntiGravity(r)
                    r.AssemblyLinearVelocity = Vector3.zero
                    r.AssemblyAngularVelocity = Vector3.zero
                end
            end)
        end

        if IsInSafeZone(LocalPlayer) then
            local outPos = FindSafeOutdoorSpot(myHRP.Position)
            SetStatus(("%s: Đang bay ra ngoài Safe Zone để Clone đánh..."):format(isBackHelp and "Back-Help Host" or "Co-op Host"))
            local d = (outPos - myHRP.Position).Magnitude
            CancelActiveTween()
            ActiveTween = TweenService:Create(myHRP, TweenInfo.new(math.max(d / TWEEN_SPEED, 0.05), Enum.EasingStyle.Linear), { CFrame = CFrame.new(outPos) })
            ActiveTween:Play()
            SleepCheck(0.8)
        else
            CancelActiveTween()
            EnsureMyPvPEnabled()
            SetStatus(("%s: Đứng ngoài Safe Zone (PvP ON) | Clones: %d"):format(isBackHelp and "Back-Help Host" or "Co-op Host", #(clones or {})))
            SleepCheck(1.2)
        end
    end
    CleanupMovement()
end

