    if #cands == 0 then return false end

    table.sort(cands, function(a, b)
        if a.Players ~= b.Players then return a.Players < b.Players end
        return a.Idx > b.Idx
    end)

    for i = 1, math.min(#cands, 2) do
        if Stopped() or (doneCheckFn and doneCheckFn()) then return false end
        local chosen = cands[i]
