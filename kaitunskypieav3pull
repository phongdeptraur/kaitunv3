local function SetupSilentAimHooks()
    if getgenv()._AutoSkypieaAimHooked then return end
    if not (hookmetamethod and getnamecallmethod and checkcaller) then return end
    getgenv()._AutoSkypieaAimHooked = true

    local localMouse = LocalPlayer:GetMouse()
    local wrap = newcclosure or function(f) return f end
    local oldIndex, oldNamecall
    local inIndex, inNamecall = false, false

    pcall(function()
        oldIndex = hookmetamethod(game, "__index", wrap(function(self, k)
            if inIndex or getgenv()._AutoSkypieaV3Stop == true then
                return oldIndex(self, k)
            end
            local aimPos = getgenv()._AutoSkypieaAimPos
            if not aimPos then
                return oldIndex(self, k)
            end
            if k ~= "Hit" and k ~= "Target" and k ~= "Origin" and k ~= "UnitRay" then
                return oldIndex(self, k)
            end
            if not rawequal(self, localMouse) or checkcaller() then
                return oldIndex(self, k)
            end

            inIndex = true
            local orig = getgenv()._AutoSkypieaAimCamPos or aimPos
            local dir = aimPos - orig
            local res
            if k == "Hit" then
                res = CFrame.new(aimPos)
            elseif k == "Target" then
                res = getgenv()._AutoSkypieaAimHRP
            elseif k == "Origin" then
                res = (dir.Magnitude > 0.1) and CFrame.lookAt(orig, aimPos) or CFrame.new(aimPos)
            elseif k == "UnitRay" then
                res = Ray.new(orig, (dir.Magnitude > 0.1) and dir.Unit or Vector3.new(0, 0, -1))
            end
            inIndex = false
            return res
        end))
    end)

    pcall(function()
        oldNamecall = hookmetamethod(game, "__namecall", wrap(function(self, ...)
            if inNamecall or getgenv()._AutoSkypieaV3Stop == true then
                return oldNamecall(self, ...)
            end
            local aimPos = getgenv()._AutoSkypieaAimPos
            if not aimPos or checkcaller() then
                return oldNamecall(self, ...)
            end

            local m = getnamecallmethod()
            if m == "ViewportPointToRay" or m == "ScreenPointToRay" then
                if rawequal(self, getgenv()._AutoSkypieaAimCam) then
                    local orig = getgenv()._AutoSkypieaAimCamPos
                    if orig then
                        local dir = aimPos - orig
                        if dir.Magnitude > 0.1 then
                            return Ray.new(orig, dir.Unit)
                        end
                    end
                end
                return oldNamecall(self, ...)
            end

            if m == "FireServer" or m == "InvokeServer" then
                inNamecall = true
                local isTargetRemote = false
                if oldIndex then
                    local ok, matched = pcall(function()
                        local cn = oldIndex(self, "ClassName")
                        if cn ~= "RemoteEvent" and cn ~= "RemoteFunction" then return false end
                        local nm = oldIndex(self, "Name")
                        if nm == "CommE" then return true end
                        local ch = getgenv()._AutoSkypieaMyChar
                        if ch then
                            local p1 = oldIndex(self, "Parent")
                            if rawequal(p1, ch) then return true end
                            local p2 = p1 and oldIndex(p1, "Parent")
                            if rawequal(p2, ch) then return true end
                        end
                        return false
                    end)
                    isTargetRemote = ok and matched == true
                end
                inNamecall = false

                if isTargetRemote then
                    local args = { ... }
                    if type(args[1]) == "string" and (args[1] == "Dodge" or args[1] == "DoubleJump") then
                        return oldNamecall(self, ...)
                    end
                    local changed = false
                    for i, v in ipairs(args) do
                        if typeof(v) == "Vector3" then
                            args[i] = aimPos
                            changed = true
                        elseif typeof(v) == "CFrame" then
                            args[i] = CFrame.new(aimPos)
                            changed = true
                        end
                    end
                    if changed then
                        return oldNamecall(self, unpack(args))
                    end
                end
            end

            return oldNamecall(self, ...)
        end))
    end)
end

local function IsSkillReady(key)
    local main = LocalPlayer:FindFirstChild("PlayerGui") and LocalPlayer.PlayerGui:FindFirstChild("Main")
    local skills = main and main:FindFirstChild("Skills")
    local box = skills or main
    if not box or (skills and not skills.Visible) then return false end

    local function visibleChain(obj)
        while obj and obj ~= main do
            if obj:IsA("GuiObject") and not obj.Visible then return false end
            obj = obj.Parent
        end
        return true
    end

    local slot = box:FindFirstChild(key, true) or box:FindFirstChild("[" .. key .. "]", true) or box:FindFirstChild(key:lower(), true)
    if not (slot and slot:IsA("GuiObject") and visibleChain(slot)) then
        slot = nil
        for _, d in ipairs(box:GetDescendants()) do
            if (d:IsA("TextLabel") or d:IsA("TextButton")) and visibleChain(d) then
                local c = d.Text:gsub("%s+", ""):upper()
                if (c == "[" .. key .. "]" or c == key) and d.Parent and d.Parent:IsA("GuiObject") then
                    slot = d.Parent; break
                end
            end
        end
    end
    if not slot then return false end

    local titleObj = slot:FindFirstChild("Title") or slot:FindFirstChild("SkillTitle") or slot:FindFirstChild("Name")
    local title = (titleObj and titleObj:IsA("TextLabel") and titleObj.Text) or ""
    if title == "" then
        for _, lbl in ipairs(slot:GetDescendants()) do
            if lbl:IsA("TextLabel") and lbl.Visible and #lbl.Text > 0 then
                local tl = lbl.Text:lower()
                if not (tl:find("%[" .. key:lower() .. "%]") or tl == key:lower() or tl:find("thông thạo") or tl:find("mastery") or tl:find("tối đa") or tl:find("/")) then
                    title = lbl.Text; break
                end
            end
        end
    end
    local tl = title:lower()
    if tl:find("locked") or tl:find("chưa mở") then return false end

    local cd = slot:FindFirstChild("Cooldown") or slot:FindFirstChild("CooldownBar") or slot:FindFirstChild("CD")
    if not cd then
        for _, ch in ipairs(slot:GetChildren()) do
            if (ch:IsA("Frame") or ch:IsA("ImageLabel")) and ch.Name:lower():find("cool") then cd = ch; break end
        end
    end
    if cd and cd:IsA("GuiObject") and cd.Visible and (cd.Size.X.Scale > 0.02 or cd.AbsoluteSize.X > 4) then
        return false
    end
    return true
end

