local function LoadJobCache(file, ttl)
    local cache = {}
    if isfile and readfile and isfile(file) then
        local okR, raw = pcall(readfile, file)
        if okR and type(raw) == "string" then
            local okD, data = pcall(function() return HttpService:JSONDecode(raw) end)
            if okD and type(data) == "table" then
                local now = os.time()
                for jid, ts in pairs(data) do
                    if type(ts) == "number" and (now - ts) < ttl then cache[tostring(jid)] = ts end
                end
            end
        end
    end
    return cache
end

local function RecordJobCache(file, cache, jobId)
    cache[tostring(jobId)] = os.time()
    if writefile then pcall(writefile, file, HttpService:JSONEncode(cache)) end
end

