local function ReadMasterySessionRaw()
    if not (isfile and readfile and isfile(MASTERY_SESSION_FILE)) then return {}, true end
    for _ = 1, 3 do
        local okR, raw = pcall(readfile, MASTERY_SESSION_FILE)
        if okR and type(raw) == "string" then
            if raw:match("^%s*$") then return {}, true end
            local okD, data = pcall(function() return HttpService:JSONDecode(raw) end)
            if okD and type(data) == "table" then return data, true end
        end
        task.wait(0.05)
    end
    return nil, false
end

local function UpdateMasterySession(mutatorFn)
    local data, ok = ReadMasterySessionRaw()
    if not ok or not data then return nil end
    local now = os.time()
    local cleaned = {}
    for uid, entry in pairs(data) do
        if type(entry) == "table" and type(entry.updatedAt) == "number" and (now - entry.updatedAt) <= MASTERY_SESSION_TTL then
            cleaned[tostring(uid)] = entry
        end
    end
    if mutatorFn then
        mutatorFn(cleaned, now)
    end
    if writefile then
        pcall(writefile, MASTERY_SESSION_FILE, HttpService:JSONEncode(cleaned))
    end
    return cleaned
end

RemoveFromMasterySession = function()
    UpdateMasterySession(function(tbl)
        tbl[MY_UID] = nil
    end)
end

local function GetOccupiedMasteryJobs()
    local data, ok = ReadMasterySessionRaw()
    local occupied = {}
    if not ok or not data then return occupied end
    local now = os.time()
    for uid, entry in pairs(data) do
        if tostring(uid) ~= MY_UID and type(entry) == "table" and type(entry.updatedAt) == "number"
            and (now - entry.updatedAt) <= MASTERY_SESSION_TTL and entry.jobId and tostring(entry.jobId) ~= "" then
            occupied[tostring(entry.jobId)] = true
        end
    end
    return occupied
end

local function SyncMasterySession(farmSword)
    local curJobId = tostring(game.JobId)
    local conflictEntry = nil
    local myNumUid = tonumber(MY_UID) or math.huge

    local cleaned = UpdateMasterySession(function(tbl, now)
        local me = tbl[MY_UID]
        local myJoinedAt = (me and tostring(me.jobId) == curJobId and tonumber(me.joinedAt)) or now

        for uid, entry in pairs(tbl) do
            if uid ~= MY_UID and tostring(entry.jobId or "") == curJobId then
                local theirJoinedAt = tonumber(entry.joinedAt) or now
                local theirNumUid = tonumber(uid) or math.huge
                if (theirJoinedAt < myJoinedAt) or (theirJoinedAt == myJoinedAt and theirNumUid < myNumUid) then
                    conflictEntry = entry
                    break
                end
            end
        end

        if conflictEntry then
            tbl[MY_UID] = nil
        else
            tbl[MY_UID] = {
                userId = LocalPlayer.UserId,
                name = LocalPlayer.Name,
                jobId = curJobId,
                placeId = game.PlaceId,
                sea = SEA_PLACES[game.PlaceId] or 0,
                sword = farmSword,
                joinedAt = myJoinedAt,
                updatedAt = now,
            }
        end
    end)

    if not cleaned then
        return false, nil
    end
    return conflictEntry ~= nil, conflictEntry
end

