local function HasActiveSeaBeast()
    local sb = workspace:FindFirstChild("SeaBeasts")
    if not sb then return false end
    for _, v in ipairs(sb:GetChildren()) do
        local hum = v:FindFirstChildOfClass("Humanoid")
        if (hum and hum.Health > 0) or v:FindFirstChild("HumanoidRootPart") then
            return true
        end
    end
    return false
end

local function IsMyBoatModel(boat)
    if not boat or not boat.Parent then return false end
    local owner = boat:FindFirstChild("Owner")
    if owner then
        local v = owner.Value
        if v == LocalPlayer or tostring(v) == LocalPlayer.Name or tonumber(v) == LocalPlayer.UserId then
            return true
        end
    end
    for _, attrName in ipairs({ "Owner", "OwnerId", "UserId" }) do
        local attrVal = boat:GetAttribute(attrName)
        if attrVal ~= nil and (attrVal == LocalPlayer.Name or attrVal == LocalPlayer.UserId or tostring(attrVal) == LocalPlayer.Name) then
            return true
        end
    end
    local seat = boat:FindFirstChildOfClass("VehicleSeat") or boat:FindFirstChild("VehicleSeat", true)
    if seat then
        local sOwner = seat:FindFirstChild("Owner")
        if sOwner and (sOwner.Value == LocalPlayer or tostring(sOwner.Value) == LocalPlayer.Name) then
            return true
        end
        if seat.Occupant and LocalPlayer.Character and seat.Occupant.Parent == LocalPlayer.Character then
            return true
        end
    end
    return false
end

local function TryBuyBoat()
    if Stopped() then return false end
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not (hum and hum.Health > 0) then return false end
    if hum.Sit or HasActiveSeaBeast() then return false end

    local isMarine = LocalPlayer.Team and LocalPlayer.Team.Name == "Marines"
    local boatCandidates = isMarine
        and { "MarineGrandBrigade", "GrandBrigade", "MarineBrigade", "Brigade", "MarineSloop", "Sloop", "Dinghy" }
        or  { "PirateGrandBrigade", "GrandBrigade", "PirateBrigade", "Brigade", "PirateSloop", "Sloop", "Dinghy" }

    local boatsFolder = workspace:FindFirstChild("Boats")
    for _, boatName in ipairs(boatCandidates) do
        if Stopped() then return false end
        local beforeBoats = {}
        if boatsFolder then
            for _, b in ipairs(boatsFolder:GetChildren()) do
                beforeBoats[b] = true
            end
        end

        SetStatus("Đang mua thuyền tại bến: " .. boatName .. "...")
        local ok, res = pcall(function() return CommF:InvokeServer("BuyBoat", boatName) end)
        local maxWait = (ok and (res == false or type(res) == "string")) and 0.2 or 0.6
        local spawned = false
        local t0 = os.clock()
        while not Stopped() and (os.clock() - t0) < maxWait do
            if not boatsFolder then boatsFolder = workspace:FindFirstChild("Boats") end
            if boatsFolder then
                for _, b in ipairs(boatsFolder:GetChildren()) do
                    if not beforeBoats[b] and (IsMyBoatModel(b) or b.Name == boatName) then
                        spawned = true
                        break
                    end
                end
            end
            if spawned then break end
            task.wait(0.1)
        end

        if spawned or (ok and (res == 1 or res == true)) then
            SetStatus("Đã mua thuyền thành công: " .. boatName)
            return true
        end
    end

    SetStatus("Chưa mua được thuyền -> Sẽ thử lại sau 5s nếu vẫn đứng ở bến!")
    return false
end

