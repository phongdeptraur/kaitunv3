local function FindToolByExactName(exactName)
    local containers = { LocalPlayer.Character, LocalPlayer:FindFirstChild("Backpack") }
    for _, c in ipairs(containers) do
        local t = c and c:FindFirstChild(exactName)
        if t and t:IsA("Tool") then return t end
    end
    return nil
end

local function InspectSwords()
    local info = {
        Tushita = { owned = false, mastery = 0 },
        Yama    = { owned = false, mastery = 0 },
    }

    for _, name in ipairs({ "Tushita", "Yama" }) do
        local t = FindToolByExactName(name)
        if t then
            info[name].owned = true
            info[name].mastery = GetToolMastery(t)
        end
    end

    local ok, inv = pcall(function() return CommF:InvokeServer("getInventory") end)
    if ok and type(inv) == "table" then
        for _, v in pairs(inv) do
            local n = tostring(v.Name or "")
            if info[n] then
                info[n].owned = true
                local m = tonumber(v.Mastery or v.Level) or 0
                if m > info[n].mastery then
                    info[n].mastery = m
                end
            end
        end
    end

    -- Ưu tiên kiếm đã đạt >= 300 Mastery (ưu tiên Tushita trước Yama)
    local readySword = nil
    if info.Tushita.owned and info.Tushita.mastery >= SWORD_MASTERY_REQ then
        readySword = "Tushita"
    elseif info.Yama.owned and info.Yama.mastery >= SWORD_MASTERY_REQ then
        readySword = "Yama"
    end

    -- Nếu chưa kiếm nào đạt 300 Mastery: ưu tiên chọn Tushita để farm, không có Tushita mới chọn Yama
    local farmSword = nil
    if not readySword then
        if info.Tushita.owned then
            farmSword = "Tushita"
        elseif info.Yama.owned then
            farmSword = "Yama"
        end
    end

    return readySword, farmSword, info
end

local function EnsureSwordLoaded(swordName)
    if not swordName or Stopped() then return false end
    if not FindToolByExactName(swordName) then
        pcall(function() CommF:InvokeServer("LoadItem", swordName) end)
        SleepCheck(0.5)
    end
    return FindToolByExactName(swordName) ~= nil
end

local function FindGunTool()
    local containers = { LocalPlayer:FindFirstChild("Backpack"), LocalPlayer.Character }
    for _, c in ipairs(containers) do
        if c then
            for _, t in ipairs(c:GetChildren()) do
                if t:IsA("Tool") and t.ToolTip == "Gun" then
                    return t
                end
            end
        end
    end
    return nil
end

local function EnsureNoGunInBackpack()
    local gun = FindGunTool()
    if not gun then return true end

    SetStatus(("Phát hiện Gun (%s) trong Backpack -> Đang StoreItem..."):format(gun.Name))
    for _ = 1, 15 do
        if Stopped() then return false end
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum and gun.Parent == char then
            pcall(function() hum:UnequipTools() end)
            SleepCheck(0.2)
        end
        pcall(function() CommF:InvokeServer("StoreItem", gun.Name) end)
        SleepCheck(1.2)
        gun = FindGunTool()
        if not gun then
            SetStatus("Đã StoreItem Gun khỏi Backpack!")
            return true
        end
    end
    return FindGunTool() == nil
end

