local function GetNearestOtherPlayerDist(myPos)
    local minDist = math.huge
    local nearestPlayer = nil
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Parent then
            local ch = p.Character
            local hum = ch and ch:FindFirstChildOfClass("Humanoid")
            local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
            if hum and hrp and hum.Health > 0 then
                local d = (hrp.Position - myPos).Magnitude
                if d < minDist then
                    minDist = d
                    nearestPlayer = p
                end
            end
        end
    end
    return nearestPlayer, minDist
end

local function FarmSwordMasterySea3(farmSword)
    if Stopped() then return end
    if GetSea() ~= 3 then TravelToSea(3) end
    if Stopped() then return end

    local conflict, occupant = SyncMasterySession(farmSword)
    if conflict then
        SetStatus(("Server đang có acc %s farm Mastery -> Hop Low né server chiếm!"):format(tostring(occupant and occupant.name or "?")))
        HopLow()
        return
    end

    EnsureSwordLoaded(farmSword)
    EnsureSwordStats2800()
    if Stopped() then return end

    if LaunchRealKidMain({
        weapon_choice = "Sword",
        auto_farm_general = true,
    }, ("Farm %s 300 Mastery (Sea 3)"):format(farmSword)) then
        local nearbyAccum = 0
        local lastTick = os.clock()
        local lastSessionSync = 0

        while not Stopped() and task.wait(1) do
            local nowClock = os.clock()
            local dt = nowClock - lastTick
            lastTick = nowClock

            if (nowClock - lastSessionSync) >= 2 then
                lastSessionSync = nowClock
                local c2, occ2 = SyncMasterySession(farmSword)
                if c2 then
                    SetStatus(("Phát hiện acc %s chung server farm Mastery -> Hop Low!"):format(tostring(occ2 and occ2.name or "?")))
                    HopLow()
                    return
                end
            end

            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if hum and hum.Health > 0 and hrp then
                local nearP, nearDist = GetNearestOtherPlayerDist(hrp.Position)
                if nearP and nearDist <= MASTERY_NEARBY_RADIUS then
                    nearbyAccum = nearbyAccum + dt
                    if nearbyAccum >= MASTERY_NEARBY_LIMIT then
                        RemoveFromMasterySession()
                        SetStatus(("Có người (%s, %.0f stud) ở gần tích lũy %.0fs -> Hop Low!"):format(nearP.DisplayName, nearDist, nearbyAccum))
                        HopLow()
                        return
                    end
                end
            end

            local tool = FindToolByExactName(farmSword)
            if not tool then
                if hum and hum.Health > 0 then
                    pcall(function() CommF:InvokeServer("LoadItem", farmSword) end)
                end
                SetStatus(("Đang LoadItem %s (300M) | Gần người: %.0f/%ds"):format(farmSword, nearbyAccum, MASTERY_NEARBY_LIMIT))
            else
                local m = GetToolMastery(tool)
                SetStatus(("Farm %s Mastery: %d/%d | Gần người: %.0f/%ds"):format(farmSword, m, SWORD_MASTERY_REQ, nearbyAccum, MASTERY_NEARBY_LIMIT))
                if m >= SWORD_MASTERY_REQ then
                    RemoveFromMasterySession()
                    SetStatus(("Đã đạt %s %d/%d Mastery! Hop Low để refresh..."):format(farmSword, m, SWORD_MASTERY_REQ))
                    HopLow()
                    return
                end
            end
        end
    end
end

