local function RunSea3BossTarget(destination, preTweenPos, waitMsgFn, doneCheckFn)
    if Stopped() then return end
    if GetSea() ~= 3 then TravelToSea(3) end
    if Stopped() then return end

    if TweenTo(preTweenPos) and LaunchRealKidHop(destination) then
        local aliases = NH_BOSS_ALIASES[destination]
        local launchTick = os.clock()
        local lastNhCheck = 0
        local wasBossAlive = false
        local bossDiedTick = 0

        while not Stopped() and task.wait(1.5) do
            SetStatus(waitMsgFn())
            if doneCheckFn() then return end

            local bossAlive = aliases and (FindBossAlive(aliases) ~= nil) or false
            if bossAlive then
                wasBossAlive = true
                bossDiedTick = 0
            else
                if wasBossAlive and bossDiedTick == 0 then
                    bossDiedTick = os.clock()
                end
                local passedLaunch = (os.clock() - launchTick) >= 3
                local passedDropWait = (not wasBossAlive) or ((os.clock() - bossDiedTick) >= 5)
                if passedLaunch and passedDropWait and (os.clock() - lastNhCheck) >= 6 then
                    lastNhCheck = os.clock()
                    TryNightHubHop(destination, doneCheckFn)
                end
            end
        end
    end
end

