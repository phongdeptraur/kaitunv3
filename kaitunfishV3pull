local function CheckInvItems()
    local hasHelm, hasMirror = false, false
    local usedReplication, done = false, false

    task.spawn(function()
        pcall(function()
            local irMod = ReplicatedStorage:WaitForChild("ItemReplicationService", 8)
            local keysMod = irMod and irMod:WaitForChild("KEYS", 8)
            local econ = ReplicatedStorage:WaitForChild("Economy", 8)
            local itemIdMod = econ and econ:WaitForChild("ItemId", 8)
            if not (irMod and keysMod and itemIdMod) then return end

            local okR, ItemReplication = pcall(require, irMod)
            local okK, KEYS = pcall(require, keysMod)
            local okI, ItemId = pcall(require, itemIdMod)
            if not (okR and okK and okI and ItemReplication and KEYS and ItemId) then return end

            local t0 = os.clock()
            while not Stopped() and not ItemReplication.IsInitialized and (os.clock() - t0) < 20 do
                task.wait(0.5)
            end
            if Stopped() or not ItemReplication.IsInitialized then return end

            for _, item in pairs(ItemReplication:GetItems(KEYS.QUANTITY)) do
                if (item.Value or 0) > 0 then
                    local okD, d = pcall(function() return ItemId.getDataFromId(item.ItemId):unwrap() end)
                    if okD and d then
                        local k = (tostring(d.StorageKey or "") .. " " .. tostring(d.DisplayName or d.Name or "")):lower()
                        if k:find("valkyrie") then hasHelm = true end
                        if k:find("mirror") and k:find("fractal") then hasMirror = true end
                    end
                end
            end
            usedReplication = true
        end)
        done = true
    end)

    while not done and not Stopped() do task.wait(0.05) end
    if Stopped() then return false, false end

    if not usedReplication then
        local okG, inv = pcall(function() return CommF:InvokeServer("getInventory") end)
        if okG and type(inv) == "table" then
            for _, v in pairs(inv) do
                local n = tostring(v.Name or ""):lower()
                if n:find("valkyrie") then hasHelm = true end
                if n:find("mirror") and n:find("fractal") then hasMirror = true end
            end
        end
    end
    return hasHelm, hasMirror
end

