                if GetBeli() >= reqBeli then
                    SetStatus("Đã đủ Beli! Hop Low để refresh...")
                    HopLow()
                    return
                end
            end
        end
        return
    end

    if GetFragments() < reqFrag then
        RunSea3BossTarget(
            DESTINATIONS.CAKE_PRINCE,
            POS_CAKE_LOAF,
            function() return ("Đang farm Fragment (Cake Prince): %d / %d"):format(GetFragments(), reqFrag) end,
            function()
                if GetFragments() >= reqFrag then
                    SetStatus(("Đã đủ %d Fragment! Hop Low để refresh..."):format(reqFrag))
                    HopLow()
                    return true
                end
                return false
            end
        )
        return
    end

    -- 2A. CHƯA CÓ FISHMAN V2 -> TP SEA 2 CHẠY REALKID MAIN ĐỂ UP V2
    if not hasV2 then
        if GetSea() ~= 2 then TravelToSea(2) end
        if Stopped() then return end

        if not HasBlueFlower() and not IsNight() then
            SetStatus(("Đang up Fishman V2 nhưng trời sáng (Clock: %.1f) -> Hop Low tìm trời tối..."):format(Lighting.ClockTime))
            HopLow()
            return
        end

        if LaunchRealKidMain({ AutoUpgradeRaceV3 = true }, "Auto Fishman V2 (Sea 2)") then
            while not Stopped() and task.wait(2) do
                if HasRaceV2() then
                    SetStatus("Đã xong Fishman V2! Hop Low để refresh trước khi chuẩn bị V3...")
                    HopLow()
                    return
                end
                if not HasBlueFlower() and not IsNight() then
                    SetStatus(("Đang up Fishman V2 mà trời chuyển sáng (Clock: %.1f) -> Hop Low tìm trời tối..."):format(Lighting.ClockTime))
                    HopLow()
                    return
                end
                SetStatus(("Đang làm Fishman V2 ở Sea 2 (Clock: %.1f)..."):format(Lighting.ClockTime))
            end
        end
        return
    end

    -- 2B. ĐÃ XONG FISHMAN V2 -> FARM/CHECK TUSHITA/YAMA 300M + SHARKMAN + STORE GUN -> UP FISHMAN V3
    RunFishmanV3Phase()
    return
end
if Stopped() then return end

RemoveFromMasterySession()

