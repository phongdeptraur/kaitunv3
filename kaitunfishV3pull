-- CHẾ ĐỘ FISHMAN V3 CHÍNH (TUSHITA/YAMA 300M + SHARKMAN + STORE GUN + DOCK BUY BOAT)
-- ============================================================================
local function RunFishmanV3Phase()
    if Stopped() then return end

    -- 1. Kiểm tra Tushita / Yama >= 300 Mastery (ưu tiên Tushita; nếu chưa đủ 300 thì về Sea 3 farm)
    local readySword, farmSword = InspectSwords()
    while not Stopped() and not readySword and not farmSword do
        RemoveFromMasterySession()
        SetStatus("Không tìm thấy Tushita hoặc Yama trong túi đồ! Đang kiểm tra lại...")
        if not SleepCheck(3) then return end
        readySword, farmSword = InspectSwords()
    end
    if Stopped() then return end

    if not readySword then
        FarmSwordMasterySea3(farmSword)
        return
    end

    RemoveFromMasterySession()

    -- 2. Kiểm tra Sharkman Karate trong người; nếu chưa có thì chạy RealKid auto_buy_style
    if not TryEquipSharkmanKarate() then
        local reqStyleBeli = FindToolByExactName("Water Kung Fu") and 2500000 or 3250000
        if GetBeli() < reqStyleBeli then
            if GetSea() ~= 3 then TravelToSea(3) end
            if not Stopped() and LaunchRealKidMain({ Chest = true }, ("Farm Chest mua Sharkman Karate (%d/%d)"):format(GetBeli(), reqStyleBeli)) then
                while not Stopped() and task.wait(1.5) do
                    SetStatus(("Đang farm Beli mua Sharkman Karate: %d / %d"):format(GetBeli(), reqStyleBeli))
                    if GetBeli() >= reqStyleBeli then
                        SetStatus("Đã đủ Beli mua Sharkman Karate! Hop Low để refresh...")
                        HopLow()
                        return
                    end
                end
            end
            return
        end

        if GetSea() ~= 2 then TravelToSea(2) end
        if Stopped() then return end

        if LaunchRealKidMain({
            auto_buy_style = true,
            selected_fighting_style = "Sharkman Karate",
        }, "Auto Buy Sharkman Karate") then
            while not Stopped() and task.wait(2) do
                SetStatus("Chưa có Sharkman Karate -> Đang chạy RealKid lấy Sharkman Karate...")
                if HasSharkmanKarate() then
                    SetStatus("Đã có Sharkman Karate! Hop Low để refresh trước khi up Fishman V3...")
                    HopLow()
                    return
                end
            end
        end
        return
    end

    -- 3. Đã đủ (>= 300 Mastery 1 kiếm + Sharkman Karate) -> Đảm bảo đủ 2,000,000 Beli cho Fishman V3
    if GetBeli() < 2000000 then
        if GetSea() ~= 3 then TravelToSea(3) end
        if not Stopped() and LaunchRealKidMain({ Chest = true }, ("Farm Chest lấy Beli up Fishman V3 (%d/2000000)"):format(GetBeli())) then
            while not Stopped() and task.wait(1.5) do
                SetStatus(("Đang farm Beli up Fishman V3: %d / 2000000"):format(GetBeli()))
                if GetBeli() >= 2000000 then
                    SetStatus("Đã đủ 2M Beli! Hop Low để refresh...")
                    HopLow()
                    return
                end
            end
        end
        return
    end

    -- 4. Về Sea 2, check Wenlocktoad, LoadItem kiếm (>= 300M), cộng 2800 Sword & StoreItem Gun khỏi Backpack
    if GetSea() ~= 2 then TravelToSea(2) end
    if Stopped() then return end
    EnsureTeam("Marines")
    if Stopped() then return end

    local okInit, initStat = pcall(function() return CommF:InvokeServer("Wenlocktoad", "1") end)
    if HasRaceV3() or (okInit and initStat == -2) then
        ConfirmedHasV3 = true
        SetStatus("Đã xong Fishman V3! Đang TP sang Sea 3...")
        TravelToSea(3)
        return
    end

    EnsureSwordLoaded(readySword)
    EnsureSwordStats2800()
    if Stopped() then return end

    if not EnsureNoGunInBackpack() then
        SetStatus("Không thể StoreItem Gun khỏi Backpack -> Hop Low để refresh!")
        HopLow()
        return
    end

    -- 5. Chạy RealKid AutoUpgradeRaceV3 + Theo dõi bến (-14.60, 10.59, 2953.76) trong 100 stud: 2s mua -> đứng 5s mua lại
    if LaunchRealKidMain({ AutoUpgradeRaceV3 = true }, "Auto Fishman V3 (Sea 2)") then
        local lastWenlockCheck = 0
        local dockEnterTick = 0
        local hasBoughtAtDock = false
        local lastDockBuyTick = 0

        while not Stopped() and task.wait(0.5) do
            if HasRaceV3() then
                ConfirmedHasV3 = true
                SetStatus("Đã hoàn thành Fishman V3! Hop Low để refresh và qua Sea 3...")
                HopLow()
                return
            end

            if (os.clock() - lastWenlockCheck) >= 6 then
                lastWenlockCheck = os.clock()
                local okW, rs = pcall(function() return CommF:InvokeServer("Wenlocktoad", "1") end)
                if okW then
                    if rs == -2 then
                        ConfirmedHasV3 = true
                        SetStatus("Đã hoàn thành Fishman V3! Hop Low để refresh và qua Sea 3...")
                        HopLow()
                        return
                    elseif rs == 2 then
                        SetStatus("Đủ điều kiện Fishman V3 -> Trả nhiệm vụ (Wenlocktoad 3)...")
                        pcall(function() CommF:InvokeServer("Wenlocktoad", "3") end)
                        SleepCheck(0.6)
                        if HasRaceV3() then
                            ConfirmedHasV3 = true
                            SetStatus("Đã hoàn thành Fishman V3! Hop Low để refresh và qua Sea 3...")
                            HopLow()
                            return
                        end
                    end
                end
            end

            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local sitting = hum and hum.Sit == true
            local alive = hum and hum.Health > 0 and hrp ~= nil

            if alive and not sitting and not HasActiveSeaBeast() then
                local distDock = (hrp.Position - BOAT_DOCK_POS).Magnitude
                if distDock <= BOAT_DOCK_RADIUS then
                    local now = os.clock()
                    if not hasBoughtAtDock then
                        if dockEnterTick == 0 then
                            dockEnterTick = now
                        end
                        local elapsed = now - dockEnterTick
                        if elapsed >= BOAT_DOCK_INITIAL_WAIT then
                            TryBuyBoat()
                            hasBoughtAtDock = true
                            lastDockBuyTick = os.clock()
                        else
                            SetStatus(("Ở gần bến thuyền (%.0f stud) -> Mua sau %.1fs..."):format(distDock, BOAT_DOCK_INITIAL_WAIT - elapsed))
                        end
                    else
                        local elapsedRetry = now - lastDockBuyTick
                        if elapsedRetry >= BOAT_DOCK_RETRY_WAIT then
                            TryBuyBoat()
                            lastDockBuyTick = os.clock()
                        else
                            SetStatus(("Vẫn đứng ở bến (%.0f stud) | Mua lại sau %.1fs..."):format(distDock, BOAT_DOCK_RETRY_WAIT - elapsedRetry))
                        end
                    end
                else
                    dockEnterTick = 0
                    hasBoughtAtDock = false
                    lastDockBuyTick = 0
                    SetStatus(("Đang làm Fishman V3 (%s + Sharkman) | Cách bến: %.0f stud"):format(readySword, distDock))
                end
            else
                dockEnterTick = 0
                hasBoughtAtDock = false
                lastDockBuyTick = 0
                SetStatus(("Đang làm Fishman V3 (%s + Sharkman)..."):format(readySword))
            end
        end
    end
end

