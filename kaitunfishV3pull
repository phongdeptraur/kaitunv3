local NH_BASE_URL = "http://163.223.9.144/boss"
local NH_PREFIX   = "NIGHTHUB|"
local NH_KEY_HEX  = "8992d555ed7846a562b058523100fbd0e59b5f6f28e98003230ffb4d9db60411"
local NH_VISITED_FILE = "Axiom_VisitedServers.json"
