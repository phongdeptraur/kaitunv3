local RERegisterAttack = ReplicatedStorage.Modules.Net:WaitForChild("RE/RegisterAttack")
local RegisterHit      = require(ReplicatedStorage.Modules.Net):RemoteEvent("RegisterHit", true)
local CombatUtil       = require(ReplicatedStorage.Modules.CombatUtil)

local function EquipWeaponByType(tooltip)
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Sit then return end

    for _, tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") and tool.ToolTip == tooltip then return tool.Name end
    end
    for _, tool in ipairs(LocalPlayer.Backpack:GetChildren()) do
        if tool:IsA("Tool") and tool.ToolTip == tooltip then
            hum:EquipTool(tool)
            return tool.Name
        end
    end
end

local function AttackNearbyMobs(range)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local stun = char and char:FindFirstChild("Stun")
    if not hrp or (stun and stun.Value ~= 0) then return end

    local hitPairs = {}
    local firstPart = nil
    for _, enemy in ipairs(workspace.Enemies:GetChildren()) do
        local eHrp = enemy:FindFirstChild("HumanoidRootPart")
        local eHum = enemy:FindFirstChildOfClass("Humanoid")
        if eHrp and eHum and eHum.Health > 0 and (eHrp.Position - hrp.Position).Magnitude <= (range or 65) then
            if CombatUtil:IsVulnerable(enemy) then
                local head = enemy:FindFirstChild("Head") or eHrp
                if not firstPart then firstPart = head end
                table.insert(hitPairs, { enemy, head })
            end
        end
    end

    if firstPart and #hitPairs > 0 then
        RERegisterAttack:FireServer(0)
        RegisterHit:FireServer(firstPart, hitPairs)
    end
end

local function CastAllSkills()
    local skillKeys = { Enum.KeyCode.Z, Enum.KeyCode.X, Enum.KeyCode.C, Enum.KeyCode.V }
    for _, toolType in ipairs({ "Melee", "Blox Fruit", "Sword" }) do
        local name = EquipWeaponByType(toolType)
        if name then
            for _, key in ipairs(skillKeys) do
                if ShouldStop() or not IsTrialActive() then return end
                VirtualInputMgr:SendKeyEvent(true, key, false, game)
                task.wait(0.08)
                VirtualInputMgr:SendKeyEvent(false, key, false, game)
                task.wait(0.15)
            end
        end
    end
end

