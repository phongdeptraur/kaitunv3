-- 3. VẬT LÝ DI CHUYỂN (NOCLIP + CHỐNG RƠI + TWEEN)
-- ============================================================================
local function SetNoclip(state)
    noclipEnabled = state
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if state then
        workspace.Gravity = 0
        if hrp then
            hrp.AssemblyLinearVelocity = Vector3.zero
            if not hrp:FindFirstChild("V4Float") then
                local bv = Instance.new("BodyVelocity")
                bv.Name = "V4Float"
                bv.Velocity = Vector3.zero
                bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
                bv.Parent = hrp
            end
        end
    else
        workspace.Gravity = defaultGravity
        if hrp and hrp:FindFirstChild("V4Float") then
            hrp.V4Float:Destroy()
        end
    end
end

local steppedConn = RunService.Stepped:Connect(function()
    if not isRunning or not noclipEnabled then return end
    workspace.Gravity = 0
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.AssemblyLinearVelocity = Vector3.zero
    end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") and part.CanCollide then
            part.CanCollide = false
        end
    end
end)

local function StopTween()
    if activeTween then
        pcall(function() activeTween:Cancel() end)
        activeTween = nil
    end
    SetNoclip(false)
end

local function TweenTo(targetCF, customSpeed, cancelCond)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not (hrp and hum and hum.Health > 0) then return false end

    if hum.Sit then
        hum.Sit = false
        hum.Jump = true
        task.wait(0.2)
    end

    local dist = (hrp.Position - targetCF.Position).Magnitude
    if dist <= 6 then
        hrp.CFrame = targetCF
        SetNoclip(false)
        return true
    end

    StopTween()
    SetNoclip(true)

    local speed = math.min(customSpeed or GetCfg().TweenSpeed or 190, 200)
    local duration = dist / speed
    local tw = TweenService:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), { CFrame = targetCF })
    activeTween = tw
    tw:Play()

    while tw.PlaybackState == Enum.PlaybackState.Playing do
        if not isRunning or getgenv().V4Stop or not GetCfg().Enabled or (cancelCond and cancelCond()) then
            StopTween()
            return false
        end
        local c = LocalPlayer.Character
        local h = c and c:FindFirstChildOfClass("Humanoid")
        if not (c and h and h.Health > 0) then
            StopTween()
            return false
        end
        task.wait(0.05)
    end

    StopTween()
    return (hrp.Position - targetCF.Position).Magnitude <= 15
end

