-- Resolve and propagate master RealKid key to global executor environment
local function ResolveRealKidKey()
    local cfgKey = type(CFG) == "table" and CFG.RealKidKey
    if type(cfgKey) == "string" and cfgKey ~= "" then
        return cfgKey
    end
    if type(getgenv) == "function" then
        local env = getgenv()
        if type(env.Key) == "string" and env.Key ~= "" then
            return env.Key
        end
        if type(env.RealKidKey) == "string" and env.RealKidKey ~= "" then
            return env.RealKidKey
        end
    end
    return nil
end

local function ApplyRealKidKey()
    local key = ResolveRealKidKey()
    if key and type(getgenv) == "function" then
        local env = getgenv()
        env.Key = key
        env.RealKidKey = key
    end
    return key
end

