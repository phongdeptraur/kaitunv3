-- 19. MAIN ORCHESTRATOR DECISION ENGINE
-- ========================================================================================
local function TickOrchestrator()
    if isHopping or not isBootCompleted then return end

    local targetIndex, targetRace = GetCurrentTargetRace()
    if not targetIndex then
        ST.rdy = false
        ST.m   = 0
        ST.me  = 0
        ReleaseTrainLock()
        if CFG.OneRaceMode then
            ST.tr = tostring(CFG.TargetOneRace or ""):lower()
            getgenv().V4Hub = nil
            ST.ph = "one_race_done"
            SafeWriteJson(STATUS_FILE, ST)
            MoveToGreatTree()
            return
        end
        ST.ph = "all_done"
        SafeWriteJson(STATUS_FILE, ST)
        getgenv().V4Stop = true
        DebugLog("MAIN", "All 6 races awakened! Orchestrator terminating cleanly.")
        return
    end
    ST.tr = targetRace
    CheckRaceCompletion(targetIndex, targetRace)

    local hum = GetHumanoid()
    if not (hum and hum.Health > 0 and GetRoot() and LocalPlayer:FindFirstChild("Backpack")) then
        return
    end

    -- Tự động mua Gear & cộng điểm Gear nếu đủ điều kiện trong Sea 3
    AutoUpgradeAndSpendGear()

    local moonState, moonEndMinutes = CheckMoon()
    ST.m  = moonState
    ST.me = moonEndMinutes

    local isCurrentlyTrained, hasValidTrainResult = CheckTrained()
    if InSea3() and not hasValidTrainResult then
        ST.ph  = "check_train"
        ST.rdy = false
        SafeWriteJson(STATUS_FILE, ST)
        return
    end
    ST.tn = isCurrentlyTrained

    -- Kiểm tra Clone hiện tại đã hoàn thành FG race chưa (tùy chọn dừng ở Tier 5 cần train hoặc farm lên Tier 10)
    local cloneDoneFile = PROGRESS_DIR .. "/c_" .. targetRace .. "_" .. PlayerName .. ".txt"
    if InSea3() and CLONES_MAP[PlayerName] and not isfile(cloneDoneFile) and GetCurrentRace() == targetRace then
        local liveTier = ExtractLiveV4Tier()
        local isTierCompleted = CFG.FarmTier10
            and (liveTier >= 10)
            or (liveTier >= 6 or (liveTier == 5 and not ST.tn))
        if isTierCompleted then
            writefile(cloneDoneFile, os.date())
            DebugLog("MAIN", "Clone %s completed race %s (Tier: %d)!", PlayerName, targetRace, liveTier)
        end
    end
    ST.dn = CLONES_MAP[PlayerName] and isfile(cloneDoneFile) or false

    local requiredRace = SUPPORTS_MAP[PlayerName] or targetRace
    local requiredFrag = GetRequiredFragments(targetRace)
    local isFragDeficient = (GetFragments() < requiredFrag)
    local isRaceReady = IsAccountReady(requiredRace)
    ST.sr = isRaceReady and not isFragDeficient

    -- Clone đã xong Race -> Đứng nghỉ tại Great Tree
    if ST.dn and (CFG.OneRaceMode or not isFragDeficient) then
        getgenv().V4Hub = nil
        ST.rdy = false
        ReleaseTrainLock()
        SafeWriteJson(STATUS_FILE, ST)
        if not InSea3() then
            return TravelToSea3()
        end
        return MoveToGreatTree()
    end

    -- Chưa có V3 hoặc chưa Pull lever -> Chạy script V3 Pull
    if not isRaceReady then
        ST.ph  = "v3"
        ST.rdy = false
        ReleaseTrainLock()
        SafeWriteJson(STATUS_FILE, ST)
        if getgenv().V4Hub and getgenv().V4Hub ~= "v3" then
            getgenv().V4Hub = nil
        end
        RunHub("v3", function() LoadExternalScript(V3_BASE_URL .. V3_SCRIPTS[requiredRace]) end)
        return
    end

    -- Giờ X:00 -> X:09: CHỈ acc đã train xong (ST.tn == true) và đủ Fragment mới chạy auto V3 pull
    local DEADTIME_V3_RACES = { cyborg = true, ghoul = true, skypiea = true }
    if CLONES_MAP[PlayerName] and not ST.dn and ST.tn and not isFragDeficient and IsMoonDeadTimeWindow() and DEADTIME_V3_RACES[targetRace] then
        if not GetAccTrialRoomName(PlayerName) and not IsInPvPArena() then
            ST.ph  = "deadtime_v3"
            ST.rdy = false
            ReleaseTrainLock()
            SafeWriteJson(STATUS_FILE, ST)
            if getgenv().V4Hub and getgenv().V4Hub ~= "v3" then
                getgenv().V4Hub = nil
            end
            RunHub("v3", function() LoadExternalScript(V3_BASE_URL .. V3_SCRIPTS[targetRace]) end)
            return
        end
    end

    -- Đổi trạng thái Train <-> Trial thì hop server mới
    if InSea3() and CheckStateTransition(isCurrentlyTrained) then
        return
    end

    -- Chống 3 Support trong 1 server
    if SUPPORTS_MAP[PlayerName] then
        local othersCheck = GetOthersStatus(25)
        local _, _, _, _, cleanSupsCheck = CoordinateMoonServer(othersCheck, targetRace)
        local has3Sups, amExtraSup = CheckThreeSupportsInCurrentServer(othersCheck, targetRace, cleanSupsCheck)
        if has3Sups and amExtraSup then
            ST.ph = "leave_3sp"
            DebugWarn("ANTI-3SP", "3 Supports detected in server! Leaving immediately...")
            return HopLowServer(false, true)
        end
    end

    -- Nếu đang ở Sea 2 (đã xong V3) -> Farm Frag nếu thiếu hoặc bay về Sea 3
    if not InSea3() then
        ST.rdy = false
        ReleaseTrainLock()
        SafeWriteJson(STATUS_FILE, ST)

        if isFragDeficient then
            ST.ph = "frag"
            local activeHub = getgenv().V4Hub
            if activeHub and activeHub ~= "frag" then return HopLowServer(false) end
            RunHub("frag", function() LoadExternalScript(V3_BASE_URL .. "autofarmfragment") end)
            return
        end

        return TravelToSea3()
    end

    -- Thiếu Fragment hoặc cần Train năng lượng tộc -> Chạy hub farm
    local pendingRequirement = isFragDeficient and "frag" or (not ST.tn) and "train" or nil
    if pendingRequirement then
        ST.ph  = pendingRequirement
        ST.rdy = false
        SafeWriteJson(STATUS_FILE, ST)

        local others = GetOthersStatus(25)
        local _, _, _, _, cleanSups = CoordinateMoonServer(others, targetRace)
        currentActiveHelpers = (#cleanSups == 2) and cleanSups or {}

        if pendingRequirement == "train" then
            if not ClaimTrainLock() then
                return HopLowServer(false)
            end
        else
            ReleaseTrainLock()
        end

        local activeHub = getgenv().V4Hub
        if activeHub and activeHub ~= pendingRequirement then
            return HopLowServer(false)
        end

        if pendingRequirement == "frag" then
            RunHub("frag", function() LoadExternalScript(V3_BASE_URL .. "autofarmfragment") end)
        elseif pendingRequirement == "train" then
            RunHub("train", RunTrain)
        end
        return
    end

    -- Đã đủ mọi điều kiện -> Sẵn sàng đi Trial V4!
    ReleaseTrainLock()
    ST.rdy = true
    SafeWriteJson(STATUS_FILE, ST)

    local others = GetOthersStatus(25)
    local targetJob, isRegisteredSup, clonesCanJoin, _, cleanSups, backupJob, totalMoons, backupHolder = CoordinateMoonServer(others, targetRace)
    currentActiveHelpers = (#cleanSups == 2) and cleanSups or {}

    if getgenv().V4Hub and getgenv().V4Hub ~= "gear" then
        return HopLowServer(false)
    end

    -- ====================================================================================
    -- LUỒNG SUPPORT (VÀO TEMPLE KHI CÓ FULL MOON + ÍT NHẤT 1 CLONE & 2 SUPPORT)
    -- ====================================================================================
    if SUPPORTS_MAP[PlayerName] then
        local has3Sups, amExtraSup = CheckThreeSupportsInCurrentServer(others, targetRace, cleanSups)
        if has3Sups and amExtraSup then
            ST.ph = "leave_3sp"
            return HopLowServer(false, true)
        end

        if SUPPORTS_MAP[PlayerName] == targetRace then
            getgenv().V4Hub = nil
            MoveToGreatTree()
            ST.ph = "sp_extra"
            return
        end

        if backupJob and game.JobId == backupJob and ST.m > 0 and not isRegisteredSup then
            getgenv().V4Hub = nil
            MoveToGreatTree()
            ST.ph = "hold_backup"
            return
        end

        if ST.m > 0 and not moonRejectedShortMoon then
            local presentSups = {}
            for _, sInfo in ipairs(CFG.Supports) do
                local sName, sRace = sInfo[1], sInfo[2]
                if IsSupportPresentAndValid(sName, sRace, targetRace, others[sName]) then
                    table.insert(presentSups, sName)
                end
            end

            local presentClones = {}
            for _, cName in ipairs(CFG.Clones) do
                if Players:FindFirstChild(cName) and not (others[cName] and others[cName].dn) then
                    table.insert(presentClones, cName)
                end
            end

            if (#presentSups == 2) and (#presentClones >= 1) and ST.m == 2 and table.find(presentSups, PlayerName) then
                getgenv().V4Hub = "gear"
                local prioClone = GetPriorityTreeClone(others)
                RunBuiltInV4Step(true, prioClone, presentSups)
                return
            end

            getgenv().V4Hub = nil
            MoveToGreatTree()
            if game.JobId == targetJob then
                ST.ph = (#presentSups ~= 2) and "wait2sp" or "canhmoon"
            elseif game.JobId == backupJob then
                ST.ph = "hold_backup"
            else
                ST.ph = "canhmoon"
            end
            return
        end

        getgenv().V4Hub = nil
        if targetJob and isRegisteredSup and game.JobId ~= targetJob then
            ST.ph = "join"
            DebugLog("SUPPORT", "Joining Moon server %s immediately!", targetJob)
            return TeleportToServer(targetJob, true)
        end

        if backupJob and backupJob ~= game.JobId then
            ST.ph = "join"
            DebugLog("SUPPORT", "Main moon ended! Switching to backup moon server %s...", backupJob)
            return TeleportToServer(backupJob, true)
        end

        MoveToGreatTree()
        ST.ph = isRegisteredSup and "canhmoon" or "sp_extra"
        return
    end

    -- ====================================================================================
    -- LUỒNG CLONE (AI ĐẾN TOP GREAT TREE TRƯỚC THÌ VÀO TEMPLE, CÒN LẠI Ở NGOÀI)
    -- ====================================================================================
    if IsMoonDeadTimeWindow() and ST.m == 0 then
        getgenv().V4Hub = nil
        MoveToGreatTree()
        ST.ph = "idle_moon_off"
        return
    end

    if moonRejectedShortMoon then
        BlacklistCurrentServer()
        if IsMoonDeadTimeWindow() then
            MoveToGreatTree()
            ST.ph = "idle_moon_off"
            return
        end
        ST.ph = "hunt"
        return HopLowServer(true)
    end

    if CLONES_MAP[PlayerName] then
        -- Nếu đang ở server Full Moon (m == 2) có đủ 2 Support hợp lệ -> Tham gia tranh suất tại Top Great Tree!
        if ST.m == 2 then
            local directSups = {}
            for _, sInfo in ipairs(CFG.Supports) do
                local sName, sRace = sInfo[1], sInfo[2]
                if IsSupportPresentAndValid(sName, sRace, targetRace, others[sName]) then
                    table.insert(directSups, sName)
                end
            end
            if #directSups == 2 then
                getgenv().V4Hub = "gear"
                local prioClone = GetPriorityTreeClone(others)
                local amPriority = (prioClone == nil) or (prioClone == PlayerName)
                RunBuiltInV4Step(amPriority, prioClone or PlayerName, directSups)
                return
            end
        end

        local mainMoon, mainEnd = 0, 0
        if targetJob then
            for _, s in pairs(others) do
                if s.j == targetJob and (s.m or 0) > 0 then
                    mainMoon = math.max(mainMoon, s.m or 0)
                    mainEnd  = math.max(mainEnd, tonumber(s.me) or 0)
                end
            end
        end

        -- Chỉ tìm server dự phòng (bắt buộc Near Full Moon) khi server chính còn dưới 5 phút
        local needBackupSearch = (targetJob ~= nil) and (mainMoon == 2 and mainEnd < 5.0)

        -- Giữ server Near Full Moon dự phòng khi server chính còn < 5p
        if needBackupSearch and backupJob and (game.JobId == backupJob or PlayerName == backupHolder) and ST.m == 1 then
            getgenv().V4Hub = nil
            MoveToGreatTree()
            ST.ph = "hold_backup"
            return
        end

        -- Ở server Moon chính
        if targetJob then
            if game.JobId == targetJob then
                if clonesCanJoin then
                    local presentSups = {}
                    for _, sInfo in ipairs(CFG.Supports) do
                        local sName, sRace = sInfo[1], sInfo[2]
                        if IsSupportPresentAndValid(sName, sRace, targetRace, others[sName]) then
                            table.insert(presentSups, sName)
                        end
                    end

                    if (#presentSups == 2) and ST.m == 2 then
                        getgenv().V4Hub = "gear"
                        local prioClone = GetPriorityTreeClone(others)
                        local amPriority = (prioClone == nil) or (prioClone == PlayerName)
                        RunBuiltInV4Step(amPriority, prioClone or PlayerName, presentSups)
                        return
                    end

                    if getgenv().V4Hub == "gear" and ST.m ~= 2 then
                        getgenv().V4Hub = nil
                        return HopLowServer(false)
                    end
                    MoveToGreatTree()
                    return
                else
                    MoveToGreatTree()
                    ST.ph = "wait2sp"
                    return
                end
            else
                -- Nếu server chính đang trên 5p hoặc Near Full Moon -> Đứng đợi & cố join server chính, không đi tìm moon
                if not needBackupSearch then
                    getgenv().V4Hub = nil
                    MoveToGreatTree()
                    ST.ph = "spam_join"
                    TeleportToServer(targetJob, true)
                    return
                end

                -- Server chính dưới 5p: nếu đã có dự phòng Near Full Moon thì join server chính; chưa có thì hop tìm Near Full Moon
                if backupJob then
                    getgenv().V4Hub = nil
                    MoveToGreatTree()
                    ST.ph = "spam_join"
                    TeleportToServer(targetJob, true)
                    return
                end
            end
        end
    end

    getgenv().V4Hub = nil

    if ST.m > 0 and game.JobId == targetJob then
        MoveToGreatTree()
        ST.ph = "wait2sp"
        return
    end

    if IsMoonDeadTimeWindow() then
        MoveToGreatTree()
        ST.ph = "idle_moon_off"
        return
    end

    if (os.time() - ST.jt < 4) and not (targetJob and failedJoinJobs[targetJob]) then
        return
    end

    ST.ph = "hunt"
    return HopLowServer(true)
end

-- ========================================================================================
-- 20. MAIN LOOP STARTUP
-- ========================================================================================
DebugLog("INIT", "6V4 Auto Upgear Orchestrator (Integrated V4) initialized for account %s.", PlayerName)
while task.wait(0.35) and not IsStopped() do
    local ok, err = pcall(TickOrchestrator)
    if not ok then
        DebugWarn("MAIN-LOOP", "Unhandled exception in tick loop: %s", tostring(err))
    end
end
