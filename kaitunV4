    if noclipEnabled then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end
    end
end)

local function StopTween(keepFloat)
    if activeTween then
        pcall(function() activeTween:Cancel() end)
        activeTween = nil
    end
    SetNoclip(false)
    if not keepFloat then
        SetFloat(false)
    end
end

local function TweenTo(targetCF, customSpeed, cancelCond, keepFloatAfter)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not (hrp and hum and hum.Health > 0) then return false end

    if hum.Sit then
        hum.Sit = false
        hum.Jump = true
        task.wait(0.2)
    end

    local dist = (hrp.Position - targetCF.Position).Magnitude
    if dist <= 6 then
        hrp.CFrame = targetCF
        SetNoclip(false)
        SetFloat(keepFloatAfter == true)
        return true
    end

    StopTween(true)
    SetFloat(true)
    SetNoclip(true)

    local speed = math.min(customSpeed or GetCfg().TweenSpeed or 190, 200)
    local duration = dist / speed
    local tw = TweenService:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), { CFrame = targetCF })
    activeTween = tw
    tw:Play()

    while tw.PlaybackState == Enum.PlaybackState.Playing do
        if not isRunning or getgenv().V4Stop or not GetCfg().Enabled or (cancelCond and cancelCond()) then
            StopTween(keepFloatAfter)
            return false
        end
        local c = LocalPlayer.Character
        local h = c and c:FindFirstChildOfClass("Humanoid")
        if not (c and h and h.Health > 0) then
            StopTween(false)
            return false
        end
        task.wait(0.05)
    end

    StopTween(keepFloatAfter)
    return (hrp.Position - targetCF.Position).Magnitude <= 15
end

