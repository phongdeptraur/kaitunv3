task.spawn(function()
    while task.wait(0.25) do
        if ShouldStop() then
            StopTween()
            getgenv().AutoV4AimPos = nil
            currentStatus = "Đã dừng (6V4 Stop / Disabled)"
            break
        end

        pcall(function()
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if not (hrp and hum and hum.Health > 0) then
                currentStatus = "Đang chờ hồi sinh..."
                return
            end

            AutoUpgradeAndSpendGear()

            if IsTrialActive() then
                getgenv().AutoV4AimPos = nil
                HandleTrial()
                return
            end
            getgenv().AutoV4AimPos = nil

            EnsureTempleLoaded()

            if not IsInsideTemple() then
                currentStatus = "Đang bay lên đỉnh Great Tree..."
                local reachedTree = TweenTo(GREAT_TREE_TOP, GetCfg().TweenSpeed or 190, function()
                    return IsInsideTemple() or ShouldStop()
                end)

                if reachedTree and not IsInsideTemple() and not ShouldStop() then
                    currentStatus = "Đang gọi Teleport vào Temple..."
                    local timeout = os.clock()
                    while not IsInsideTemple() and (os.clock() - timeout < 10) and not ShouldStop() do
                        CommF_:InvokeServer("RaceV4Progress", "Teleport")
                        task.wait(0.8)
                    end
                end
                return
            end

            if IsInsideTemple() then
                local myRace = GetRace(LocalPlayer)
                local doorCF = GetDoorCFrame(myRace)

                if not doorCF then
                    currentStatus = "Không tìm thấy cửa tộc: " .. myRace
                    return
                end

                if (hrp.Position - doorCF.Position).Magnitude > 6 then
                    currentStatus = "Đang bay tới cửa tộc " .. myRace .. "..."
                    TweenTo(doorCF, 200, function()
                        return not IsInsideTemple() or IsTrialActive() or ShouldStop()
                    end)
                else
                    currentStatus = "Đã đứng tại cửa " .. myRace .. " (Chờ 6V4 bật V3)"
                end
            end
        end)
    end
end)

