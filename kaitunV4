local function EnsureTempleLoaded()
    local map = Workspace:FindFirstChild("Map")
    if map and not map:FindFirstChild("Temple of Time") then
        local stash = ReplicatedStorage:FindFirstChild("MapStash")
        local temple = stash and stash:FindFirstChild("Temple of Time")
        if temple then
            temple.Parent = map
        end
    end
    return map and map:FindFirstChild("Temple of Time")
end

local function IsInsideTemple()
    local root = GetRoot()
    if not root then return false end
    if root.Position.Y > 4000 then return true end
    return (root.Position - TEMPLE_CENTER_POS).Magnitude <= 4500
end

local function IsInActiveTrial6V4()
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    local raidTimer = pg and pg:FindFirstChild("Main")
        and pg.Main:FindFirstChild("TopHUDList")
        and pg.Main.TopHUDList:FindFirstChild("RaidTimer")
    if raidTimer and raidTimer.Visible then
        return true
    end
    local map = Workspace:FindFirstChild("Map")
    local temple = map and map:FindFirstChild("Temple of Time")
    local ff = temple and temple:FindFirstChild("FFABorder") and temple.FFABorder:FindFirstChild("Forcefield")
    if ff and ff.Transparency ~= 1 then
        return true
    end
    return false
end

local function GetDoorPosition(raceName)
    local rKey = tostring(raceName or ""):lower()
    if rKey == "" then return nil end

    local temple = EnsureTempleLoaded()
    if temple then
        local titleRace = rKey:sub(1, 1):upper() .. rKey:sub(2)
        local corridor = temple:FindFirstChild(titleRace .. "Corridor")
        local door = corridor and corridor:FindFirstChild("Door")
        local innerDoor = door and door:FindFirstChild("Door")
        local rightDoor = innerDoor and innerDoor:FindFirstChild("RightDoor")
        local union = rightDoor and rightDoor:FindFirstChild("Union")
        if union then
            return union.Position
        end
    end
    return TEMPLE_DOORS[rKey]
end

local function IsAccAtDoorInGame(accName, targetRace)
    if not InSea3() then return false end
    local plr = Players:FindFirstChild(accName)
    if not plr then return false end
    local char = plr.Character
    if not char then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not (hrp and hum and hum.Health > 0) then return false end

    local expectedRace = SUPPORTS_MAP[accName]
    if not expectedRace then
        local data = plr:FindFirstChild("Data")
        local r = data and data:FindFirstChild("Race")
        expectedRace = (r and tostring(r.Value):lower()) or targetRace
    end

    local doorPos = GetDoorPosition(expectedRace)
    if doorPos and (hrp.Position - doorPos).Magnitude < 20 then
        return true, expectedRace
    end

    for rName, dPos in pairs(TEMPLE_DOORS) do
        if (hrp.Position - dPos).Magnitude < 20 then
            return true, rName
        end
    end
    return false
end

local function IsAccAtTopGreatTreeOrTemple(accName)
    if not InSea3() then return false, false end
    local plr = Players:FindFirstChild(accName)
    local char = plr and plr.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not (hrp and hum and hum.Health > 0) then return false, false end

    local inTemple = (hrp.Position - TEMPLE_CENTER_POS).Magnitude <= 3000
    local atTopTree = (hrp.Position - TOP_GREAT_TREE_POS).Magnitude <= 45
    return (inTemple or atTopTree), inTemple
end

-- Xác định Clone nào đến Top Great Tree sớm nhất để được phép vào Temple of Time
local function GetPriorityTreeClone(others)
    local bestClone = nil
    local bestTime  = math.huge

    for _, cName in ipairs(CFG.Clones) do
        if Players:FindFirstChild(cName) then
            local cSt = others and others[cName]
            local isDone = (cSt and cSt.dn) or (ST.tr and isfile(PROGRESS_DIR .. "/c_" .. ST.tr .. "_" .. cName .. ".txt"))
            if not isDone then
                local reached, inTemple = IsAccAtTopGreatTreeOrTemple(cName)
                if reached or (cSt and cSt.atTree) then
                    local tArr = (cSt and cSt.treeTime and cSt.treeTime > 0) and cSt.treeTime or math.huge
                    -- Ưu tiên người đã vào sẵn trong Temple nếu cùng thời điểm
                    if inTemple and tArr == math.huge then
                        tArr = os.time() - 1
                    end
                    if tArr < bestTime or (tArr == bestTime and (not bestClone or cName < bestClone)) then
                        bestTime = tArr
                        bestClone = cName
                    end
                end
            end
        end
    end

    return bestClone
end

local function GetNowMs()
    local ok, ms = pcall(function()
        return DateTime.now().UnixTimestampMillis
    end)
    if ok and type(ms) == "number" then
        return ms
    end
    return math.floor(tick() * 1000)
end

local function TriggerDoorV3Ability()
    if os.clock() - lastDoorV3Clock < 3.0 then return end
    lastDoorV3Clock = os.clock()

    DebugLog("DOOR-V3", "Cả 3 acc đã đứng ổn định tại cửa 0.5s -> Kích hoạt V3 đồng bộ!")

    pcall(function()
        if CommE then
            CommE:FireServer("ActivateAbility")
        end
    end)
    task.spawn(function()
        pcall(function()
            VirtualInputMgr:SendKeyEvent(true, Enum.KeyCode.T, false, game)
            task.wait(0.05)
            VirtualInputMgr:SendKeyEvent(false, Enum.KeyCode.T, false, game)
        end)
    end)

    -- Sau 15s kể từ lần bật V3 đầu tiên nếu chưa dịch chuyển vào phòng Trial thì Reset nhân vật ngay
    if not didTriggerV3AtDoor then
        didTriggerV3AtDoor = true
        v3TriggeredAtClock = os.clock()
        doorV3VerifyToken = doorV3VerifyToken + 1
        local myToken = doorV3VerifyToken

        task.delay(15.0, function()
            if IsStopped() or doorV3VerifyToken ~= myToken then return end
            didTriggerV3AtDoor = false
            v3TriggeredAtClock = 0
            myDoorArriveMs = 0
            all3InGameSinceMs = 0

            local hum = GetHumanoid()
            if not (hum and hum.Health > 0) then return end

            if not GetAccTrialRoomName(PlayerName) then
                DebugWarn("DOOR-V3", "Sau 15s bật V3 vẫn chưa vào phòng Trial -> Reset ngay!")
                ST.door = false
                ST.doorTime = 0
                ForceResetCharacter()
            end
        end)
    end
end

local function GetAccTrialRoomName(accName)
    if not InSea3() then return nil end
    local plr = Players:FindFirstChild(accName)
    local char = plr and plr.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not (hrp and hum and hum.Health > 0) then return nil end

    -- Toàn bộ 6 hành lang cửa trong Temple of Time nằm trong bán kính 1150 studs từ tâm Temple (Mink 882, Human 1004)
    if (hrp.Position - TEMPLE_CENTER_POS).Magnitude <= 1150 then
        return nil
    end

    -- Chặn nhận nhầm phòng Trial nếu nhân vật vẫn đang đứng gần bất kỳ cửa tộc nào
    for _, dPos in pairs(TEMPLE_DOORS) do
        if (hrp.Position - dPos).Magnitude <= 60 then
            return nil
        end
    end

    local worldOrigin = Workspace:FindFirstChild("_WorldOrigin")
    local locs = worldOrigin and worldOrigin:FindFirstChild("Locations")
    if locs then
        local nearestTrial, minDist = nil, 1300
        for _, tName in ipairs(TRIAL_ROOM_LIST) do
            local part = locs:FindFirstChild(tName)
            if part then
                local dist = (hrp.Position - part.Position).Magnitude
                if dist < minDist then
                    minDist = dist
                    nearestTrial = tName
                end
            end
        end
        if nearestTrial then
            return nearestTrial
        end
    end
    return nil
end

-- Vòng đồng bộ tốc độ cao (0.03s): Chờ 0.5s sau khi tween tới cửa -> Cả 3 acc bật V3 cùng 1 mili-giây + Reset chuẩn 15s
task.spawn(function()
    while task.wait(0.03) and not IsStopped() do
        if not InSea3() then continue end

        local inTrialNow = GetAccTrialRoomName(PlayerName) ~= nil

        -- Đã vào phòng Trial thành công -> Xóa bộ đếm 15s & dọn trạng thái cửa
        if inTrialNow then
            if didTriggerV3AtDoor then
                didTriggerV3AtDoor = false
                v3TriggeredAtClock = 0
            end
            myDoorArriveMs = 0
            all3InGameSinceMs = 0
            continue
        end

        -- Failsafe: Quá 15s sau khi bật V3 mà chưa vào Trial -> Reset bắt buộc
        if didTriggerV3AtDoor and v3TriggeredAtClock > 0 and (os.clock() - v3TriggeredAtClock >= 15.0) then
            DebugWarn("DOOR-V3", "Quá 15s sau khi bật V3 chưa vào Trial (Failsafe) -> Reset ngay!")
            didTriggerV3AtDoor = false
            v3TriggeredAtClock = 0
            myDoorArriveMs = 0
            all3InGameSinceMs = 0
            ST.door = false
            ST.doorTime = 0
            ForceResetCharacter()
            continue
        end

        -- Đồng bộ 0.5s sau khi tween đến cửa cho cả 3 acc
        if ST.m == 2 and not moonRejectedShortMoon and IsInsideTemple() then
            local prioClone = activeDoorSyncTargets.priorityClone
            local sups = activeDoorSyncTargets.sups
            local isMyParticipant = prioClone and type(sups) == "table" and #sups >= 2
                and (PlayerName == prioClone or PlayerName == sups[1] or PlayerName == sups[2])

            local mySettledAtDoor = isMyParticipant
                and (not activeTween)
                and (not isMovePhysicsActive)
                and IsAccAtDoorInGame(PlayerName, ST.tr)

            if mySettledAtDoor then
                local nowMs = GetNowMs()
                if myDoorArriveMs == 0 then
                    myDoorArriveMs = nowMs
                    local syncData = SafeReadJson(DOOR_SYNC_FILE)
                    syncData.arrived = type(syncData.arrived) == "table" and syncData.arrived or {}
                    syncData.arrived[PlayerName] = myDoorArriveMs
                    syncData.updated = nowMs
                    SafeWriteJson(DOOR_SYNC_FILE, syncData)
                end

                local all3AtDoor = IsAccAtDoorInGame(prioClone, ST.tr)
                    and IsAccAtDoorInGame(sups[1], ST.tr)
                    and IsAccAtDoorInGame(sups[2], ST.tr)

                if all3AtDoor then
                    if all3InGameSinceMs == 0 then
                        all3InGameSinceMs = nowMs
                    end

                    local pairKey = prioClone .. "|" .. sups[1] .. "|" .. sups[2]
                    local syncData = SafeReadJson(DOOR_SYNC_FILE)
                    syncData.arrived = type(syncData.arrived) == "table" and syncData.arrived or {}

                    if syncData.pairKey ~= pairKey then
                        syncData.pairKey = pairKey
                        syncData.fireAt = nil
                    end

                    if not syncData.arrived[PlayerName] then
                        syncData.arrived[PlayerName] = myDoorArriveMs
                        syncData.updated = nowMs
                        SafeWriteJson(DOOR_SYNC_FILE, syncData)
                    end

                    -- Lấy mốc thời gian người cuối cùng trong 3 acc chạm cửa (hoặc fallback mốc thấy đủ 3 acc in-game)
                    local tClone = tonumber(syncData.arrived[prioClone]) or all3InGameSinceMs
                    local tSup1  = tonumber(syncData.arrived[sups[1]]) or all3InGameSinceMs
                    local tSup2  = tonumber(syncData.arrived[sups[2]]) or all3InGameSinceMs
                    local latestArriveMs = math.max(tClone, tSup1, tSup2, all3InGameSinceMs)

                    -- Đợi đủ 0.5s (500ms) sau khi cả 3 acc tween tới cửa
                    if (nowMs - latestArriveMs) >= 500 then
                        local fireAtMs = tonumber(syncData.fireAt)
                        if not fireAtMs or (nowMs - fireAtMs) > 3500 then
                            fireAtMs = nowMs + 150
                            syncData.fireAt = fireAtMs
                            syncData.updated = nowMs
                            SafeWriteJson(DOOR_SYNC_FILE, syncData)
                        end

                        -- Đợi chính xác tới mili-giây fireAtMs để cả 3 acc bật V3 cùng lúc nhất
                        local waitMs = fireAtMs - GetNowMs()
                        if waitMs > 0 and waitMs <= 1000 then
                            while GetNowMs() < fireAtMs and not IsStopped() do
                                task.wait()
                            end
                        end

                        if IsAccAtDoorInGame(PlayerName, ST.tr) and not GetAccTrialRoomName(PlayerName) then
                            TriggerDoorV3Ability()
                        end
                    end
                else
                    all3InGameSinceMs = 0
                end
            else
                if myDoorArriveMs ~= 0 then
                    myDoorArriveMs = 0
                    all3InGameSinceMs = 0
                    local syncData = SafeReadJson(DOOR_SYNC_FILE)
                    if type(syncData.arrived) == "table" and syncData.arrived[PlayerName] then
                        syncData.arrived[PlayerName] = nil
                        syncData.fireAt = nil
                        syncData.updated = GetNowMs()
                        SafeWriteJson(DOOR_SYNC_FILE, syncData)
                    end
                end
            end
        else
            myDoorArriveMs = 0
            all3InGameSinceMs = 0
        end
    end
end)

local function IsSupportEligible(sName, statusObj, targetRace)
    local sRace = SUPPORTS_MAP[sName]
    if not sRace or sRace == targetRace then return false end
    if not statusObj then return false end
    if not statusObj.rdy then return false end
    if statusObj.tn ~= true then return false end
    if statusObj.ph == "train" or statusObj.ph == "frag" or statusObj.ph == "v3" or statusObj.ph == "travel_sea3" or statusObj.ph == "travel_sea2" then
        return false
    end
    return true
end

