local notifConnections = {}
local hookedLabels = setmetatable({}, { __mode = "k" })
local lastCapturedNotif = ""
local lastCapturedNotifClock = 0

local function TrackNotifConn(conn)
    table.insert(notifConnections, conn)
    return conn
end

local function ProcessNotificationText(rawText)
    if IsStopped() or type(rawText) ~= "string" then return end

    local cleanText = rawText:gsub("<[^>]+>", ""):gsub("^%s*(.-)%s*$", "%1")
    if cleanText == "" or cleanText == "Label" or cleanText == "TextLabel" then
        return
    end

    if cleanText == lastCapturedNotif and (os.clock() - lastCapturedNotifClock) < 0.15 then
        return
    end
    lastCapturedNotif = cleanText
    lastCapturedNotifClock = os.clock()

    lastNotifText = cleanText
    lastNotifTime = os.time()
    DebugLog("NOTIF", "%s", cleanText)

    local lowerText = string.lower(cleanText)
    if string.find(lowerText, "trials starting") or string.find(lowerText, "trial starting") then
        eventTimers.start = os.clock()
        ST.trialStarting = os.time()
        DebugLog("EVENT", "Phát hiện 'Trials starting in...'! (%s)", cleanText)
    elseif string.find(lowerText, "all trials have been completed") or string.find(lowerText, "there can only be one") then
        eventTimers.done = os.clock()
        lastTrainCheckClock = 0
        didTriggerV3AtDoor = false
        v3TriggeredAtClock = 0
        myDoorArriveMs = 0
        all3InGameSinceMs = 0
        DebugLog("EVENT", "Phát hiện Trial hoàn tất! (%s)", cleanText)
        if SUPPORTS_MAP[PlayerName] then
            if getgenv().V4Hub == "gear" then
                getgenv().V4Hub = nil
            end
            ForceResetCharacter()
        else
            task.delay(8, function()
                if getgenv().V4Hub == "gear" then
                    getgenv().V4Hub = nil
                end
            end)
        end
    end
end

local function HookNotificationLabel(obj)
    if IsStopped() or hookedLabels[obj] then return end
    if obj:IsA("TextLabel") then
        hookedLabels[obj] = true

        task.defer(function()
            if not IsStopped() and obj.Parent then
                ProcessNotificationText(obj.Text)
            end
        end)

        TrackNotifConn(obj:GetPropertyChangedSignal("Text"):Connect(function()
            if obj.Parent then
                ProcessNotificationText(obj.Text)
            end
        end))
    end
end

local function HookNotificationsGui(notifGui)
    if not notifGui or IsStopped() then return end

    for _, desc in ipairs(notifGui:GetDescendants()) do
        HookNotificationLabel(desc)
    end

    TrackNotifConn(notifGui.DescendantAdded:Connect(function(desc)
        HookNotificationLabel(desc)
    end))
end

