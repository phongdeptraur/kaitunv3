-- 6. XỬ LÝ TỰ ĐỘNG VƯỢT TRIAL, MUA GEAR & CỘNG ĐIỂM GEAR V4
-- ============================================================================
local function HandleTrial()
    local cfg = GetCfg()
    local role = GetMyRole()

    if role == "Help" then
        if cfg.Help and cfg.Help.Reset ~= false then
            currentStatus = "Support vào Trial -> Tự Reset nhường Main"
            task.wait(1.5)
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                hum.Health = 0
            end
        else
            currentStatus = "Support đang đứng chờ trong Trial"
        end
        return
    end

    if not cfg.AutoTrial then
        currentStatus = "Đang trong Trial (AutoTrial đang tắt)"
        return
    end

    local race = GetRace(LocalPlayer)
    local locs = workspace._WorldOrigin.Locations
    currentStatus = "Đang vượt Trial tộc " .. race

    if race == "Human" then
        local center = locs:FindFirstChild("Trial of Strength")
        if center then
            for _, mob in ipairs(workspace.Enemies:GetChildren()) do
                local mHrp = mob:FindFirstChild("HumanoidRootPart")
                local mHum = mob:FindFirstChildOfClass("Humanoid")
                if mHrp and mHum and mHum.Health > 0 and (mHrp.Position - center.Position).Magnitude <= 1000 then
                    TweenTo(mHrp.CFrame * CFrame.new(0, 15, 0), 200, function()
                        return not IsTrialActive() or mHum.Health <= 0
                    end)
                    EquipWeaponByType("Melee")
                    AttackNearbyMobs(65)
                    break
                end
            end
        end

    elseif race == "Ghoul" then
        local center = locs:FindFirstChild("Trial of Carnage")
        if center then
            for _, mob in ipairs(workspace.Enemies:GetChildren()) do
                local mHrp = mob:FindFirstChild("HumanoidRootPart")
                local mHum = mob:FindFirstChildOfClass("Humanoid")
                if mHrp and mHum and mHum.Health > 0 and (mHrp.Position - center.Position).Magnitude <= 1000 then
                    TweenTo(mHrp.CFrame * CFrame.new(0, 15, 0), 200, function()
                        return not IsTrialActive() or mHum.Health <= 0
                    end)
                    EquipWeaponByType("Melee")
                    AttackNearbyMobs(65)
                    break
                end
            end
        end

    elseif race == "Skypiea" then
        local skyTrial = workspace.Map:FindFirstChild("SkyTrial")
        local finish = skyTrial and skyTrial:FindFirstChild("Model") and skyTrial.Model:FindFirstChild("FinishPart")
        if finish then
            TweenTo(finish.CFrame, 200, function() return not IsTrialActive() end)
        end

    elseif race == "Mink" then
        local startPoint = workspace:FindFirstChild("StartPoint")
        if startPoint then
            TweenTo(startPoint.CFrame * CFrame.new(0, 2, 0), 200, function() return not IsTrialActive() end)
        end

    elseif race == "Cyborg" then
        TweenTo(CYBORG_SAFE_CF, 200, function() return not IsTrialActive() end)

    elseif race == "Fishman" then
        local waterLoc = locs:FindFirstChild("Trial of Water")
        if waterLoc then
            for _, sb in ipairs(workspace.SeaBeasts:GetChildren()) do
                local sbHrp = sb:FindFirstChild("HumanoidRootPart")
                local sbHealth = sb:FindFirstChild("Health")
                if sbHrp and sbHealth and sbHealth.Value > 0 and (sbHrp.Position - waterLoc.Position).Magnitude <= 1500 then
                    getgenv().AutoV4AimPos = CFrame.new(sbHrp.Position.X, 40, sbHrp.Position.Z)
                    local hoverPos = Vector3.new(sbHrp.Position.X, math.max(sbHrp.Position.Y + 180, 140), sbHrp.Position.Z)
                    TweenTo(CFrame.new(hoverPos), 200, function()
                        return not IsTrialActive() or sbHealth.Value <= 0
                    end)
                    if LocalPlayer:DistanceFromCharacter(sbHrp.Position) < 400 then
                        CastAllSkills()
                    end
                    break
                end
            end
        end
    end
end

local lastGearCheck = 0
local function AutoUpgradeAndSpendGear()
    if os.clock() - lastGearCheck < 2.0 then return end
    lastGearCheck = os.clock()

    local cfg = GetCfg()
    if not cfg.AutoUpgradeRace then return end

    pcall(function()
        local code = CommF_:InvokeServer("UpgradeRace", "Check")
        if code == 2 or code == 4 or code == 7 then
            CommF_:InvokeServer("UpgradeRace", "Buy")
        end
    end)

    pcall(function()
        local clockData = CommF_:InvokeServer("TempleClock", "Check")
        if type(clockData) == "table" and (clockData.HadPoint or (clockData.RaceLevel and clockData.RaceLevel < 2)) then
            local patternStr = (cfg.Main and cfg.Main.Gear) or "A-B-A"
            local parts = string.split(patternStr, "-")
            local mapType = { A = "Alpha", B = "Omega" }

            local gears = clockData.RaceDetails and clockData.RaceDetails.Gears or {}
            local slotToSpend = "Gear1"
            local gearType = "Default"

            if (clockData.RaceLevel or 1) >= 2 then
                if not gears[1] or gears[1] == "" then
                    slotToSpend = "Gear2"
                    gearType = mapType[parts[1]] or "Alpha"
                elseif not gears[2] or gears[2] == "" then
                    slotToSpend = "Gear3"
                    gearType = mapType[parts[2]] or "Omega"
                elseif not gears[3] or gears[3] == "" then
                    slotToSpend = "Gear4"
                    gearType = mapType[parts[3]] or "Alpha"
                end
            end

            CommF_:InvokeServer("TempleClock", "SpendPoint", slotToSpend, gearType)
        end
    end)
end

