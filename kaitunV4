-- 6. XỬ LÝ VƯỢT ẢI TRIAL CHO TẤT CẢ CÁC TỘC
-- ============================================================================
local function HandleTrialRoom(trialName, trialLoc)
    local cfg = GetCfg()
    if cfg.AutoTrial == false then
        currentStatus = "Đang trong " .. trialName .. " (AutoTrial tắt)"
        return
    end

    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local race = GetRace(LocalPlayer)
    currentStatus = "Đang làm Trial: " .. race .. " (" .. trialName .. ")"

    -- Tự bật thức tỉnh V4 nếu đầy thanh nộ
    pcall(function()
        local energy = char:FindFirstChild("RaceEnergy")
        local transformed = char:FindFirstChild("RaceTransformed")
        local awk = LocalPlayer.Backpack:FindFirstChild("Awakening")
        if energy and energy.Value >= 1 and transformed and not transformed.Value and awk then
            awk.RemoteFunction:InvokeServer(true)
        end
    end)

    -- 1. HUMAN (Trial of Strength) hoặc GHOUL (Trial of Carnage)
    if trialName == "Trial of Strength" or trialName == "Trial of Carnage" or race == "Human" or race == "Ghoul" then
        local centerPos = trialLoc and trialLoc.Position or hrp.Position
        local nearestMob, minDist = nil, 1000
        for _, mob in ipairs(workspace.Enemies:GetChildren()) do
            local mHrp = mob:FindFirstChild("HumanoidRootPart")
            local mHum = mob:FindFirstChildOfClass("Humanoid")
            if mHrp and mHum and mHum.Health > 0 then
                local dCenter = (mHrp.Position - centerPos).Magnitude
                local dPlayer = (mHrp.Position - hrp.Position).Magnitude
                if dCenter <= 1000 and dPlayer < minDist then
                    minDist = dPlayer
                    nearestMob = mob
                end
            end
        end

        if nearestMob then
            local mHrp = nearestMob:FindFirstChild("HumanoidRootPart")
            local mHum = nearestMob:FindFirstChildOfClass("Humanoid")
            SetFloat(true)
            SetNoclip(true)

            -- Bay lơ lửng trên đầu quái 18 studs để không bị đánh chết và đánh liên tục
            local hoverCF = mHrp.CFrame * CFrame.new(0, 18, 0)
            if (hrp.Position - hoverCF.Position).Magnitude > 12 then
                TweenTo(hoverCF, 200, function()
                    return not GetActiveTrialRoom() or not mHum or mHum.Health <= 0
                end, true)
            else
                hrp.CFrame = hoverCF
            end

            BringTrialMobs(nearestMob, centerPos)
            EquipWeaponByType("Melee")
            AttackNearbyMobs(80)
        else
            currentStatus = "Đang chờ quái spawn trong " .. trialName .. "..."
        end

    -- 2. SKYPIEA (Trial of the King)
    elseif trialName == "Trial of the King" or race == "Skypiea" then
        local skyTrial = workspace.Map:FindFirstChild("SkyTrial")
        local model = skyTrial and skyTrial:FindFirstChild("Model")
        local finish = model and model:FindFirstChild("FinishPart")
        if finish then
            SetFloat(true)
            if (hrp.Position - finish.Position).Magnitude > 6 then
                TweenTo(finish.CFrame, 200, function()
                    return not GetActiveTrialRoom()
                end, true)
            else
                hrp.CFrame = finish.CFrame
                currentStatus = "Đã chạm đích Trial Skypiea!"
            end
        else
            currentStatus = "Đang chờ map SkyTrial load..."
        end

    -- 3. MINK (Trial of Speed)
    elseif trialName == "Trial of Speed" or race == "Mink" then
        local startPoint = workspace:FindFirstChild("StartPoint")
        if startPoint then
            SetFloat(true)
            local goalCF = startPoint.CFrame * CFrame.new(0, 3, 0)
            if (hrp.Position - goalCF.Position).Magnitude > 6 then
                TweenTo(goalCF, 200, function()
                    return not GetActiveTrialRoom()
                end, true)
            else
                hrp.CFrame = goalCF
                currentStatus = "Đã chạm đích Trial Mink!"
            end
        else
            currentStatus = "Đang tìm đích Trial Mink..."
        end

    -- 4. CYBORG (Trial of the Machine)
    elseif trialName == "Trial of the Machine" or race == "Cyborg" then
        SetFloat(true)
        if (hrp.Position - CYBORG_SAFE_CF.Position).Magnitude > 6 then
            TweenTo(CYBORG_SAFE_CF, 200, function()
                return not GetActiveTrialRoom()
            end, true)
        else
            hrp.CFrame = CYBORG_SAFE_CF
            currentStatus = "Đang né bom Trial Cyborg..."
        end

    -- 5. FISHMAN (Trial of Water)
    elseif trialName == "Trial of Water" or race == "Fishman" then
        local centerPos = trialLoc and trialLoc.Position or hrp.Position
        local targetSB = nil
        for _, sb in ipairs(workspace.SeaBeasts:GetChildren()) do
            local sbHrp = sb:FindFirstChild("HumanoidRootPart")
            local sbHealth = sb:FindFirstChild("Health")
            if sbHrp and sbHealth and sbHealth.Value > 0 and (sbHrp.Position - centerPos).Magnitude <= 1500 then
                targetSB = sb
                break
            end
        end

        if targetSB then
            local sbHrp = targetSB:FindFirstChild("HumanoidRootPart")
            local sbHealth = targetSB:FindFirstChild("Health")
            getgenv().AutoV4AimPos = CFrame.new(sbHrp.Position.X, 40, sbHrp.Position.Z)

            SetFloat(true)
            local hoverPos = Vector3.new(sbHrp.Position.X, math.max(sbHrp.Position.Y + 160, 140), sbHrp.Position.Z)
            if (hrp.Position - hoverPos).Magnitude > 15 then
                TweenTo(CFrame.new(hoverPos), 200, function()
                    return not GetActiveTrialRoom() or not sbHealth or sbHealth.Value <= 0
                end, true)
            else
                hrp.CFrame = CFrame.new(hoverPos)
            end

            if LocalPlayer:DistanceFromCharacter(sbHrp.Position) < 450 then
                CastAllSkills()
            end
        else
            currentStatus = "Đang chờ Sea Beast trong Trial Water..."
        end
    end
end

