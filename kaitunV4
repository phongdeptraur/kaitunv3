getgenv().AutoV4Cleanup = function()
    isRunning = false
    StopTween(false)
    getgenv().AutoV4AimPos = nil
    if steppedConn then pcall(function() steppedConn:Disconnect() end) end
    if gui then pcall(function() gui:Destroy() end) end
end
