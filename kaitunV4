    getgenv().AutoV4AimHooked = true
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
        local method = getnamecallmethod()
        local args = { ... }
        if method == "FireServer" and self.Name == "RemoteEvent" and getgenv().AutoV4AimPos then
            local target = getgenv().AutoV4AimPos
            if tostring(target.X) ~= "nan" then
                if #args == 1 and typeof(args[1]) == "Vector3" then
                    args[1] = target.Position
                    return oldNamecall(self, unpack(args))
                elseif #args == 1 and typeof(args[1]) == "CFrame" then
                    args[1] = target
                    return oldNamecall(self, unpack(args))
                end
            end
        end
        return oldNamecall(self, ...)
    end))
end

