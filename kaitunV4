-- 4. CÁC HÀM KIỂM TRA TRẠNG THÁI GAME & TỘC
-- ============================================================================
local function ShouldStop()
    if not isRunning or getgenv().V4Stop then return true end
    local cfg = GetCfg()
    if cfg.Enabled == false then return true end
    return false
end

local function GetMyRole()
    local cfg = GetCfg()
    local helpAccs = (cfg.Help and cfg.Help.Account) or {}
    if table.find(helpAccs, LocalPlayer.Name) then
        return "Help"
    end
    return "Main"
end

local function GetRace(plr)
    plr = plr or LocalPlayer
    local data = plr:FindFirstChild("Data")
    local r = data and data:FindFirstChild("Race")
    return r and tostring(r.Value) or ""
end

local function IsFullMoon()
    local sky = Lighting:FindFirstChildOfClass("Sky")
    local hasMoonTex = sky and tostring(sky.MoonTextureId):find("9709149431") ~= nil
    local clock = Lighting.ClockTime
    return hasMoonTex and (clock >= 18 or clock < 5)
end

local function EnsureTempleLoaded()
    if not workspace.Map:FindFirstChild("Temple of Time") then
        local stash = ReplicatedStorage:FindFirstChild("MapStash")
        local temple = stash and stash:FindFirstChild("Temple of Time")
        if temple then
            temple.Parent = workspace.Map
        end
    end
    return workspace.Map:FindFirstChild("Temple of Time")
end

local function IsInsideTemple()
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    return (hrp.Position - TEMPLE_CENTER).Magnitude <= 3000
end

local function IsNearAnyTrial()
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local locs = workspace:FindFirstChild("_WorldOrigin") and workspace._WorldOrigin:FindFirstChild("Locations")
    if not (hrp and locs) then return false end

    for _, name in ipairs(TRIAL_LOCATIONS) do
        local loc = locs:FindFirstChild(name)
        if loc and (hrp.Position - loc.Position).Magnitude < 1500 then
            return true, name
        end
    end
    return false, nil
end

local function IsTrialActive()
    local nearTrial = IsNearAnyTrial()
    if not nearTrial then return false end
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    local raidTimer = pg and pg:FindFirstChild("Main")
        and pg.Main:FindFirstChild("TopHUDList")
        and pg.Main.TopHUDList:FindFirstChild("RaidTimer")
    if raidTimer and raidTimer.Visible then
        return true
    end
    local temple = workspace.Map:FindFirstChild("Temple of Time")
    local ff = temple and temple:FindFirstChild("FFABorder") and temple.FFABorder:FindFirstChild("Forcefield")
    if ff and ff.Transparency ~= 1 then
        return true
    end
    return false
end

local function GetDoorCFrame(raceName)
    local temple = EnsureTempleLoaded()
    if not temple or raceName == "" then return nil end
    local corridor = temple:FindFirstChild(raceName .. "Corridor")
    local door = corridor and corridor:FindFirstChild("Door")
    local innerDoor = door and door:FindFirstChild("Door")
    local rightDoor = innerDoor and innerDoor:FindFirstChild("RightDoor")
    local union = rightDoor and rightDoor:FindFirstChild("Union")
    return union and union.CFrame or nil
end

