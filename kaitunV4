task.spawn(function()
    while task.wait(0.15) do
        if ShouldStop() then
            StopTween(false)
            getgenv().AutoV4AimPos = nil
            currentStatus = "Đã dừng (6V4 Stop / Disabled)"
            break
        end

        pcall(function()
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if not (hrp and hum and hum.Health > 0) then
                SetFloat(false)
                SetNoclip(false)
                currentStatus = "Đang chờ hồi sinh..."
                return
            end

            AutoUpgradeAndSpendGear()

            -- 1. Đang ở trong 1 trong 6 phòng Trial -> Tất cả đều làm Trial để hoàn thành ải!
            local trialName, trialLoc = GetActiveTrialRoom()
            if trialName then
                HandleTrialRoom(trialName, trialLoc)
                return
            end
            getgenv().AutoV4AimPos = nil

            -- 2. Đã xong phòng Trial và được đưa lên Đấu trường PvP (Temple of Time):
            -- Help sẽ Reset tại đây (nếu bật Help.Reset) để nhường Main thắng ngay lập tức!
            if IsInPvPArena() then
                StopTween(false)
                local cfg = GetCfg()
                if GetMyRole() == "Help" and cfg.Help and cfg.Help.Reset ~= false then
                    currentStatus = "Đã xong Trial -> Support Reset tại Arena!"
                    hum.Health = 0
                else
                    currentStatus = "Đang ở Arena chờ thắng Trial..."
                end
                return
            end

            -- Tắt float nếu đang đứng bình thường ngoài sảnh Temple of Time
            if floatEnabled and not activeTween then
                SetFloat(false)
                SetNoclip(false)
            end

            -- 3. Load map Temple of Time từ MapStash
            EnsureTempleLoaded()

            -- 4. Nếu chưa ở trong Temple of Time -> Tween lên đỉnh Great Tree rồi Teleport vào
            if not IsInsideTemple() then
                currentStatus = "Đang bay lên đỉnh Great Tree..."
                local reachedTree = TweenTo(GREAT_TREE_TOP, GetCfg().TweenSpeed or 190, function()
                    return IsInsideTemple() or ShouldStop()
                end, false)

                if reachedTree and not IsInsideTemple() and not ShouldStop() then
                    currentStatus = "Đang gọi Teleport vào Temple..."
                    local timeout = os.clock()
                    while not IsInsideTemple() and (os.clock() - timeout < 10) and not ShouldStop() do
                        CommF_:InvokeServer("RaceV4Progress", "Teleport")
                        task.wait(0.8)
                    end
                end
                return
            end

            -- 5. Đã ở trong Temple of Time -> Tween tới cửa tộc đứng chờ 6V4 bật V3
            if IsInsideTemple() then
                local myRace = GetRace(LocalPlayer)
                local doorCF = GetDoorCFrame(myRace)

                if not doorCF then
                    currentStatus = "Không tìm thấy cửa tộc: " .. myRace
                    return
                end

                if (hrp.Position - doorCF.Position).Magnitude > 6 then
                    currentStatus = "Đang bay tới cửa tộc " .. myRace .. "..."
                    TweenTo(doorCF, 200, function()
                        return not IsInsideTemple() or GetActiveTrialRoom() ~= nil or ShouldStop()
                    end, false)
                else
                    currentStatus = "Đã đứng tại cửa " .. myRace .. " (Chờ 6V4 bật V3)"
                end
            end
        end)
    end
end)

