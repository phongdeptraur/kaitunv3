local RERegisterAttack = ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Net"):WaitForChild("RE/RegisterAttack")
local RegisterHit      = require(ReplicatedStorage.Modules.Net):RemoteEvent("RegisterHit", true)
local CombatUtil       = require(ReplicatedStorage.Modules.CombatUtil)

local function EquipWeaponByType(tooltip)
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Sit then return end

    for _, tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") and tool.ToolTip == tooltip then return tool.Name end
    end
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if bp then
        for _, tool in ipairs(bp:GetChildren()) do
            if tool:IsA("Tool") and tool.ToolTip == tooltip then
                hum:EquipTool(tool)
                return tool.Name
            end
        end
    end
end

local function BringTrialMobs(targetMob, centerPos)
    local tHrp = targetMob and targetMob:FindFirstChild("HumanoidRootPart")
    if not tHrp then return end

    for _, enemy in ipairs(Workspace.Enemies:GetChildren()) do
        if enemy ~= targetMob then
            local eHrp = enemy:FindFirstChild("HumanoidRootPart")
            local eHum = enemy:FindFirstChildOfClass("Humanoid")
            if eHrp and eHum and eHum.Health > 0 and (eHrp.Position - centerPos).Magnitude <= 1000 then
                if (eHrp.Position - tHrp.Position).Magnitude <= 250 then
                    eHrp.CanCollide = false
                    eHrp.CFrame = tHrp.CFrame
                end
            end
        end
    end
end

local function AttackNearbyMobs(range)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local stun = char and char:FindFirstChild("Stun")
    if not hrp or (stun and stun.Value ~= 0) then return end

    local hitPairs = {}
    local firstPart = nil
    for _, enemy in ipairs(Workspace.Enemies:GetChildren()) do
        local eHrp = enemy:FindFirstChild("HumanoidRootPart")
        local eHum = enemy:FindFirstChildOfClass("Humanoid")
        if eHrp and eHum and eHum.Health > 0 and (eHrp.Position - hrp.Position).Magnitude <= (range or 80) then
            if CombatUtil:IsVulnerable(enemy) then
                local head = enemy:FindFirstChild("Head") or eHrp
                if not firstPart then firstPart = head end
                table.insert(hitPairs, { enemy, head })
            end
        end
    end

    if firstPart and #hitPairs > 0 then
        RERegisterAttack:FireServer(0)
        RegisterHit:FireServer(firstPart, hitPairs)
    end
end

local function CastAllSkills()
    local skillKeys = { Enum.KeyCode.Z, Enum.KeyCode.X, Enum.KeyCode.C, Enum.KeyCode.V, Enum.KeyCode.F }
    for _, toolType in ipairs({ "Melee", "Blox Fruit", "Sword", "Gun" }) do
        local name = EquipWeaponByType(toolType)
        if name then
            for _, key in ipairs(skillKeys) do
                if IsStopped() or not GetAccTrialRoomName(PlayerName) then return end
                VirtualInputMgr:SendKeyEvent(true, key, false, game)
                task.wait(0.06)
                VirtualInputMgr:SendKeyEvent(false, key, false, game)
                task.wait(0.12)
            end
        end
    end
end

local function IsInPvPArena()
    local root = GetRoot()
    if not root then return false end
    if (root.Position - TEMPLE_CENTER_POS).Magnitude > 750 then
        return false
    end
    local map = Workspace:FindFirstChild("Map")
    local temple = map and map:FindFirstChild("Temple of Time")
    local ff = temple and temple:FindFirstChild("FFABorder") and temple.FFABorder:FindFirstChild("Forcefield")
    return ff ~= nil and ff.Transparency ~= 1
end

local function HandleBuiltInTrialRoom(trialName)
    if not CFG.AutoTrial then return end
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local race = GetCurrentRace()
    local worldOrigin = Workspace:FindFirstChild("_WorldOrigin")
    local locs = worldOrigin and worldOrigin:FindFirstChild("Locations")
    local trialLoc = locs and locs:FindFirstChild(trialName)

    -- Tự bật thức tỉnh V4 nếu đầy nộ
    pcall(function()
        local energy = char:FindFirstChild("RaceEnergy")
        local transformed = char:FindFirstChild("RaceTransformed")
        local bp = LocalPlayer:FindFirstChild("Backpack")
        local awk = bp and bp:FindFirstChild("Awakening")
        if energy and energy.Value >= 1 and transformed and not transformed.Value and awk then
            awk.RemoteFunction:InvokeServer(true)
        end
    end)

    -- 1. HUMAN / GHOUL
    if trialName == "Trial of Strength" or trialName == "Trial of Carnage" or race == "human" or race == "ghoul" then
        local centerPos = trialLoc and trialLoc.Position or hrp.Position
        local nearestMob, minDist = nil, 1000
        for _, mob in ipairs(Workspace.Enemies:GetChildren()) do
            local mHrp = mob:FindFirstChild("HumanoidRootPart")
            local mHum = mob:FindFirstChildOfClass("Humanoid")
            if mHrp and mHum and mHum.Health > 0 then
                local dCenter = (mHrp.Position - centerPos).Magnitude
                local dPlayer = (mHrp.Position - hrp.Position).Magnitude
                if dCenter <= 1000 and dPlayer < minDist then
                    minDist = dPlayer
                    nearestMob = mob
                end
            end
        end

        if nearestMob then
            local mHrp = nearestMob:FindFirstChild("HumanoidRootPart")
            local mHum = nearestMob:FindFirstChildOfClass("Humanoid")
            local hoverPos = mHrp.Position + Vector3.new(0, 18, 0)
            if (hrp.Position - hoverPos).Magnitude > 12 then
                SafeTween(hoverPos, function()
                    return not GetAccTrialRoomName(PlayerName) or not mHum or mHum.Health <= 0
                end, true)
            else
                SetMovePhysics(false, true)
                hrp.CFrame = CFrame.new(hoverPos)
            end
            BringTrialMobs(nearestMob, centerPos)
            EquipWeaponByType("Melee")
            AttackNearbyMobs(80)
        end

    -- 2. SKYPIEA
    elseif trialName == "Trial of the King" or race == "skypiea" then
        local map = Workspace:FindFirstChild("Map")
        local skyTrial = map and map:FindFirstChild("SkyTrial")
        local model = skyTrial and skyTrial:FindFirstChild("Model")
        local finish = model and model:FindFirstChild("FinishPart")
        if finish then
            if (hrp.Position - finish.Position).Magnitude > 6 then
                SafeTween(finish.Position, function()
                    return not GetAccTrialRoomName(PlayerName)
                end, true)
            else
                SetMovePhysics(false, true)
                hrp.CFrame = finish.CFrame
            end
        end

    -- 3. MINK
    elseif trialName == "Trial of Speed" or race == "mink" then
        local startPoint = Workspace:FindFirstChild("StartPoint")
        if startPoint then
            local goalPos = startPoint.Position + Vector3.new(0, 3, 0)
            if (hrp.Position - goalPos).Magnitude > 6 then
                SafeTween(goalPos, function()
                    return not GetAccTrialRoomName(PlayerName)
                end, true)
            else
                SetMovePhysics(false, true)
                hrp.CFrame = CFrame.new(goalPos)
            end
        end

    -- 4. CYBORG
    elseif trialName == "Trial of the Machine" or race == "cyborg" then
        if (hrp.Position - CYBORG_SAFE_CF.Position).Magnitude > 6 then
            cyborgHoldCF = nil
            SafeTween(CYBORG_SAFE_CF.Position, function()
                return not GetAccTrialRoomName(PlayerName)
            end, true)
        else
            SetMovePhysics(false, true)
            cyborgHoldCF = CYBORG_SAFE_CF
            hrp.CFrame = CYBORG_SAFE_CF
        end

    -- 5. FISHMAN
    elseif trialName == "Trial of Water" or race == "fishman" then
        local centerPos = trialLoc and trialLoc.Position or hrp.Position
        local targetSB = nil
        local seaBeasts = Workspace:FindFirstChild("SeaBeasts")
        if seaBeasts then
            for _, sb in ipairs(seaBeasts:GetChildren()) do
                local sbHrp = sb:FindFirstChild("HumanoidRootPart")
                local sbHealth = sb:FindFirstChild("Health")
                if sbHrp and sbHealth and sbHealth.Value > 0 and (sbHrp.Position - centerPos).Magnitude <= 1500 then
                    targetSB = sb
                    break
                end
            end
        end

        if targetSB then
            local sbHrp = targetSB:FindFirstChild("HumanoidRootPart")
            local sbHealth = targetSB:FindFirstChild("Health")
            getgenv().AutoV4AimPos = CFrame.new(sbHrp.Position.X, 40, sbHrp.Position.Z)

            local hoverPos = Vector3.new(sbHrp.Position.X, math.max(sbHrp.Position.Y + 160, 140), sbHrp.Position.Z)
            if (hrp.Position - hoverPos).Magnitude > 15 then
                SafeTween(hoverPos, function()
                    return not GetAccTrialRoomName(PlayerName) or not sbHealth or sbHealth.Value <= 0
                end, true)
            else
                SetMovePhysics(false, true)
                hrp.CFrame = CFrame.new(hoverPos)
            end

            if LocalPlayer:DistanceFromCharacter(sbHrp.Position) < 450 then
                CastAllSkills()
            end
        end
    end
end

local lastAutoGearClock = 0
local isAutoGearing = false
local BUYABLE_UPGRADE_CODES = { [2] = true, [4] = true, [6] = true, [7] = true, [8] = true }

local function TryBuyRaceUpgradeOnce()
    local ok, code = InvokeCFTimeout(4.0, "UpgradeRace", "Check")
    if not ok then return false end
    local numCode = tonumber(code)
    if numCode and BUYABLE_UPGRADE_CODES[numCode] then
        local buyOk, buyRes = InvokeCFTimeout(4.0, "UpgradeRace", "Buy")
        DebugLog("GEAR-BUY", "Đã tự động mua Gear V4! (Code: %s -> %s)", tostring(numCode), tostring(buyRes))
        return buyOk == true
    end
    return false
end

local function TrySpendTempleClockPointOnce()
    local ok, clockData = InvokeCFTimeout(4.0, "TempleClock", "Check")
    if not ok or type(clockData) ~= "table" then return false end

    local raceLevel = tonumber(clockData.RaceLevel) or 1
    local hasPoint = (clockData.HadPoint == true) or (clockData.HadPoint == nil and raceLevel < 2)
    if not hasPoint then return false end

    local parts = string.split(CFG.GearPattern or "A-B-A", "-")
    local mapType = { A = "Alpha", B = "Omega" }
    local gears = (type(clockData.RaceDetails) == "table" and type(clockData.RaceDetails.Gears) == "table")
        and clockData.RaceDetails.Gears or {}

    local hasG1 = (gears.Gear1 ~= nil and gears.Gear1 ~= "") or (gears[1] ~= nil and gears[1] ~= "")
    local hasG2 = (gears.Gear2 ~= nil and gears.Gear2 ~= "") or (gears[2] ~= nil and gears[2] ~= "")
    local hasG3 = (gears.Gear3 ~= nil and gears.Gear3 ~= "") or (gears[3] ~= nil and gears[3] ~= "")
    local hasG4 = (gears.Gear4 ~= nil and gears.Gear4 ~= "") or (gears[4] ~= nil and gears[4] ~= "")

    local slotToSpend, gearType = nil, nil
    if not hasG1 and raceLevel < 2 then
        slotToSpend = "Gear1"
        gearType = "Default"
    elseif not hasG2 then
        slotToSpend = "Gear2"
        gearType = mapType[parts[1]] or "Alpha"
    elseif not hasG3 then
        slotToSpend = "Gear3"
        gearType = mapType[parts[2]] or "Omega"
    elseif not hasG4 then
        slotToSpend = "Gear4"
        gearType = mapType[parts[3]] or "Alpha"
    end

    if not slotToSpend then return false end

    local spendOk, spendRes = InvokeCFTimeout(4.0, "TempleClock", "SpendPoint", slotToSpend, gearType)
    DebugLog("GEAR-SPEND", "Đã cộng điểm %s -> %s (Res: %s)", slotToSpend, gearType, tostring(spendRes))
    return spendOk == true
end

local function AutoUpgradeAndSpendGear()
    if not CFG.AutoGear or not InSea3() then return end
    if isAutoGearing or (os.clock() - lastAutoGearClock < 5.0) then return end
    lastAutoGearClock = os.clock()
    isAutoGearing = true

    task.spawn(function()
        local boughtBefore = TryBuyRaceUpgradeOnce()
        local spentPoint   = TrySpendTempleClockPointOnce()
        local boughtAfter  = false
        if spentPoint then
            task.wait(0.25)
            boughtAfter = TryBuyRaceUpgradeOnce()
        end

        if boughtBefore or spentPoint or boughtAfter then
            lastTrainCheckClock = 0
            UpdateTrialStatus()
        end
        isAutoGearing = false
    end)
end

-- Hàm điều phối luồng V4 tích hợp (Top Great Tree Priority -> Temple -> Door -> Trial -> Arena)
local function RunBuiltInV4Step(isAllowedIntoTemple, priorityCloneName, presentSups)
    activeDoorSyncTargets.priorityClone = priorityCloneName
    activeDoorSyncTargets.sups = presentSups or {}

    local root = GetRoot()
    local hum  = GetHumanoid()
    if not (root and hum and hum.Health > 0) then return end

    -- 1. Đang ở trong phòng Trial -> Tất cả đều làm Trial để hoàn thành ải!
    local trialRoom = GetAccTrialRoomName(PlayerName)
    if trialRoom then
        ST.ph = "trial_run"
        HandleBuiltInTrialRoom(trialRoom)
        return
    end
    cyborgHoldCF = nil
    getgenv().AutoV4AimPos = nil

    -- 2. Đã xong phòng Trial và lên Đấu trường PvP (Arena) -> Support Reset nhường Main thắng!
    if IsInPvPArena() then
        SetMovePhysics(false, false)
        if SUPPORTS_MAP[PlayerName] and CFG.HelpReset then
            ST.ph = "arena_reset"
            ForceResetCharacter()
        else
            ST.ph = "arena_wait"
        end
        return
    end

    if keepFloatActive and not activeTween then
        SetMovePhysics(false, false)
    end

    -- 3. Load sẵn map Temple of Time từ MapStash
    EnsureTempleLoaded()

    -- 4. Nếu CHƯA ở trong Temple of Time
    if not IsInsideTemple() then
        -- Nếu là Clone NHƯNG không phải người đến Top Great Tree đầu tiên -> Đứng chờ bên ngoài tại Top Great Tree!
        if CLONES_MAP[PlayerName] and not isAllowedIntoTemple then
            ST.ph = "wait_outside_temple"
            if (root.Position - TOP_GREAT_TREE_POS).Magnitude > 35 then
                SafeTween(TOP_GREAT_TREE_POS, function()
                    return IsInsideTemple() or IsStopped()
                end, false)
            end
            return
        end

        -- Được phép vào Temple (là 1 trong 2 Support hoặc là Clone ưu tiên đến Top Great Tree sớm nhất)
        ST.ph = "to_top_tree"
        if (root.Position - TOP_GREAT_TREE_POS).Magnitude > 25 then
            SafeTween(TOP_GREAT_TREE_POS, function()
                return IsInsideTemple() or IsStopped()
            end, false)
        end

        if (root.Position - TOP_GREAT_TREE_POS).Magnitude <= 35 and not IsInsideTemple() then
            ST.ph = "enter_temple"
            CommF_:InvokeServer("RaceV4Progress", "Teleport")
            task.wait(0.6)
        end
        return
    end

    -- 5. ĐÃ Ở TRONG Temple of Time
    -- Nếu là Clone đến sau nhưng lỡ ở trong Temple -> Bay ra ngoài Great Tree chờ nhường suất cho Clone ưu tiên
    if CLONES_MAP[PlayerName] and not isAllowedIntoTemple and not IsInActiveTrial6V4() then
        ST.ph = "wait_outside_temple"
        SafeTween(TOP_GREAT_TREE_POS, function()
            return IsInActiveTrial6V4() or IsStopped()
        end, false)
        return
    end

    local myRace = SUPPORTS_MAP[PlayerName] or GetCurrentRace()
    local doorPos = GetDoorPosition(myRace)
    if not doorPos then return end

    if (root.Position - doorPos).Magnitude > 8 then
        ST.ph = "to_door"
        -- Bay tới điểm đứng ngay trước cửa bằng tốc độ khóa cứng 190 stud/s
        local frontPos = doorPos + Vector3.new(0, 2, 0)
        if SafeTween(frontPos, function()
            return not IsInsideTemple() or GetAccTrialRoomName(PlayerName) ~= nil or IsStopped()
        end, false) then
            -- Tắt NoClip & bước bộ vật lý vào sát cửa để ép Server đồng bộ CFrame thật cho mọi acc khác
            SetMovePhysics(false, false)
            local hNow = GetHumanoid()
            if hNow then
                hNow:MoveTo(doorPos)
            end
        end
    else
        ST.ph = "at_door"
        SetMovePhysics(false, false)
    end
end

