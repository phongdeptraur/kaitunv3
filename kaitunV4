local activeTween = nil
local isMovePhysicsActive = false
local keepFloatActive = false
local cyborgHoldCF = nil

local CORE_COLLIDE_PARTS = {
    HumanoidRootPart = true,
    Head = true,
    UpperTorso = true,
    LowerTorso = true,
    Torso = true
}

local function EnsureFloatBV(root, enable)
    if not root then return end
    local bv = root:FindFirstChild("V4FloatBV")
    if enable then
        if not bv then
            bv = Instance.new("BodyVelocity")
            bv.Name = "V4FloatBV"
            bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
            bv.Velocity = Vector3.zero
            bv.Parent = root
        else
            bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
            bv.Velocity = Vector3.zero
        end
    else
        if bv then bv:Destroy() end
    end
end

local function SetMovePhysics(enable, keepFloat)
    isMovePhysicsActive = enable
    keepFloatActive = (keepFloat == true)

    if enable or keepFloatActive then
        Workspace.Gravity = 0
        local char = LocalPlayer.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                if hum.Sit then hum.Sit = false end
                if hum.PlatformStand then hum.PlatformStand = false end
                if hum:GetState() == Enum.HumanoidStateType.Physics then
                    hum:ChangeState(Enum.HumanoidStateType.GettingUp)
                end
            end
            local root = char:FindFirstChild("HumanoidRootPart")
            if root then
                root.Anchored = false
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
                EnsureFloatBV(root, true)
            end
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.Anchored = false
                    part.CanCollide = false
                end
            end
        end
    else
        cyborgHoldCF = nil
        Workspace.Gravity = DEFAULT_GRAVITY
        local char = LocalPlayer.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum and hum:GetState() == Enum.HumanoidStateType.Physics then
                hum:ChangeState(Enum.HumanoidStateType.GettingUp)
            end
            local root = char:FindFirstChild("HumanoidRootPart")
            if root then
                EnsureFloatBV(root, false)
                root.Anchored = false
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
            end
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") and CORE_COLLIDE_PARTS[part.Name] then
                    part.CanCollide = true
                end
            end
        end
    end
end

RunService.Stepped:Connect(function()
    if IsStopped() then return end
    if not (isMovePhysicsActive or keepFloatActive) then return end

    Workspace.Gravity = 0
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        if hum.Sit then hum.Sit = false end
        if hum.PlatformStand then hum.PlatformStand = false end
        if hum:GetState() == Enum.HumanoidStateType.Physics then
            hum:ChangeState(Enum.HumanoidStateType.GettingUp)
        end
    end
    local root = char:FindFirstChild("HumanoidRootPart")
    if root then
        if root.Anchored then root.Anchored = false end
        EnsureFloatBV(root, true)
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        if cyborgHoldCF and not activeTween and (root.Position - cyborgHoldCF.Position).Magnitude <= 20 then
            -- Tạo dao động vi mô 0.05 studs để Roblox liên tục replicate CFrame thật lên server
            local jitterY = math.sin(os.clock() * 8) * 0.05
            root.CFrame = cyborgHoldCF * CFrame.new(0, jitterY, 0)
        end
    end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            if part.Anchored then part.Anchored = false end
            if part.CanCollide then part.CanCollide = false end
        end
    end
end)

local function RecoverToVerifiedSpot()
    if activeTween then
        pcall(function() activeTween:Cancel() end)
        activeTween = nil
    end
    SetMovePhysics(false, false)
    local tStart = os.clock()
    local lastPos = GetRoot() and GetRoot().Position or nil
    local stableCount = 0

    while (os.clock() - tStart < 1.2) and not IsStopped() do
        task.wait(0.1)
        local root = GetRoot()
        if not root then break end
        root.Anchored = false
        if lastPos and (root.Position - lastPos).Magnitude < 2.5 then
            stableCount = stableCount + 1
            if stableCount >= 4 and (os.clock() - tStart >= 0.5) then
                break
            end
        else
            stableCount = 0
        end
        lastPos = root.Position
    end
end

local function SafeTween(destination, abortFn, keepFloatAfter)
    local externalHub = getgenv().V4Hub
    if externalHub and externalHub ~= "gear" then
        HopLowServer(false)
        return false
    end

    local speed = TWEEN_SPEED
    local maxRetries = 8

    for attempt = 1, maxRetries do
        if IsStopped() or (getgenv().V4Hub and getgenv().V4Hub ~= "gear") or (abortFn and abortFn()) then
            SetMovePhysics(false, keepFloatAfter)
            return false
        end

        local root = GetRoot()
        local hum  = GetHumanoid()
        if not (root and hum and hum.Health > 0) then
            SetMovePhysics(false, false)
            return false
        end

        if destination.Y < 4000 and (root.Position.Y > 4000 or IsInsideTemple()) then
            DebugWarn("TWEEN", "Đang ở trong Temple/Trial (Y=%.0f) -> Chặn tween ra ngoài & Reset ngay!", root.Position.Y)
            SetMovePhysics(false, false)
            ForceResetCharacter()
            return false
        end

        if activeTween then
            pcall(function() activeTween:Cancel() end)
            activeTween = nil
        end

        SetMovePhysics(true, keepFloatAfter)
        local startPos = root.Position
        local distance = (startPos - destination).Magnitude
        if distance <= 10 then
            root.CFrame = CFrame.new(destination)
            SetMovePhysics(false, keepFloatAfter)
            return true
        end

        local duration = distance / speed
        local tw = TweenService:Create(root, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = CFrame.new(destination)})
        activeTween = tw
        tw:Play()

        local twStartTime = os.clock()
        local lastCheckTime = twStartTime
        local lastCheckPos = startPos
        local minDistance = distance
        local rubberbandDetected = false

        while tw.PlaybackState == Enum.PlaybackState.Playing do
            if IsStopped() or (getgenv().V4Hub and getgenv().V4Hub ~= "gear") or (abortFn and abortFn()) then
                pcall(function() tw:Cancel() end)
                activeTween = nil
                SetMovePhysics(false, keepFloatAfter)
                return false
            end

            local curRoot, curHum = GetRoot(), GetHumanoid()
            if not (curRoot and curHum and curHum.Health > 0) then
                pcall(function() tw:Cancel() end)
                activeTween = nil
                SetMovePhysics(false, false)
                return false
            end

            local currentPos = curRoot.Position
            local currentDist = (currentPos - destination).Magnitude
            if currentDist <= 8 then
                break
            end

            if currentDist < minDistance then
                minDistance = currentDist
            end

            local elapsed = os.clock() - twStartTime
            local alpha = math.clamp(elapsed / duration, 0, 1)
            local expectedPos = startPos:Lerp(destination, alpha)

            if (currentDist - minDistance > 18) or (currentPos - expectedPos).Magnitude > 35 then
                rubberbandDetected = true
                DebugWarn("TWEEN", "Rubberbanding detected! Distance jump: %.1f", (currentDist - minDistance))
                break
            end

            if os.clock() - lastCheckTime >= 0.45 then
                local expectedStep = speed * (os.clock() - lastCheckTime)
                local actualStep = (currentPos - lastCheckPos).Magnitude
                local progress = (lastCheckPos - destination).Magnitude - currentDist
                if actualStep < expectedStep * 0.35 or progress < expectedStep * 0.35 then
                    rubberbandDetected = true
                    DebugWarn("TWEEN", "Stall detected! Recovering...")
                    break
                end
                lastCheckTime = os.clock()
                lastCheckPos = currentPos
            end

            task.wait(0.03)
        end

        if rubberbandDetected then
            RecoverToVerifiedSpot()
        else
            pcall(function() tw:Cancel() end)
            activeTween = nil
            root = GetRoot()
            if root and (root.Position - destination).Magnitude <= 20 then
                -- Đồng bộ vị trí thực với server để tránh lỗi Fake CFrame (client tới nơi nhưng server vẫn ở chỗ cũ)
                for step = 1, 3 do
                    if IsStopped() then break end
                    root = GetRoot()
                    if not root then break end
                    root.Anchored = false
                    root.CFrame = CFrame.new(destination + Vector3.new(0, (step % 2 == 0) and 0.05 or -0.05, 0))
                    root.AssemblyLinearVelocity = Vector3.new(0, 0.1, 0)
                    root.AssemblyAngularVelocity = Vector3.zero
                    task.wait(0.06)
                end
                SetMovePhysics(false, keepFloatAfter)
                task.wait(0.08)
                root = GetRoot()
                if root and (root.Position - destination).Magnitude <= 14 then
                    return true
                end
                DebugWarn("TWEEN", "Phát hiện Fake CFrame sau khi chạm đích (Lệch %.1f studs) -> Tween lại!", root and (root.Position - destination).Magnitude or 999)
            end
            RecoverToVerifiedSpot()
        end
    end

    SetMovePhysics(false, keepFloatAfter)
    return false
end

local function MoveToGreatTree()
    if getgenv().V4Hub and getgenv().V4Hub ~= "gear" then HopLowServer(false) return end
    if not InSea3() then return TravelToSea3() end
    ST.ph = "idle"
    local root = GetRoot()
    if root and (root.Position - GREAT_TREE_POS).Magnitude > 150 then
        local nearTemple = IsInsideTemple() or (root.Position.Y > 4000) or ((root.Position - TEMPLE_CENTER_POS).Magnitude <= 5000)
        if not nearTemple then
            for _, dPos in pairs(TEMPLE_DOORS) do
                if (root.Position - dPos).Magnitude <= 5000 then
                    nearTemple = true
                    break
                end
            end
        end
        if nearTemple then
            DebugLog("MOVE", "Đang ở trong Temple/Trial (Y=%.0f) -> Reset nhân vật để về Great Tree nhanh nhất!", root.Position.Y)
            if activeTween then
                pcall(function() activeTween:Cancel() end)
                activeTween = nil
            end
            SetMovePhysics(false, false)
            ForceResetCharacter()
            return
        end

        DebugLog("MOVE", "Moving character to Great Tree safe spot...")
        local abortForSupportMoon = nil
        if SUPPORTS_MAP[PlayerName] and ST.tr and SUPPORTS_MAP[PlayerName] ~= ST.tr then
            abortForSupportMoon = function()
                if ST.m > 0 and not moonRejectedShortMoon then return false end
                local othersNow = GetOthersStatus(25)
                local tJob, isReg, _, _, _, bJob = CoordinateMoonServer(othersNow, ST.tr)
                return (tJob ~= nil and tJob ~= game.JobId and isReg) or (bJob ~= nil and bJob ~= game.JobId)
            end
        end
        SafeTween(GREAT_TREE_POS, abortForSupportMoon, false)
    end
end

