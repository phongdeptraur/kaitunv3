-- 3. HÀM GHI ĐÈ LÊN BASE CONFIG REALKID HOP
-- ============================================================================
local function WriteHopConfig(overrides)
    -- 1. Giải mã Base Config chuẩn của RealKid Hop
    local cfg = HttpService:JSONDecode(BASE_HOP_JSON)

    -- 2. Ghi đè các tham số tùy chỉnh lên Base Config
    for k, v in pairs(overrides or {}) do
        cfg[k] = v
    end

    local path = "RealKidHop_" .. tostring(LocalPlayer.UserId) .. ".json"

    -- 3. Đọc file cũ nếu có để giữ lại danh sách server đã ghé (tránh hop lặp)
    if isfile and readfile and isfile(path) then
        local okR, raw = pcall(readfile, path)
        if okR and type(raw) == "string" then
            local okD, old = pcall(function() return HttpService:JSONDecode(raw) end)
            if okD and type(old) == "table" and old.Destination == cfg.Destination
                and type(old.VisitedJobs) == "table" and next(old.VisitedJobs) ~= nil then
                cfg.VisitedJobs = old.VisitedJobs
            end
        end
    end

    -- Đánh dấu JobId server hiện tại
    if not cfg.VisitedJobs then cfg.VisitedJobs = {} end
    cfg.VisitedJobs[tostring(game.JobId)] = true

    -- 4. Lưu toàn bộ Base Config đã chỉnh sửa ra file
    if writefile then
        writefile(path, HttpService:JSONEncode(cfg))
    end
end

-- ============================================================================
-- 4. PRE-TWEEN ĐẾN CAKE LOAF (190 STUD/S + NOCLIP)
-- ============================================================================
local function PreTweenCakeLoaf()
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local hum  = char:WaitForChild("Humanoid")
    local hrp  = char:WaitForChild("HumanoidRootPart")

    if hum.Sit then
        hum.Sit = false
        hum:ChangeState(Enum.HumanoidStateType.Jumping)
        task.wait(0.2)
    end

    local dist = (hrp.Position - POS_CAKE_LOAF).Magnitude
    if dist <= 15 then return true end

    print(("[AutoFrag] Pre-Tween đến Cake Loaf (khoảng cách: %.0f studs)..."):format(dist))

    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    bv.Velocity = Vector3.zero
    bv.Parent = hrp

    local noclip = RunService.Stepped:Connect(function()
        if char and char.Parent then
            for _, p in ipairs(char:GetDescendants()) do
                if p:IsA("BasePart") and p.CanCollide then p.CanCollide = false end
            end
        end
    end)

    local tw = TweenService:Create(hrp, TweenInfo.new(dist / TWEEN_SPEED, Enum.EasingStyle.Linear), { CFrame = CFrame.new(POS_CAKE_LOAF) })
    tw:Play()

    while tw.PlaybackState == Enum.PlaybackState.Playing do
        if not char.Parent or hum.Health <= 0 or (hrp.Position - POS_CAKE_LOAF).Magnitude <= 15 then
            break
        end
        task.wait(0.1)
    end

    pcall(function() tw:Cancel() end)
    pcall(function() noclip:Disconnect() end)
    pcall(function() bv:Destroy() end)
    return (hrp.Position - POS_CAKE_LOAF).Magnitude <= 20
end

