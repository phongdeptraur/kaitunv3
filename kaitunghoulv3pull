local function GetEctoplasmCount(force)
    if not force and (os.clock() - lastEctoInvCheck) < 2.5 then
        return cachedEctoCount
    end
    lastEctoInvCheck = os.clock()

    local ecto = nil
    pcall(function()
        local IR = require(ReplicatedStorage:WaitForChild("ItemReplicationService", 2))
        local KEYS = require(ReplicatedStorage.ItemReplicationService:WaitForChild("KEYS", 2))
        local ItemId = require(ReplicatedStorage:WaitForChild("Economy", 2):WaitForChild("ItemId", 2))
        local t0 = os.clock()
        while not IR.IsInitialized and (os.clock() - t0 < 2) do task.wait(0.1) end
        ecto = 0
        for _, item in pairs(IR:GetItems(KEYS.QUANTITY)) do
            local ok, data = pcall(function() return ItemId.getDataFromId(item.ItemId):unwrap() end)
            if ok and data and tostring(data.StorageKey or data.DisplayName or data.Name or ""):lower():find("ectoplasm") then
                ecto = item.Value or 0
                break
            end
        end
    end)

    if ecto == nil then
        pcall(function()
            local inv = CommF:InvokeServer("getInventory")
            if type(inv) == "table" then
                ecto = 0
                for _, v in pairs(inv) do
                    if type(v) == "table" and tostring(v.Name or ""):lower():find("ectoplasm") then
                        ecto = v.Count or 0
                        break
                    end
                end
            end
        end)
    end

    if ecto ~= nil then
        cachedEctoCount = tonumber(ecto) or 0
    end
    return cachedEctoCount
end

