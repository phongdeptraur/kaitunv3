    if not eps then return {} end
    for _, ep in ipairs(eps) do
        if Stopped() then return {} end
        local url = NH_BASE_URL .. "/" .. ep
        local raw = nil
        if request_ then
            for _ = 1, 2 do
                local ok, res = pcall(request_, {
                    Url = url, Method = "GET",
                    Headers = {
                        ["User-Agent"] = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/122.0.0.0 Safari/537.36",
                        ["Accept"] = "application/json",
                        ["Cache-Control"] = "no-cache"
                    }
                })
                if ok and res then
                    local code = res.StatusCode or res.status or (res.Success and 200 or 0)
                    if code == 200 then raw = res.Body or res.body or (type(res) == "string" and res); break
                    elseif code == 429 then SleepCheck(0.5) end
                end
            end
        end
        if (not raw or raw == "") and game.HttpGet then
            local ok, res = pcall(function() return game:HttpGet(url) end)
            if ok and res and res ~= "" then raw = res end
        end
        if raw and raw ~= "" then
            local okJ, payload = pcall(HttpService.JSONDecode, HttpService, raw)
            if okJ and type(payload) == "table" then
                local list = payload.data or payload.servers or payload.Servers or payload
                local out = {}
                if type(list) == "table" then
                    for _, e in ipairs(list) do
                        if type(e) == "table" and (e.JobId or e.job_id) then
                            local jid = DecryptNHJobId(e.JobId or e.job_id)
                            if jid and jid ~= "" then
                                table.insert(out, {
                                    JobId = tostring(jid),
                                    Players = tonumber(e.Players or e.players or e.count) or 0,
                                    PlaceId = tonumber(e.PlaceId or e.placeId) or game.PlaceId,
                                    Sea = tonumber(e.Sea or e.sea) or 3,
                                    Idx = #out + 1,
                                })
                            end
                        end
                    end
                end
                if #out > 0 then return out end
            end
        end
    end
    return {}
end

