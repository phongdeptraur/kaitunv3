local function GetCoopWhitelistTarget(whitelistUids)
    local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myHRP then return nil end
    local bestTarget, bestDist = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and whitelistUids[tostring(p.UserId)] == true then
            local ch = p.Character
            local tHRP = ch and ch:FindFirstChild("HumanoidRootPart")
            if tHRP and (tHRP.Position - POS_COOP_HELP).Magnitude <= 100 then
                if IsLockedTargetValid(p, ch) and not IsInSafeZone(p) then
                    local d = (tHRP.Position - myHRP.Position).Magnitude
                    if d < bestDist then
                        bestTarget, bestDist = p, d
                    end
                end
            end
        end
    end
    return bestTarget
end

local function FinishGhoulV3ToSea3()
    StopPvPTween()
