local function IsCoopServerQualified(missingClones)
    if GetSea() ~= 2 then return false end
    local curPlayers = #Players:GetPlayers()
    if curPlayers > 7 then return false end
    if (12 - curPlayers) < (missingClones + 1) then return false end
    return true
end

local function RunCoopHost(isBackHelp)
    StopPvPTween()
    if GetSea() ~= 2 then
        WriteGhoulRoomAsHost("PREPARING", "", isBackHelp)
        TravelToSea(2)
        return
    end
    if getgenv()._RealKidMainRunning or getgenv()._RealKidHopRunning then
        WriteGhoulRoomAsHost("PREPARING", "", isBackHelp)
        HopCoopLow(2)
        return
    end

    EnsureTeam("Marines")
    if Stopped() then return end

    local roomState = "PREPARING"
    local stableSince = 0
    local lastFailScan = 0

    WriteGhoulRoomAsHost("PREPARING", "", isBackHelp)

    while not Stopped() do
        local topo
        if isBackHelp then
            local stillNeeded, t = SyncBackHelpHost(nil)
            topo = t
            if not stillNeeded then
                CleanupMovement()
                SetStatus(("Back-Help [%s | STT 0/0]: Hoàn tất! Quay lại Sea 3..."):format(LocalPlayer.Name))
                TravelToSea(3)
                return
            end
        else
            topo = SyncV3SessionEntry({ needsBackHelp = false })
            if HasRaceV3() then
                CleanupMovement()
                ClearGhoulRoomIfOwner()
                return
            end
            -- Nếu tất cả Clone đã xong V3 và chỉ còn lại mình Host cần V3 -> chuyển sang gọi Back-Help
            if #topo.activeV3List <= 1 then
                CleanupMovement()
                ClearGhoulRoomIfOwner()
                MyPresenceState.needsBackHelp = true
                MyPresenceState.readyAtHelp = false
                FlushMyPresenceFile(false)
                SetStatus(("Host [%s]: Chỉ còn 1 mình cần V3 -> Chuyển sang gọi Back-Help..."):format(LocalPlayer.Name))
                return
            end
            if topo.myRole ~= "host" then
                CleanupMovement()
                return
            end
        end

        local clones = topo.clones or {}
        local totalClones = #clones
        local helperTag = ("%s [%s | STT 0/%d]"):format(isBackHelp and "Back-Help" or "Helper", LocalPlayer.Name, totalClones)

        local missingClones = 0
        local cloneReportedFail = false
        local curJob = tostring(game.JobId)
        for _, c in ipairs(clones) do
            if tostring(c.jobId) ~= curJob then
                missingClones = missingClones + 1
            end
            if tostring(c.failedJob or "") == curJob then
                cloneReportedFail = true
            end
        end

        -- Sau mỗi 3s kiểm tra xem có Clone nào báo TeleportInitFailed với server hiện tại không
        if cloneReportedFail and (os.clock() - lastFailScan) >= 3.0 then
            lastFailScan = os.clock()
            CleanupMovement()
            roomState = "PREPARING"
            stableSince = 0
            WriteGhoulRoomAsHost("PREPARING", "", isBackHelp)
            SetStatus(("%s: Clone báo lỗi join server -> Đổi sang PREPARING & Hop server mới!"):format(helperTag))
            HopCoopLow(math.max(missingClones, 1))
            return
        end

        -- PHA 1: PREPARING (Kiểm tra curPlayers <= 7 và 12 - curPlayers >= missingClones + 1, ổn định 3s)
        if roomState == "PREPARING" then
            if not IsCoopServerQualified(missingClones) then
                CleanupMovement()
                WriteGhoulRoomAsHost("PREPARING", "", isBackHelp)
                SetStatus(("%s [PREPARING]: Server %d/12 (thiếu %d Clone) chưa đạt chuẩn -> Hop server vắng..."):format(helperTag, #Players:GetPlayers(), missingClones))
                HopCoopLow(math.max(missingClones, 1))
                return
            end

            if stableSince == 0 then
                stableSince = os.clock()
                WriteGhoulRoomAsHost("PREPARING", "", isBackHelp)
            end

            local waited = os.clock() - stableSince
            if waited < 3.0 then
                SetStatus(("%s [PREPARING]: Đã đáp server đạt chuẩn (%d/12), ổn định %.1f/3.0s..."):format(helperTag, #Players:GetPlayers(), waited))
                SleepCheck(0.5)
                continue
            end

            -- Đủ 3s ổn định -> Chốt PHA 2: OPEN
            roomState = "OPEN"
            WriteGhoulRoomAsHost("OPEN", curJob, isBackHelp)
            SetStatus(("%s [OPEN]: Đã mở phòng %s cho %d Clone hội quân!"):format(helperTag, curJob:sub(1, 8), totalClones))
        else
            -- Đang ở PHA OPEN: nếu server bị người lạ tràn vào khiến thiếu slot cho Clone chưa vào -> quay về PREPARING
            if missingClones > 0 and (12 - #Players:GetPlayers()) < missingClones then
                CleanupMovement()
                roomState = "PREPARING"
                stableSince = 0
                WriteGhoulRoomAsHost("PREPARING", "", isBackHelp)
                SetStatus(("%s [OPEN -> PREPARING]: Server đầy (%d/12) trong lúc Clone chưa vào -> Hop mới!"):format(helperTag, #Players:GetPlayers()))
                HopCoopLow(math.max(missingClones, 1))
                return
            end
            WriteGhoulRoomAsHost("OPEN", curJob, isBackHelp)
        end

        local char, _, myHRP = WaitAlive()
        if Stopped() or not char then break end
        if GetCurrentTeamName() ~= "Marines" then
            EnsureTeam("Marines")
        end

        if not ActiveNoclip then
            ActiveNoclip = RunService.Stepped:Connect(function()
                if Stopped() then return end
                local ch = LocalPlayer.Character
                local h = ch and ch:FindFirstChildOfClass("Humanoid")
                local r = ch and ch:FindFirstChild("HumanoidRootPart")
                if ch and ch.Parent then
                    for _, p in ipairs(ch:GetDescendants()) do
                        if p:IsA("BasePart") and p.CanCollide then p.CanCollide = false end
                    end
                end
                if h and h.Health > 0 and h.Sit then h.Sit = false end
                if r and r.Parent then
                    EnsureAntiGravity(r)
                    r.AssemblyLinearVelocity = Vector3.zero
                    r.AssemblyAngularVelocity = Vector3.zero
                end
            end)
        end

        local distToHelp = (POS_COOP_HELP - myHRP.Position).Magnitude
        if distToHelp > 5 then
            MyPresenceState.readyAtHelp = false
            SetStatus(("%s [OPEN]: Đang bay tới điểm Help (%.0f stud)..."):format(helperTag, distToHelp))
            if not ActiveTween or ActiveTween.PlaybackState ~= Enum.PlaybackState.Playing then
                CancelActiveTween()
                ActiveTween = TweenService:Create(myHRP, TweenInfo.new(math.max(distToHelp / TWEEN_SPEED, 0.05), Enum.EasingStyle.Linear), { CFrame = CFrame.new(POS_COOP_HELP) })
                ActiveTween:Play()
            end
            SleepCheck(0.35)
        else
            CancelActiveTween()
            myHRP.CFrame = CFrame.new(POS_COOP_HELP)
            EnsureMyPvPEnabled()
            MyPresenceState.readyAtHelp = true
            SetStatus(("%s [OPEN]: Sẵn sàng tại điểm Help (PvP ON) | Clones: %d"):format(helperTag, totalClones))
            SleepCheck(0.8)
        end
    end
    CleanupMovement()
end

