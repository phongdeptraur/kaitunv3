local function EnsurePvPTweenLoop(getTargetFn)
    SetupSilentAimHooks()

    if not ActiveNoclip then
        ActiveNoclip = RunService.Stepped:Connect(function()
            if Stopped() then return end
            local myChar = LocalPlayer.Character
            getgenv()._AutoGhoulMyChar = myChar
            local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
            local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
            if myChar and myChar.Parent then
                for _, p in ipairs(myChar:GetDescendants()) do
                    if p:IsA("BasePart") and p.CanCollide then p.CanCollide = false end
                end
            end
            if myHum and myHum.Health > 0 then
                if myHum.Sit then myHum.Sit = false end
                pcall(function()
                    myHum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
                    myHum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
                end)
            end
            if myHRP and myHRP.Parent then
                EnsureAntiGravity(myHRP)
                myHRP.AssemblyLinearVelocity = Vector3.zero
                myHRP.AssemblyAngularVelocity = Vector3.zero
            end
        end)
    end

    if ActivePvPConn then return end
    local lastTween = 0
    ActivePvPConn = RunService.Heartbeat:Connect(function()
        if Stopped() then StopPvPTween() return end
        local cam = workspace.CurrentCamera
        getgenv()._AutoGhoulAimCam = cam
        getgenv()._AutoGhoulAimCamPos = cam and cam.CFrame.Position or nil

        local target = getTargetFn()
        if not target then
            ClearAimState()
            CancelActiveTween()
            return
        end

        local myChar = LocalPlayer.Character
        local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
        local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if not (myHum and myHum.Health > 0 and myHRP) then
            ClearAimState()
            CancelActiveTween()
            return
        end

        if typeof(target) == "Vector3" then
            ClearAimState()
            local dist = (target - myHRP.Position).Magnitude
            if dist <= 4 then
                CancelActiveTween()
                return
            end
            if not ActiveTween or ActiveTween.PlaybackState ~= Enum.PlaybackState.Playing then
                CancelActiveTween()
                local dur = math.max(dist / TWEEN_SPEED, 0.05)
                ActiveTween = TweenService:Create(myHRP, TweenInfo.new(dur, Enum.EasingStyle.Linear), { CFrame = CFrame.new(target) })
                ActiveTween:Play()
            end
            return
        end

        if not target.Parent then
            ClearAimState()
            CancelActiveTween()
            return
        end

        local tChar = target.Character
        local tHRP = tChar and tChar:FindFirstChild("HumanoidRootPart")
        local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
        if not (tHRP and tHum and tHum.Health > 0) then
            ClearAimState()
            CancelActiveTween()
            return
        end

        if not hoverAboveMode then
            getgenv()._AutoGhoulAimHRP = tHRP
            getgenv()._AutoGhoulAimPos = tHRP.Position
        else
            getgenv()._AutoGhoulAimHRP = nil
            getgenv()._AutoGhoulAimPos = nil
        end

        if (tHRP.Position - myHRP.Position).Magnitude > MAX_PVP_DIST then
            CancelActiveTween()
            return
        end

        local goalPos = hoverAboveMode
            and (tHRP.Position + Vector3.new(0, 60, 0))
            or (tHRP.CFrame * CFrame.new(0, 0.5, 2)).Position
        local goalDist = (goalPos - myHRP.Position).Magnitude

        if goalDist <= 3 then
            CancelActiveTween()
            local lookAt = Vector3.new(tHRP.Position.X, myHRP.Position.Y, tHRP.Position.Z)
            if (lookAt - myHRP.Position).Magnitude > 0.1 then
                myHRP.CFrame = CFrame.new(myHRP.Position, lookAt)
            end
            return
        end

        local now = os.clock()
        if (now - lastTween) >= 0.1 then
            lastTween = now
            CancelActiveTween()
            local dur = math.max(goalDist / TWEEN_SPEED, 0.02)
            local lookAt = Vector3.new(tHRP.Position.X, goalPos.Y, tHRP.Position.Z)
            local goalCF = (not hoverAboveMode and (lookAt - goalPos).Magnitude > 0.1)
                and CFrame.new(goalPos, lookAt)
                or CFrame.new(goalPos)
            ActiveTween = TweenService:Create(myHRP, TweenInfo.new(dur, Enum.EasingStyle.Linear), { CFrame = goalCF })
            ActiveTween:Play()
        end
    end)
end

