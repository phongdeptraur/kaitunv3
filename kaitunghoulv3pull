local EctoFarmJoinEpoch = os.time()

local function ReadEctoAntiRaw()
    if not (isfile and readfile and isfile(ECTO_ANTI_FILE)) then return {}, true end
    for _ = 1, 4 do
        local okR, raw = pcall(readfile, ECTO_ANTI_FILE)
        if okR and type(raw) == "string" then
            if raw:match("^%s*$") then return {}, true end
            local okD, data = pcall(function() return HttpService:JSONDecode(raw) end)
            if okD and type(data) == "table" then return data, true end
        end
        task.wait(0.03)
    end
    return nil, false
end

local function CleanExpiredEctoEntries(tbl, now)
    local cleaned = {}
    local changed = false
    for uid, info in pairs(tbl or {}) do
        if type(info) == "table" then
            local ts = tonumber(info.updatedAt) or 0
            local ttl = (info.state == "reserved") and 25 or ECTO_ANTI_TTL
            if ts > 0 and (now - ts) <= ttl then
                cleaned[tostring(uid)] = info
            else
                changed = true
            end
        else
            changed = true
        end
    end
    return cleaned, changed
end

local function UpdateEctoAntiCollision(mutatorFn)
    local raw, ok = ReadEctoAntiRaw()
    if not ok or not raw then return nil end
    local now = os.time()
    local cleaned, changed = CleanExpiredEctoEntries(raw, now)
    if mutatorFn then
        mutatorFn(cleaned, now)
        changed = true
    end
    if changed and writefile then
        pcall(writefile, ECTO_ANTI_FILE, HttpService:JSONEncode(cleaned))
    end
    return cleaned
end

RemoveEctoAntiCollision = function()
    UpdateEctoAntiCollision(function(tbl)
        tbl[tostring(LocalPlayer.UserId)] = nil
    end)
end

local function GetBlockedEctoJobs()
    local blocked = {}
    local raw, ok = ReadEctoAntiRaw()
    if not ok or not raw then return blocked end
    local now = os.time()
    local cleaned, changed = CleanExpiredEctoEntries(raw, now)
    if changed and writefile then
        pcall(writefile, ECTO_ANTI_FILE, HttpService:JSONEncode(cleaned))
    end
    local myUid = tostring(LocalPlayer.UserId)
    for uid, info in pairs(cleaned) do
        if uid ~= myUid then
