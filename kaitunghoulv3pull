-- Luật "Sticky Host" + Phân hàng đợi Clone (acc mới vào xếp cuối hàng đợi)
local function ResolveStickyRoomTopology(sessions)
    local activeV3List = {}
    local activeBackHelpHost = nil

    for uid, e in pairs(sessions) do
        if e.isBackHelp == true and e.needsV3 == false then
            if not activeBackHelpHost or (tonumber(uid) or math.huge) < (tonumber(activeBackHelpHost.userId) or math.huge) then
                activeBackHelpHost = e
            end
        elseif e.needsV3 == true then
            table.insert(activeV3List, e)
        end
    end

    table.sort(activeV3List, function(a, b)
        local ua = tonumber(a.userId) or math.huge
        local ub = tonumber(b.userId) or math.huge
        if ua ~= ub then return ua < ub end
        return tostring(a.userId) < tostring(b.userId)
    end)

    local room = ReadGhoulRoom(sessions)
    local hostUid = nil
    local isBackHelpRoom = false

    -- 1. Nếu đã có Sticky Room và Host vẫn còn sống -> tuyệt đối giữ nguyên Host, cấm cướp quyền
    if room then
        hostUid = tostring(room.hostUid)
        isBackHelpRoom = (room.isBackHelp == true)
    elseif activeBackHelpHost then
        hostUid = tostring(activeBackHelpHost.userId)
        isBackHelpRoom = true
    elseif #activeV3List >= 2 then
        -- Chưa có phòng hoặc Host cũ đã offline/xong -> bầu Host theo UserId nhỏ nhất
        hostUid = tostring(activeV3List[1].userId)
        isBackHelpRoom = false
    end

    local clones = {}
    for _, e in ipairs(activeV3List) do
        if tostring(e.userId) ~= hostUid then
            table.insert(clones, e)
        end
    end

    -- Acc vào trước giữ STT đầu; acc mới xong V2 gia nhập sau có v3QueueAt lớn hơn -> tự động xếp STT cuối
    table.sort(clones, function(a, b)
        local qa = tonumber(a.v3QueueAt) or math.huge
        local qb = tonumber(b.v3QueueAt) or math.huge
        if qa ~= qb then return qa < qb end
        local ua = tonumber(a.userId) or math.huge
        local ub = tonumber(b.userId) or math.huge
        if ua ~= ub then return ua < ub end
        return tostring(a.userId) < tostring(b.userId)
    end)

    local sttMap = {}
    local whitelistUids = {}
    if hostUid then whitelistUids[hostUid] = true end
    for idx, c in ipairs(clones) do
        c.stt = idx
        sttMap[tostring(c.userId)] = idx
        whitelistUids[tostring(c.userId)] = true
    end

    local myRole = "solo"
    if hostUid then
        if MY_UID == hostUid then
            myRole = "host"
        elseif sttMap[MY_UID] then
            myRole = "clone"
        end
    end

    return {
        room = room,
        hostUid = hostUid,
        hostEntry = hostUid and sessions[hostUid] or nil,
        isBackHelp = isBackHelpRoom,
        activeV3List = activeV3List,
        clones = clones,
        sttMap = sttMap,
        whitelistUids = whitelistUids,
        myRole = myRole,
        mySTT = sttMap[MY_UID] or 1,
        totalClones = #clones,
    }
end

local function SyncV3SessionEntry(opts)
    opts = opts or {}
    MyPresenceState.phase = "v3"
    MyPresenceState.needsV3 = true
    MyPresenceState.isBackHelp = false
    if opts.needsBackHelp ~= nil then MyPresenceState.needsBackHelp = opts.needsBackHelp end
    if opts.readyAtHelp ~= nil then MyPresenceState.readyAtHelp = opts.readyAtHelp end
    MyPresenceState.v3QueueAt = MyV3QueueAt
    FlushMyPresenceFile(false)

    local sessions = ReadAllGhoulSessions()
    sessions[MY_UID] = MyPresenceState
    return ResolveStickyRoomTopology(sessions), sessions
end

-- Quy trình Back-Help 1-kèm-1 không xung đột (ưu tiên acc xong Pull Lever + UserId nhỏ nhất, xác nhận 0.3s)
local lastBhCheck = 0
local function CheckAndClaimBackHelp()
    local nowClock = os.clock()
    if (nowClock - lastBhCheck) < 2.0 then return false end
    lastBhCheck = nowClock

    local sessions = ReadAllGhoulSessions()
    local room = ReadGhoulRoom(sessions)
    if room and room.isBackHelp then
        return tostring(room.hostUid) == MY_UID
    end

    local existingBhUid = nil
    local loneV3Entry = nil
    local v3Count = 0
    local idleSea3Candidates = {}

    for uid, e in pairs(sessions) do
        if e.isBackHelp == true and e.needsV3 == false then
            if not existingBhUid or (tonumber(uid) or math.huge) < (tonumber(existingBhUid) or math.huge) then
                existingBhUid = uid
            end
        elseif e.needsV3 == true then
            v3Count = v3Count + 1
            loneV3Entry = e
        elseif uid ~= MY_UID and e.needsV3 == false and e.sea == 3 and e.phase == "idle" then
            table.insert(idleSea3Candidates, {
                uid = uid,
                num = tonumber(uid) or math.huge,
                leverPulled = (e.leverPulled == true),
            })
        end
    end

    if existingBhUid then
        return existingBhUid == MY_UID
    end

    if v3Count ~= 1 or not loneV3Entry or loneV3Entry.needsBackHelp ~= true then
        return false
    end

    if GetSea() ~= 3 then return false end

    table.insert(idleSea3Candidates, {
        uid = MY_UID,
        num = tonumber(MY_UID) or math.huge,
        leverPulled = IsLeverPulled(),
    })

    table.sort(idleSea3Candidates, function(a, b)
        if a.leverPulled ~= b.leverPulled then return a.leverPulled end
        if a.num ~= b.num then return a.num < b.num end
        return a.uid < b.uid
    end)

    if not idleSea3Candidates[1] or idleSea3Candidates[1].uid ~= MY_UID then
        return false
    end

    -- Ghi file cá nhân isBackHelp = true -> đợi 0.3s đọc lại để xác nhận là backHelpUid duy nhất
    MyPresenceState.phase = "backhelp"
    MyPresenceState.needsV3 = false
    MyPresenceState.needsBackHelp = false
    MyPresenceState.isBackHelp = true
    MyPresenceState.readyAtHelp = false
    FlushMyPresenceFile(false)

    task.wait(0.3)
    if Stopped() then return false end

    local verifySessions = ReadAllGhoulSessions()
    local winners = {}
    for uid, e in pairs(verifySessions) do
        if e.isBackHelp == true and e.needsV3 == false then
            table.insert(winners, {
                uid = uid,
                num = tonumber(uid) or math.huge,
                leverPulled = (e.leverPulled == true),
            })
        end
    end
    table.sort(winners, function(a, b)
        if a.leverPulled ~= b.leverPulled then return a.leverPulled end
        if a.num ~= b.num then return a.num < b.num end
        return a.uid < b.uid
    end)

    if winners[1] and winners[1].uid == MY_UID then
        return true
    end

    -- Nếu có acc ưu tiên hơn cùng nhận -> tự rút lui
    MyPresenceState.phase = "idle"
    MyPresenceState.isBackHelp = false
    FlushMyPresenceFile(false)
    return false
end

local function SyncBackHelpHost(readyAtHelpFlag)
    MyPresenceState.phase = "backhelp"
    MyPresenceState.needsV3 = false
    MyPresenceState.needsBackHelp = false
    MyPresenceState.isBackHelp = true
    if readyAtHelpFlag ~= nil then MyPresenceState.readyAtHelp = readyAtHelpFlag end
    FlushMyPresenceFile(false)

    local sessions = ReadAllGhoulSessions()
    sessions[MY_UID] = MyPresenceState
    local topo = ResolveStickyRoomTopology(sessions)
    local stillNeeded = (#topo.activeV3List >= 1) and (topo.hostUid == MY_UID)
    if not stillNeeded then
        MyPresenceState.phase = "idle"
        MyPresenceState.isBackHelp = false
        MyPresenceState.readyAtHelp = false
        ClearGhoulRoomIfOwner()
        FlushMyPresenceFile(false)
    end
    return stillNeeded, topo
end

-- Phân tích tình hình (team hiện tại + nhiệm vụ cần team gì) trước khi execute
local function AnalyzeRequiredTeam()
    if HasRaceV3() then
        local sessions = ReadAllGhoulSessions()
        local room = ReadGhoulRoom(sessions)
        if (room and room.isBackHelp and tostring(room.hostUid) == MY_UID) or MyPresenceState.isBackHelp then
            return "Marines"
        end
        return nil
    end

    if GetRace() == "Ghoul" and HasRaceV2() then
        local sessions = ReadAllGhoulSessions()
        sessions[MY_UID] = {
            userId = LocalPlayer.UserId,
            name = LocalPlayer.Name,
            needsV3 = true,
            v3QueueAt = MyV3QueueAt,
            updatedAt = os.time(),
        }
        local topo = ResolveStickyRoomTopology(sessions)
        if topo.myRole == "host" then
            return "Marines"
        elseif topo.myRole == "clone" then
            return (topo.mySTT == 1) and "Pirates" or "Marines"
        else
            return "Pirates"
        end
    end

    return nil
end

