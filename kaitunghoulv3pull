local function GetCurrentTeamName()
    local t = LocalPlayer.Team
    if not t or t.Name == "Neutral" then return nil end
    return t.Name
end

local function EnsureTeam(preferTeam)
    if Stopped() then return end
    local curTeam = GetCurrentTeamName()

    -- Nếu nhiệm vụ không ép phe cụ thể và đã ở Pirates hoặc Marines -> giữ nguyên team hiện tại
    if not preferTeam then
        if curTeam == "Pirates" or curTeam == "Marines" then
            WaitAlive()
            return
        end
        preferTeam = "Marines"
    end

    -- Nếu đã đúng team cần thiết -> tuyệt đối không chọn lại
    if curTeam == preferTeam then
        WaitAlive()
        return
    end

    SetStatus(("Đổi team 1 lần (%s -> %s)..."):format(tostring(curTeam or "Chưa có team"), preferTeam))
    pcall(function() CommF:InvokeServer("SetTeam", preferTeam) end)

    local t0 = os.clock()
    while not Stopped() and (os.clock() - t0) < 3.0 do
        if GetCurrentTeamName() == preferTeam then break end
        task.wait(0.1)
    end
    WaitAlive()
    SleepCheck(0.4)
end

local function TravelToSea(targetSea)
    while not Stopped() and GetSea() ~= targetSea do
        SetStatus("Đang chuyển sang Sea " .. tostring(targetSea) .. "...")
        if targetSea == 2 then
            pcall(function() CommF:InvokeServer("TravelDressrosa") end)
        elseif targetSea == 3 then
            pcall(function() CommF:InvokeServer("TravelZou") end)
            if not SleepCheck(3) then return false end
            if GetSea() ~= 3 then pcall(function() CommF:InvokeServer("TravelDressrosa") end) end
        end
        if not SleepCheck(4) then return false end
    end
    return not Stopped() and GetSea() == targetSea
end

