            end
        end

        UpdateEctoAntiCollision(function(tbl, now)
            tbl[myUid] = {
                userId = LocalPlayer.UserId,
                name = LocalPlayer.Name,
                jobId = curJob,
                reservedJobId = "",
                joinedAt = EctoFarmJoinEpoch,
                state = "active",
                updatedAt = now,
            }
        end)

        task.spawn(function()
            local needHopCollision = false
            while not Stopped() and GetRace() ~= "Ghoul" and GetEctoplasmCount(false) < 100 do
                UpdateEctoAntiCollision(function(tbl, now)
                    for uid, info in pairs(tbl) do
                        if uid ~= myUid and tostring(info.jobId) == curJob and info.state == "active" then
                            local otherJoined = tonumber(info.joinedAt) or 0
                            local otherNum = tonumber(uid) or math.huge
                            if otherJoined < EctoFarmJoinEpoch or (otherJoined == EctoFarmJoinEpoch and myNum > otherNum) then
                                needHopCollision = true
                            end
                        end
                    end
                    if not needHopCollision then
                        tbl[myUid] = {
                            userId = LocalPlayer.UserId,
                            name = LocalPlayer.Name,
                            jobId = curJob,
                            reservedJobId = "",
                            joinedAt = EctoFarmJoinEpoch,
                            state = "active",
                            updatedAt = now,
                        }
                    end
                end)

                if needHopCollision then
                    RemoveEctoAntiCollision()
                    SetStatus("Phát hiện Clone khác vào trùng server farm Ectoplasm -> Hop Low né!")
                    HopEctoLow()
                    return
                end
                task.wait(5)
            end
            RemoveEctoAntiCollision()
        end)
    else
        RemoveEctoAntiCollision()
    end

    if not Stopped() and LaunchRealKidMain({ auto_ghoul_v1 = true }, "Auto Ghoul V1 (Sea 2)") then
        while not Stopped() and task.wait(2) do
            local curEcto = GetEctoplasmCount(false)
            SetStatus(("Đang lấy Ghoul V1 (Ecto: %d/100) | Race: %s"):format(curEcto, GetRace()))
            if curEcto >= 100 then
                RemoveEctoAntiCollision()
            end
            if GetRace() == "Ghoul" then
                RemoveEctoAntiCollision()
                SetStatus("Đã có tộc Ghoul! Hop Low để refresh...")
                HopLow()
                return
            end
        end
    end
    return
end
if Stopped() then return end
RemoveEctoAntiCollision()

-- 2. ĐÃ LÀ GHOUL -> CHECK V2, V3 & BELI, FRAGMENT
local hasV3 = HasRaceV3()
if not hasV3 then
    local okW, wStat = pcall(function() return CommF:InvokeServer("Wenlocktoad", "1") end)
    if okW and wStat == -2 then hasV3 = true end
end

local hasV2 = HasRaceV2()

if not hasV3 then
    local reqBeli = hasV2 and 2000000 or 2500000
    local reqFrag = 10000

    if GetBeli() < reqBeli then
        if GetSea() ~= 3 then TravelToSea(3) end
        if not Stopped() and LaunchRealKidMain({ Chest = true }, ("Farm Chest lấy Beli (%d/%d)"):format(GetBeli(), reqBeli)) then
            while not Stopped() and task.wait(1.5) do
                SetStatus(("Đang farm Beli: %d / %d"):format(GetBeli(), reqBeli))
                if GetBeli() >= reqBeli then
                    SetStatus("Đã đủ Beli! Hop Low để refresh...")
                    HopLow()
                    return
                end
            end
        end
        return
    end

    if GetFragments() < reqFrag then
        RunSea3BossTarget(
            DESTINATIONS.CAKE_PRINCE,
            POS_CAKE_PRINCE,
            function() return ("Đang farm Fragment (Cake Prince): %d / %d"):format(GetFragments(), reqFrag) end,
            function()
                if GetFragments() >= reqFrag then
                    SetStatus("Đã đủ 10k Fragment! Hop Low để refresh...")
                    HopLow()
                    return true
                end
                return false
            end
        )
        return
    end

    -- 2A. CHƯA CÓ GHOUL V2 -> TP SEA 2 CHẠY REALKID MAIN ĐỂ UP V2
    if GetSea() ~= 2 then TravelToSea(2) end
    if Stopped() then return end

    if not hasV2 then
        if not HasBlueFlower() and not IsNight() then
            SetStatus(("Đang up Ghoul V2 nhưng trời sáng (Clock: %.1f) -> Hop Low tìm trời tối..."):format(Lighting.ClockTime))
            HopLow()
            return
        end

        if LaunchRealKidMain({ AutoUpgradeRaceV3 = true }, "Auto Ghoul V2 (Sea 2)") then
            while not Stopped() and task.wait(2) do
                if HasRaceV2() then
                    MyV3QueueAt = os.time()
                    local sessions = ReadAllGhoulSessions()
                    local room = ReadGhoulRoom(sessions)
                    local otherActive = 0
                    for uid, e in pairs(sessions) do
                        if uid ~= MY_UID and e.needsV3 == true then otherActive = otherActive + 1 end
                    end
                    if otherActive > 0 or room ~= nil then
                        SetStatus(("Đã xong Ghoul V2! Vào cuối hàng đợi Co-op V3..."):format())
                        RunGhoulV3Phase()
                    else
                        SetStatus("Đã xong Ghoul V2! Chuyển sang pha V3...")
                        RunGhoulV3Phase()
                    end
                    return
                end
                if not HasBlueFlower() and not IsNight() then
                    SetStatus(("Đang up Ghoul V2 mà trời chuyển sáng (Clock: %.1f) -> Hop Low tìm trời tối..."):format(Lighting.ClockTime))
                    HopLow()
                    return
                end
                SetStatus(("Đang làm Ghoul V2 ở Sea 2 (Clock: %.1f)..."):format(Lighting.ClockTime))
            end
        end
        return
    end

    -- 2B. ĐÃ XONG GHOUL V2 -> UP GHOUL V3 (STICKY ROOM CO-OP + SOLO)
    RunGhoulV3Phase()
    return
end
if Stopped() then return end

-- Cập nhật trạng thái idle ở Sea 3 để sẵn sàng nhận kèo Back-Help 1-kèm-1
ClearGhoulRoomIfOwner()
MyPresenceState.phase = "idle"
MyPresenceState.needsV3 = false
MyPresenceState.needsBackHelp = false
MyPresenceState.isBackHelp = false
MyPresenceState.readyAtHelp = false
MyPresenceState.leverPulled = IsLeverPulled()
FlushMyPresenceFile(false)

-- 3. ĐÃ ĐỦ GHOUL V3 -> ĐẢM BẢO ĐỦ 10K FRAGMENT TRƯỚC KHI CHECK INVENTORY (THEO DÕI BACK-HELP)
if GetFragments() < 10000 then
    RunSea3BossTarget(
        DESTINATIONS.CAKE_PRINCE,
        POS_CAKE_PRINCE,
        function() return ("Đã có Ghoul V3 | Farm nốt Frag (Cake Prince): %d / 10000"):format(GetFragments()) end,
        function()
            if GetFragments() >= 10000 then
                SetStatus("Đã đủ 10k Fragment! Hop Low để refresh...")
                HopLow()
                return true
            end
            return false
        end
    )
    return
end
if Stopped() then return end

if CheckAndClaimBackHelp() then CleanupMovement(); TravelToSea(2); return end
if GetSea() ~= 3 then TravelToSea(3) end
if Stopped() then return end

-- 4. CHECK INVENTORY: VALKYRIE HELM & MIRROR FRACTAL
local hasHelm, hasMirror = CheckInvItems()
if Stopped() then return end

if not hasHelm then
    RunSea3BossTarget(
        DESTINATIONS.RIP_INDRA,
        POS_SEA_CASTLE,
        function() return "Thiếu Valkyrie Helm -> Đang săn Rip Indra..." end,
        function()
            local h = CheckInvItems()
            if h then
                SetStatus("Đã lấy được Valkyrie Helm! Hop Low để refresh...")
                HopLow()
                return true
            end
            return false
        end
    )
    return
end

if not hasMirror then
    RunSea3BossTarget(
        DESTINATIONS.DOUGH_KING,
        POS_CAKE_LOAF,
        function() return "Thiếu Mirror Fractal -> Đang săn Dough King..." end,
        function()
            local _, m = CheckInvItems()
            if m then
                SetStatus("Đã lấy được Mirror Fractal! Hop Low để refresh...")
                HopLow()
                return true
            end
            return false
        end
    )
    return
end

-- 5. ĐỦ GHOUL V3 + 10K FRAG + MŨ + MẢNH -> CHECK & AUTO PULL LEVER (VẪN THEO DÕI BACK-HELP)
if not IsLeverPulled() then
    if LaunchRealKidMain({ AutoPullLever = true }, "Auto Pull Lever (Temple of Time)") then
        while not Stopped() and task.wait(2) do
            if CheckAndClaimBackHelp() then CleanupMovement(); TravelToSea(2); return end
            SetStatus("Đang chạy Auto Pull Lever...")
            if IsLeverPulled() then
                MyPresenceState.leverPulled = true
                FlushMyPresenceFile(false)
                break
            end
        end
    end
end

if Stopped() then return end
MyPresenceState.leverPulled = true
FlushMyPresenceFile(false)
SetStatus("CHÚC MỪNG! Đã hoàn thành Ghoul V3 + Pull Lever! (Đang trực Back-Help)")
while not Stopped() and task.wait(2.5) do
    if CheckAndClaimBackHelp() then
        CleanupMovement()
        TravelToSea(2)
        return
    end
end
