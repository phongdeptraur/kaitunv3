local function ReadAllGhoulSessions()
    local now = os.time()
    local cleaned = {}
    local scannedPaths = {}

    local function ingestPath(path)
        local norm = tostring(path):gsub("^%./", "")
        if scannedPaths[norm] then return end
        scannedPaths[norm] = true
        local entry = ReadSingleJsonFile(norm)
        if type(entry) == "table" and type(entry.updatedAt) == "number" then
            if (now - entry.updatedAt) <= SESSION_TTL then
                local uid = tostring(entry.userId or norm:match("ghoulsession_(%d+)%.json$") or "")
                if uid ~= "" then
                    cleaned[uid] = entry
                end
            elseif delfile and norm ~= MY_SESSION_FILE then
                pcall(delfile, norm)
            end
        end
    end

    local idx = ReadSingleJsonFile(SESSION_INDEX_FILE)
    if type(idx) == "table" then
        for uid, ts in pairs(idx) do
            if type(ts) == "number" and (now - ts) <= SESSION_TTL then
                ingestPath(SESSION_PREFIX .. tostring(uid) .. ".json")
            end
        end
    end

    if listfiles then
        for _, rootArg in ipairs({ "", "." }) do
            local okL, files = pcall(listfiles, rootArg)
            if okL and type(files) == "table" then
                for _, f in ipairs(files) do
                    local fname = tostring(f):gsub("\\", "/")
                    if fname:match("ghoulsession_%d+%.json$") then
                        ingestPath(fname)
                    end
                end
            end
        end
    end

    if MyPresenceState.phase ~= "none" then
        ingestPath(MY_SESSION_FILE)
    end
    for _, plr in ipairs(Players:GetPlayers()) do
        ingestPath(SESSION_PREFIX .. tostring(plr.UserId) .. ".json")
    end

    return cleaned
end

local function ReadGhoulRoom(sessions)
    local room = ReadSingleJsonFile(ROOM_FILE)
    if type(room) ~= "table" then return nil end
    local now = os.time()
    local hostUid = tostring(room.hostUid or "")
    local updatedAt = tonumber(room.updatedAt) or 0
    if hostUid == "" or (now - updatedAt) > SESSION_TTL then
        return nil
    end
    local allSessions = sessions or ReadAllGhoulSessions()
    local hostSession = allSessions[hostUid]
    if not hostSession or (now - (tonumber(hostSession.updatedAt) or 0)) > SESSION_TTL then
        return nil
    end
    -- Nếu phòng thường nhưng Host đã xong V3 -> phòng đã kết thúc
    if not room.isBackHelp and hostSession.needsV3 == false then
        return nil
    end
    -- Nếu phòng Back-Help nhưng không còn ai cần V3 -> phòng đã kết thúc
    if room.isBackHelp then
        local hasAnyV3 = false
        for uid, e in pairs(allSessions) do
            if uid ~= hostUid and e.needsV3 == true then
                hasAnyV3 = true
                break
            end
        end
        if not hasAnyV3 then return nil end
    end
    return room
end

