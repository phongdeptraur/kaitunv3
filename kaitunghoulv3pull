            local yieldServer = (conflict.state == "active" and otherJoined < EctoFarmJoinEpoch)
                or (otherJoined == EctoFarmJoinEpoch and myNum > otherNum)
                or (conflict.state == "reserved" and myNum > otherNum)
            if yieldServer then
                SetStatus(("Trùng server farm Ectoplasm với %s -> Hop Low đặt chỗ server mới..."):format(tostring(conflict.name or conflict.userId)))
                HopEctoLow()
