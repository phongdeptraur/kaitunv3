    MyPresenceState.phase = "idle"
    MyPresenceState.needsV3 = false
    MyPresenceState.needsBackHelp = false
    MyPresenceState.isBackHelp = false
    MyPresenceState.readyAtHelp = false
    MyPresenceState.leverPulled = IsLeverPulled()
    FlushMyPresenceFile(false)
    SetStatus("Đã xong Ghoul V3! Đang TP sang Sea 3...")
    TravelToSea(3)
end

local function RunGhoulV3Phase()
    if GetSea() ~= 2 then TravelToSea(2) end
    if Stopped() then return end

    local chosenSword = nil
    local statsChecked = false
    local deprioritized = {}
    local lastRoomTpClock = 0

    local function CheckWenlock()
        local ok, rs = pcall(function() return CommF:InvokeServer("Wenlocktoad", "1") end)
        if not ok then return nil end
        if rs == -2 then return -2 end
        if rs == 0 then
            SetStatus("Starting Trial (Wenlocktoad 2)...")
            pcall(function() CommF:InvokeServer("Wenlocktoad", "2") end)
            SleepCheck(0.4)
        elseif rs == 2 then
            SetStatus("Đủ kill -> Trả nhiệm vụ Ghoul V3 (Wenlocktoad 3)...")
            pcall(function() CommF:InvokeServer("Wenlocktoad", "3") end)
            SleepCheck(0.5)
        end
        return rs
    end

    local function PrepareGhoulV3Weapons()
        if statsChecked then
            if chosenSword and not FindToolByKind(nil, chosenSword) then
                pcall(function() CommF:InvokeServer("LoadItem", chosenSword) end)
            end
            return
        end
        chosenSword = GetGhoulV3Sword()
        if chosenSword then EnsureSwordStats2800() end
        statsChecked = true
    end

    local function EngageTargetStep(targetPlayer, tChar, myHRP, startTick, labelPrefix)
        local tHRP = tChar:FindFirstChild("HumanoidRootPart")
        local tHum = tChar:FindFirstChildOfClass("Humanoid")
        if not (tHRP and tHum and tHum.Health > 0) then return false end

        local elapsedMin = (os.clock() - startTick) / 60
        local realDist = (tHRP.Position - myHRP.Position).Magnitude

        if IsInSafeZone(targetPlayer) then
            hoverAboveMode = true
            SetStatus(("%s: %s vào Safe Zone (giữ khóa, +60 stud) | %.0fm"):format(labelPrefix, targetPlayer.DisplayName, elapsedMin))
            SleepCheck(0.2)
            return true
        end

        local weapons = {}
        if chosenSword then
            local sw = FindToolByKind(nil, chosenSword)
            if sw then table.insert(weapons, sw) end
        end
        local ml = FindToolByKind("Melee")
        if ml then table.insert(weapons, ml) end

        local activeTool, readyKeys = nil, nil
        for _, w in ipairs(weapons) do
            local rk = GetReadySkillsForTool(w)
            if #rk > 0 then
                activeTool, readyKeys = w, rk
                break
            end
        end

        if activeTool then
            hoverAboveMode = false
            SetStatus(("%s: %s [%.0f stud] | Spam %s | %.0fm"):format(labelPrefix, targetPlayer.DisplayName, realDist, activeTool.Name, elapsedMin))
            if realDist <= 22 then
                CastReadySkills(activeTool, readyKeys, tHRP)
                if not Stopped() and (not tHum.Parent or tHum.Health <= 0) then
                    pcall(function() CommF:InvokeServer("Wenlocktoad", "3") end)
                    SleepCheck(0.25)
                end
            else
                SleepCheck(0.1)
            end
        else
            hoverAboveMode = true
            SetStatus(("%s: %s [%.0f stud] | Hồi chiêu (+60 stud) | %.0fm"):format(labelPrefix, targetPlayer.DisplayName, realDist, elapsedMin))
            SleepCheck(0.15)
        end
        return true
    end

    local didInitialSessionSync = false
    while not Stopped() do
        local stW = CheckWenlock()
        if HasRaceV3() or stW == -2 then
            FinishGhoulV3ToSea3()
            return
        end

        local topo = SyncV3SessionEntry({ readyAtHelp = false })
        if topo.myRole == "solo" and not didInitialSessionSync then
            didInitialSessionSync = true
            SetStatus("Đang quét đồng đội Co-op & Back-Help...")
            if not SleepCheck(1.5) then return end
            topo = SyncV3SessionEntry({ readyAtHelp = false })
        end

        -- CO-OP MODE (Có Sticky Room / Back-Help Host / >= 2 acc V3)
        if topo.myRole == "host" then
            RunCoopHost(false)
        elseif topo.myRole == "clone" then
            StopPvPTween()
            local room = topo.room
            local hostEntry = topo.hostEntry
            local hostName = tostring((room and room.hostName) or (hostEntry and hostEntry.name) or "?")
            local roomState = room and tostring(room.state or "PREPARING") or "PREPARING"
            local roomJob = room and tostring(room.jobId or "") or ""
            local cloneSelfTag = ("Co-op Clone [%s | STT %d/%d]"):format(LocalPlayer.Name, topo.mySTT, topo.totalClones)

            -- Luật cứng: Khi room.state ~= "OPEN" hoặc room.jobId == "" -> đứng yên chờ ở Sea 2, cấm teleport
            if GetSea() ~= 2 then
                TravelToSea(2)
            elseif roomState ~= "OPEN" or roomJob == "" then
                MyPresenceState.readyAtHelp = false
                SetStatus(("%s: Đứng yên chờ Host (%s) chốt phòng [State: %s]..."):format(cloneSelfTag, hostName, roomState))
                SleepCheck(1.5)
            elseif roomJob ~= tostring(game.JobId) then
                MyPresenceState.readyAtHelp = false
                if lastFailedJoinJob == roomJob then
                    SyncV3SessionEntry({ readyAtHelp = false })
                    SetStatus(("%s: Lỗi join %s -> Đã báo Host (%s) đổi server..."):format(cloneSelfTag, roomJob:sub(1, 8), hostName))
                    SleepCheck(1.5)
                elseif (os.clock() - lastRoomTpClock) < 10.0 then
                    local waitCd = math.max(0, 10.0 - (os.clock() - lastRoomTpClock))
                    SetStatus(("%s: Cooldown join server Host (%s) %.1fs..."):format(cloneSelfTag, hostName, waitCd))
                    SleepCheck(1.0)
                else
                    lastRoomTpClock = os.clock()
                    pendingTeleportJob = roomJob
                    SetStatus(("%s [OPEN]: Gọi __ServerBrowser join %s..."):format(cloneSelfTag, roomJob:sub(1, 8)))
                    local sb = ReplicatedStorage:FindFirstChild("__ServerBrowser")
                    if sb then
                        pcall(function() sb:InvokeServer("teleport", roomJob) end)
                    else
                        DirectTeleport(roomJob, tonumber(room.placeId) or game.PlaceId)
                    end
                    SleepCheck(3.0)
                end
            else
                -- Đã hội quân cùng server với Host ở Sea 2
                local cloneStart = os.clock()
                local currentSTT = topo.mySTT
                local currentTotalClones = topo.totalClones
                local currentWhitelist = topo.whitelistUids
                local currentMoveTarget = POS_COOP_HELP

                EnsureTeam(currentSTT == 1 and "Pirates" or "Marines")
                EnsureMyPvPEnabled()
                if currentSTT == 1 then
                    PrepareGhoulV3Weapons()
                end

                EnsurePvPTweenLoop(function()
                    return currentMoveTarget
                end)

                local lastSync = 0
                while not Stopped() do
                    local curW = CheckWenlock()
                    if HasRaceV3() or curW == -2 then
                        FinishGhoulV3ToSea3()
                        return
                    end

                    if (os.clock() - lastSync) >= 2.0 then
                        lastSync = os.clock()
                        local t2 = SyncV3SessionEntry(nil)
                        currentSTT = t2.mySTT
                        currentTotalClones = t2.totalClones
                        currentWhitelist = t2.whitelistUids
                        local r2 = t2.room
                        if t2.myRole ~= "clone" or not r2 or r2.state ~= "OPEN" or tostring(r2.jobId) ~= tostring(game.JobId) then
                            MyPresenceState.readyAtHelp = false
                            StopPvPTween()
                            break
                        end
                    end

                    local char, _, myHRP = WaitAlive()
                    if Stopped() or not char then break end

                    if currentSTT == 1 then
                        -- STT 1 (Pirates): Bay thẳng điểm Help, chỉ tấn công whitelist Co-op trong 100 studs quanh POS_COOP_HELP
                        if not char:FindFirstChild("HasBuso") then pcall(function() CommF:InvokeServer("Buso") end) end
                        if GetCurrentTeamName() ~= "Pirates" then EnsureTeam("Pirates") end
                        EnsureMyPvPEnabled()
                        PrepareGhoulV3Weapons()

                        local distToHelp = (POS_COOP_HELP - myHRP.Position).Magnitude
                        MyPresenceState.readyAtHelp = (distToHelp <= 15)

                        local validVictim = GetCoopWhitelistTarget(currentWhitelist)
                        if validVictim and validVictim.Character then
                            currentMoveTarget = validVictim
                            EngageTargetStep(validVictim, validVictim.Character, myHRP, cloneStart, ("Co-op [%s | STT 1/%d] Kill"):format(LocalPlayer.Name, currentTotalClones))
                        else
                            hoverAboveMode = false
                            currentMoveTarget = POS_COOP_HELP
                            SetStatus(("Co-op [%s | STT 1/%d]: Giữ vị trí tại điểm Help (%.0f stud) chờ mục tiêu..."):format(LocalPlayer.Name, currentTotalClones, distToHelp))
                            SleepCheck(0.35)
                        end
                    else
                        -- STT >= 2 (Marines): Đứng giãn cách 3 studs quanh tâm POS_COOP_HELP, bật PvP liên tục
                        ClearAimState()
                        hoverAboveMode = false
                        if GetCurrentTeamName() ~= "Marines" then EnsureTeam("Marines") end
                        EnsureMyPvPEnabled()

                        local angle = (currentSTT - 2) * (math.pi / 3)
                        local sacPos = POS_COOP_HELP + Vector3.new(math.cos(angle) * 3, 0, math.sin(angle) * 3)
                        currentMoveTarget = sacPos
                        local distToSac = (sacPos - myHRP.Position).Magnitude
                        MyPresenceState.readyAtHelp = (distToSac <= 15)
                        local tempHelperTag = ("Helper Tạm [%s | STT %d/%d]"):format(LocalPlayer.Name, currentSTT, currentTotalClones)

                        if distToSac > 5 then
                            SetStatus(("%s: Đang bay tới điểm Help (%.0f stud)..."):format(tempHelperTag, distToSac))
                        else
                            SetStatus(("%s: Đứng giãn cách 3 studs tại điểm Help (PvP ON)..."):format(tempHelperTag))
                        end
                        SleepCheck(0.35)
                    end
                end
                StopPvPTween()
            end
        else
            -- SOLO MODE (activeV3Count == 1): Bật needsBackHelp = true chờ 10s gọi Back-Help trước khi HopHigh
            MyPresenceState.needsBackHelp = true
            MyPresenceState.readyAtHelp = false
            FlushMyPresenceFile(false)

            local bhWaitStart = os.clock()
            local gotBackHelp = false
            while not Stopped() and (os.clock() - bhWaitStart) < BACKHELP_WAIT_SECONDS do
                local tCheck = SyncV3SessionEntry({ needsBackHelp = true, readyAtHelp = false })
                if tCheck.myRole ~= "solo" then
                    gotBackHelp = true
                    break
                end
                local rem = math.max(0, BACKHELP_WAIT_SECONDS - (os.clock() - bhWaitStart))
                SetStatus(("Solo lẻ loi: Bật needsBackHelp = true, chờ acc Sea 3 nhận kèo (%.1fs)..."):format(rem))
                SleepCheck(0.5)
            end

            if Stopped() then return end
            if gotBackHelp then
                continue
            end

            EnsureTeam("Pirates")
            EnsureMyPvPEnabled()
            if Stopped() then break end

            if CountPvPPlayers() < 3 then
                SetStatus(("Solo Ghoul V3: Không có Back-Help & chỉ có %d/3 player PvP ON -> Hop High (11/12)..."):format(CountPvPPlayers()))
                HopHigh()
                return
            end

            PrepareGhoulV3Weapons()
            if Stopped() then break end

            local v3Start = os.clock()
            local currentTarget, lockedChar, lockStart = nil, nil, 0
            local lastSync = 0
            EnsurePvPTweenLoop(function() return currentTarget end)

            while not Stopped() do
                if (os.clock() - v3Start) >= GHOUL_V3_TIMEOUT then
                    StopPvPTween()
                    SetStatus("Up Ghoul V3 quá 45 phút trong server này -> Hop Low!")
                    HopLow()
                    return
                end

                local curStat = CheckWenlock()
                if HasRaceV3() or curStat == -2 then
                    FinishGhoulV3ToSea3()
                    return
                end

                if (os.clock() - lastSync) >= 2 then
                    lastSync = os.clock()
                    local t2 = SyncV3SessionEntry({ needsBackHelp = true, readyAtHelp = false })
                    if t2.myRole ~= "solo" then
                        StopPvPTween()
                        SetStatus("Phát hiện Co-op / Back-Help -> Chuyển sang chế độ Co-op!")
                        break
                    end
                end

                local char, _, myHRP = WaitAlive()
                if Stopped() or not char then break end
                if not char:FindFirstChild("HasBuso") then pcall(function() CommF:InvokeServer("Buso") end) end
                if GetCurrentTeamName() ~= "Pirates" then EnsureTeam("Pirates") end
                EnsureMyPvPEnabled()
                PrepareGhoulV3Weapons()

                if currentTarget then
                    if not IsLockedTargetValid(currentTarget, lockedChar) then
                        local deadOrRespawn = (not currentTarget.Parent) or (currentTarget.Character ~= lockedChar)
                            or (not lockedChar or not lockedChar:FindFirstChildOfClass("Humanoid") or lockedChar:FindFirstChildOfClass("Humanoid").Health <= 0)
                        if deadOrRespawn then
                            pcall(function() CommF:InvokeServer("Wenlocktoad", "3") end)
                        end
                        currentTarget, lockedChar, lockStart = nil, nil, 0
                    elseif (os.clock() - lockStart) >= LOCK_TIMEOUT then
                        deprioritized[currentTarget.UserId] = os.clock()
                        SetStatus(("Quá 3p chưa kill được %s -> Đổi mục tiêu khác!"):format(currentTarget.DisplayName))
                        currentTarget, lockedChar, lockStart = nil, nil, 0
                    end
                end

                if not currentTarget then
                    local nextT = GetNextSoloTarget(deprioritized)
                    if nextT and nextT.Character then
                        currentTarget = nextT
                        lockedChar = nextT.Character
                        lockStart = os.clock()
                    end
                end

                if currentTarget and lockedChar and lockedChar.Parent then
                    local kept = EngageTargetStep(currentTarget, lockedChar, myHRP, lockStart, "Solo Lock")
                    if not kept then
                        currentTarget, lockedChar, lockStart = nil, nil, 0
                        SleepCheck(0.15)
                    end
                else
                    hoverAboveMode = false
                    SetStatus(("Solo Lock: Chờ player PvP ON (<= 50k stud)... | %.0fm/45m"):format((os.clock() - v3Start) / 60))
                    SleepCheck(0.4)
                end
            end
            StopPvPTween()
        end
    end
end

