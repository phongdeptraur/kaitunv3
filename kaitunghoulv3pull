-- CHECK SAFE ZONE, PVP, STAT SWORD 2800, HỒI CHIÊU, SILENT AIM & TWEEN 0.1S
-- ============================================================================
local function GetDistanceToPlayer(player)
    local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local tHRP = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if myHRP and tHRP then
        return (tHRP.Position - myHRP.Position).Magnitude
    end
    return nil
end

local function GetEnclosingSafeZone(pos, margin)
    local m = margin or 0
    local origin = workspace:FindFirstChild("_WorldOrigin")
    local szFolder = (origin and origin:FindFirstChild("SafeZones")) or workspace:FindFirstChild("SafeZones")
    if not szFolder then return nil end
    for _, z in ipairs(szFolder:GetChildren()) do
        if z:IsA("BasePart") then
            local rel = z.CFrame:PointToObjectSpace(pos)
            local half = z.Size / 2
            if math.abs(rel.X) <= (half.X + m) and math.abs(rel.Y) <= (half.Y + m) and math.abs(rel.Z) <= (half.Z + m) then
                return z
            end
        end
    end
    return nil
end

local function IsInSafeZone(player)
    if player == LocalPlayer then
        local pgui = LocalPlayer:FindFirstChild("PlayerGui")
        local main = pgui and pgui:FindFirstChild("Main")
        local sz = main and main:FindFirstChild("SafeZone")
        if sz and sz.Visible then return true end
        if pgui then
            for _, d in ipairs(pgui:GetDescendants()) do
                if d:IsA("TextLabel") and d.Visible and d.Text:lower():find("safe zone") then return true end
            end
        end
    end

    local char = player.Character
    if not char then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp and GetEnclosingSafeZone(hrp.Position, 0) then return true end
    if char:FindFirstChild("SafeZone") or char:FindFirstChild("InSafeZone") then return true end
    for k, v in pairs(char:GetAttributes()) do
        if k:lower():find("safezone") and (v == true or (type(v) == "number" and v > 0)) then return true end
    end
    local pData = player:FindFirstChild("Data")
    if pData then
        for _, v in ipairs(pData:GetChildren()) do
            if v.Name:lower():find("safezone") and (v.Value == true or (type(v.Value) == "number" and v.Value > 0)) then return true end
        end
    end
    for k, v in pairs(player:GetAttributes()) do
        if k:lower():find("safezone") and (v == true or (type(v) == "number" and v > 0)) then return true end
    end
    return false
end

local function HasTruePvPDisabled(player)
    if player == LocalPlayer then
        local pgui = LocalPlayer:FindFirstChild("PlayerGui")
        local main = pgui and pgui:FindFirstChild("Main")
        local pd = main and main:FindFirstChild("PvpDisabled")
        if pd and pd.Visible then return true end
        if pgui then
            for _, d in ipairs(pgui:GetDescendants()) do
                if d:IsA("TextLabel") and d.Visible then
                    local t = d.Text:lower()
                    if t:find("pvp disabled") or t:find("died recently") then return true end
                end
            end
        end
    end

    local char = player.Character
    if not char then return true end
    if char:FindFirstChildOfClass("ForceField") or char:FindFirstChild("PvpDisabled") then return true end
    for k, v in pairs(char:GetAttributes()) do
        if k:lower():find("pvpdisabled") and (v == true or (type(v) == "number" and v > 0)) then return true end
    end
    local pData = player:FindFirstChild("Data")
    if pData then
        local lvl = pData:FindFirstChild("Level")
        if lvl and type(lvl.Value) == "number" and lvl.Value < 20 then return true end
        for _, v in ipairs(pData:GetChildren()) do
            local l = v.Name:lower()
            if l:find("pvpdisabled") and (v.Value == true or (type(v.Value) == "number" and v.Value > 0)) then return true end
            if l == "pvp" and v.Value == false then return true end
        end
    end
    for k, v in pairs(player:GetAttributes()) do
        local l = k:lower()
        if l:find("pvpdisabled") and (v == true or (type(v) == "number" and v > 0)) then return true end
        if l == "pvp" and v == false then return true end
    end
    return false
end

local function GetPvPStatus(player)
    if IsInSafeZone(player) or HasTruePvPDisabled(player) then return "OFF" end
    return "ON"
end

local lastPvpTry = 0
local function EnsureMyPvPEnabled()
    if Stopped() then return end
    if HasTruePvPDisabled(LocalPlayer) or GetPvPStatus(LocalPlayer) == "OFF" then
        local now = os.clock()
        if (now - lastPvpTry) >= 1.2 then
            lastPvpTry = now
            pcall(function() CommF:InvokeServer("EnablePvp") end)
        end
    end
end

local function IsValidPvPTarget(player)
    if not player or player == LocalPlayer or not player.Parent then return false, nil end
    local ch = player.Character
    local hum = ch and ch:FindFirstChildOfClass("Humanoid")
    local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
    if not (hum and hrp and hum.Health > 0) then return false, nil end
    if GetPvPStatus(player) ~= "ON" then return false, nil end
    local dist = GetDistanceToPlayer(player)
    if not dist or dist > MAX_PVP_DIST then return false, nil end
    return true, dist
end

-- Giữ khóa cả khi mục tiêu đi vào Safe Zone (chỉ nhả khi chết / respawn / out game / ForceField PvP OFF thật / > 50k stud)
local function IsLockedTargetValid(player, expectedChar)
    if not player or player == LocalPlayer or not player.Parent then return false, nil end
    local ch = player.Character
    if expectedChar and ch ~= expectedChar then return false, nil end
    local hum = ch and ch:FindFirstChildOfClass("Humanoid")
    local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
    if not (hum and hrp and hum.Health > 0) then return false, nil end
    if HasTruePvPDisabled(player) then return false, nil end
    local dist = GetDistanceToPlayer(player)
    if not dist or dist > MAX_PVP_DIST then return false, nil end
    return true, dist
end

local function CountPvPPlayers()
    local count = 0
    for _, p in ipairs(Players:GetPlayers()) do
        if IsValidPvPTarget(p) then count = count + 1 end
    end
    return count
end

-- Ưu tiên người gần nhất chưa từng quá 3 phút; nếu hết ai khác mới chọn lại người quá 3 phút cũ nhất
local function GetNextSoloTarget(deprioritizedMap)
    local bestFresh, bestFreshDist = nil, math.huge
    local bestOld, bestOldTick = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        local ok, dist = IsValidPvPTarget(p)
        if ok then
            local depTick = deprioritizedMap and deprioritizedMap[p.UserId]
            if not depTick then
                if dist < bestFreshDist then
                    bestFresh, bestFreshDist = p, dist
                end
            else
                if depTick < bestOldTick then
                    bestOld, bestOldTick = p, depTick
                end
            end
        end
    end
    return bestFresh or bestOld
end

