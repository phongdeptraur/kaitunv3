local function DirectTeleport(jobId, placeId)
    local targetId = tostring(jobId or "")
    if targetId == "" or targetId == tostring(game.JobId) then return false end
    if Stopped() or isTeleportingNow then return false end
    if (os.clock() - lastTeleportClock) < 5.5 then return false end

    isTeleportingNow = true
    lastTeleportClock = os.clock()
    lastTeleportFailedFlag = false
    pendingTeleportJob = targetId

    local targetPlace = placeId or game.PlaceId
    local okTp = pcall(function()
        TeleportService:TeleportToPlaceInstance(targetPlace, targetId, LocalPlayer)
    end)
    if not okTp then
        local sb = ReplicatedStorage:FindFirstChild("__ServerBrowser")
        if sb then
            pcall(function() sb:InvokeServer("teleport", targetId) end)
        end
    end

    local t0 = os.clock()
    while not Stopped() and (os.clock() - t0) < 5.0 do
        if lastTeleportFailedFlag then
            isTeleportingNow = false
            return false
        end
        task.wait(0.15)
    end

    isTeleportingNow = false
    pendingTeleportJob = nil
    return not lastTeleportFailedFlag
end

