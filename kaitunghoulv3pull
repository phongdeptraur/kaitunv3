local function ReadSingleJsonFile(path)
    if not (isfile and readfile and isfile(path)) then return nil end
    for _ = 1, 3 do
        local okR, raw = pcall(readfile, path)
        if okR and type(raw) == "string" and not raw:match("^%s*$") then
            local okD, data = pcall(function() return HttpService:JSONDecode(raw) end)
            if okD and type(data) == "table" then
                return data
            end
        end
        task.wait(0.02)
    end
    return nil
end

local function UpdateSessionIndex(uid, timestampOrNil)
    if not writefile then return end
    local idx = ReadSingleJsonFile(SESSION_INDEX_FILE) or {}
    local now = os.time()
    local cleanedIdx = {}
    for k, ts in pairs(idx) do
        if type(ts) == "number" and (now - ts) <= SESSION_TTL then
            cleanedIdx[tostring(k)] = ts
        end
    end
    cleanedIdx[tostring(uid)] = timestampOrNil
    pcall(writefile, SESSION_INDEX_FILE, HttpService:JSONEncode(cleanedIdx))
end

local function FlushMyPresenceFile(removeFile)
    if not writefile then return end
    if removeFile then
        if isfile and delfile and isfile(MY_SESSION_FILE) then
            pcall(delfile, MY_SESSION_FILE)
        end
        UpdateSessionIndex(MY_UID, nil)
        return
    end
    local now = os.time()
    MyPresenceState.userId = LocalPlayer.UserId
    MyPresenceState.name = LocalPlayer.Name
    MyPresenceState.sea = GetSea()
    MyPresenceState.jobId = tostring(game.JobId)
    MyPresenceState.placeId = game.PlaceId
    MyPresenceState.failedJob = tostring(lastFailedJoinJob or "")
    MyPresenceState.updatedAt = now
    pcall(writefile, MY_SESSION_FILE, HttpService:JSONEncode(MyPresenceState))
    UpdateSessionIndex(MY_UID, now)
end

