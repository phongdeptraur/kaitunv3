end

local function TryReserveEctoJob(targetJobId)
    local myUid = tostring(LocalPlayer.UserId)
    local myNum = tonumber(myUid) or math.huge
    local claimed = false

    UpdateEctoAntiCollision(function(tbl, now)
        for uid, info in pairs(tbl) do
            if uid ~= myUid and (tostring(info.jobId) == targetJobId or tostring(info.reservedJobId) == targetJobId) then
                return
            end
        end
        tbl[myUid] = {
            userId = LocalPlayer.UserId,
            name = LocalPlayer.Name,
            jobId = tostring(game.JobId),
            reservedJobId = targetJobId,
            joinedAt = EctoFarmJoinEpoch,
            state = "reserved",
            updatedAt = now,
        }
        claimed = true
    end)

    if not claimed then return false end
    task.wait(0.08)

    local verifyRaw, ok = ReadEctoAntiRaw()
    if ok and verifyRaw then
        local now = os.time()
        local cleaned = CleanExpiredEctoEntries(verifyRaw, now)
        for uid, info in pairs(cleaned) do
            if uid ~= myUid and (tostring(info.jobId) == targetJobId or tostring(info.reservedJobId) == targetJobId) then
                local otherNum = tonumber(uid) or math.huge
                if otherNum < myNum then
                    UpdateEctoAntiCollision(function(tbl)
                        if tbl[myUid] and tbl[myUid].reservedJobId == targetJobId then
                            tbl[myUid].reservedJobId = ""
                        end
                    end)
                    return false
                end
            end
        end
    end
    return true
end

