-- 1. CHƯA PHẢI GHOUL -> CHẠY REALKID MAIN CONFIG "auto_ghoul_v1":true Ở SEA 2 (CÓ ANTI-COLLISION ECTOPLASM)
if GetRace() ~= "Ghoul" then
    if GetSea() ~= 2 then TravelToSea(2) end
