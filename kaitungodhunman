-- [AXIOM ADVANCED ANTI-GRAVITY & HOVER STABILIZER]

local antiGravConn = nil

local function SetAntiGravity(enable)

    local lp = game:GetService("Players").LocalPlayer

    local char = lp and lp.Character

    local hrp = char and char:FindFirstChild("HumanoidRootPart")

    

    if enable then

        workspace.Gravity = 0

        if hrp then

            local bv = hrp:FindFirstChild("__AxiomHoverStabilizer")

            if not bv then

                bv = Instance.new("BodyVelocity")

                bv.Name = "__AxiomHoverStabilizer"

                bv.Parent = hrp

            end

            if Axiom and Axiom.IsTweening then

                bv.MaxForce = Vector3.zero

            else

                bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)

                bv.Velocity = Vector3.zero

                hrp.AssemblyLinearVelocity = Vector3.zero

                hrp.AssemblyAngularVelocity = Vector3.zero

            end

        end

        

        if not antiGravConn then

            antiGravConn = game:GetService("RunService").Stepped:Connect(function()

                local isActive = _G.AutoGodhuman or (Axiom and Axiom.AutoGodhuman)

                if not isActive then

                    if antiGravConn then

                        antiGravConn:Disconnect()

                        antiGravConn = nil

                    end

                    return

                end

                workspace.Gravity = 0

                local myChar = game:GetService("Players").LocalPlayer and game:GetService("Players").LocalPlayer.Character

                local root = myChar and myChar:FindFirstChild("HumanoidRootPart")

                if root then

                    local bv = root:FindFirstChild("__AxiomHoverStabilizer")

                    if not bv then

                        bv = Instance.new("BodyVelocity")

                        bv.Name = "__AxiomHoverStabilizer"

                        bv.Parent = root

                    end

                    

                    -- Neu dang bay Tween: Tha long hoan toan luc can vat ly

                    if Axiom and Axiom.IsTweening then

                        bv.MaxForce = Vector3.zero

                    else

                        bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)

                        bv.Velocity = Vector3.zero

                        root.AssemblyLinearVelocity = Vector3.zero

                        root.AssemblyAngularVelocity = Vector3.zero

                    end

                end

            end)

        end

    else

        workspace.Gravity = 196.2

        if antiGravConn then

            antiGravConn:Disconnect()

            antiGravConn = nil

        end

        if hrp then

            local bv = hrp:FindFirstChild("__AxiomHoverStabilizer")

            if bv then bv:Destroy() end

            hrp.AssemblyLinearVelocity = Vector3.zero

            hrp.AssemblyAngularVelocity = Vector3.zero

        end

    end

end



