local function AutoStoreBackpackFruits()
    if not CommF_ then return end
    local containers = { LocalPlayer:FindFirstChild("Backpack"), GetChar() }
    for _, cont in ipairs(containers) do
        if cont then
            for _, tool in ipairs(cont:GetChildren()) do
                if tool:IsA("Tool") and (tool.Name:lower():find("fruit") or tool:GetAttribute("OriginalName")) then
