local function MatchMeleeName(toolName, targetName)
    if not toolName or not targetName then return false end
    local t = toolName:lower():gsub("[%s%-_]", "")
    local tg = targetName:lower():gsub("[%s%-_]", "")
    if tg == "electro" and t:find("claw") then return false end
    if tg == "dragonclaw" and t:find("talon") then return false end
    if tg == "fishmankarate" and t:find("sharkman") then return false end
    if tg == "blackleg" and t:find("death") then return false end
    if t == tg or t:find(tg, 1, true) then return true end
    for _, a in ipairs(MeleeAliases[targetName] or {}) do
        if t:find(a, 1, true) then return true end
    end
    return false
end

local CachedMastery, LastMasteryTick = nil, 0
local function FetchOwnedMastery()
    if CachedMastery and (os.clock() - LastMasteryTick < 1.0) then return CachedMastery end
    LastMasteryTick = os.clock()
    local owned, raw = {}, {}
    pcall(function()
        local rf = ReplicatedStorage:FindFirstChild("RF/GetAllItemValues", true)
        if rf then
            for _, item in pairs(rf:InvokeServer() or {}) do
                if type(item) == "table" and item.ItemId and (item.Key == "Mastery" or item.Key == "CombatData") then
                    raw[tonumber(item.ItemId)] = tonumber(item.Value)
                end
            end
        end
    end)
    for name, reg in pairs(MeleeRegistry) do
        local m = reg.ID and raw[reg.ID]
        if m and m > 0 then
            owned[name] = { Name = name, Mastery = m, Req = reg.Req }
            Axiom.PersistentOwnedMelees[name] = m
        end
    end
    pcall(function()
        local tool = GetChar() and GetChar():FindFirstChildOfClass("Tool")
        if tool then
            for name, reg in pairs(MeleeRegistry) do
                if MatchMeleeName(tool.Name, name) then
                    local lvl = tool:FindFirstChild("Level") and tonumber(tool.Level.Value)
                    if lvl and lvl > 0 then
                        owned[name] = { Name = name, Mastery = math.max(lvl, (owned[name] and owned[name].Mastery) or 0), Req = reg.Req }
                        Axiom.PersistentOwnedMelees[name] = owned[name].Mastery
                    end
                end
            end
        end
    end)
    for pName, pVal in pairs(Axiom.PersistentOwnedMelees) do
        if not owned[pName] and MeleeRegistry[pName] then
            owned[pName] = { Name = pName, Mastery = pVal, Req = MeleeRegistry[pName].Req }
        end
    end
    CachedMastery = owned
    return owned
end

