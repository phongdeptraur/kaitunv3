        Axiom.HuntingTyrant = false
        SetLog("Target: Tyrant", "Tyrant not found in Deep Scan. Hopping...")
        HopTyrantServer()
        return
    end

    Axiom.HuntingTyrant = true
    while boss and bHum and bHum.Health > 0 and GetHRP() and Axiom.Running and Axiom.AutoGodhuman do
        local targetPos = bRoot and bRoot.Position or (Axiom.BossCache["Tyrant"] and Axiom.BossCache["Tyrant"].Position)
