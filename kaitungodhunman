local function FindBossDeepScan(targetName)
    ExpandStreamingRadius()
    local targetNameLower = targetName:lower()
    
    local dirs = { 
        workspace:FindFirstChild("Enemies"), 
        ReplicatedStorage, 
        workspace:FindFirstChild("NPCs"),
        workspace 
    }
    
    for _, dir in ipairs(dirs) do
        if dir then
            for _, obj in ipairs(dir:GetDescendants()) do
                if obj:IsA("Humanoid") and obj.Health > 0 then
                    local model = obj.Parent
                    if model and model:IsA("Model") and model.Name:lower():find(targetNameLower, 1, true) then
                        local hrp = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Torso") or model:FindFirstChild("UpperTorso")
                        if hrp then
                            Axiom.BossCache[targetName] = { Model = model, Humanoid = obj, RootPart = hrp, Position = hrp.Position }
                            return model, obj, hrp
                        end
                    end
                end
            end
        end
    end

    if getnilinstances then
        pcall(function()
            for _, inst in ipairs(getnilinstances()) do
                if inst:IsA("Model") and inst.Name:lower():find(targetNameLower, 1, true) then
                    local h = inst:FindFirstChildOfClass("Humanoid")
                    local r = inst:FindFirstChild("HumanoidRootPart") or inst:FindFirstChild("Torso")
                    if h and h.Health > 0 and r then
                        Axiom.BossCache[targetName] = { Model = inst, Humanoid = h, RootPart = r, Position = r.Position }
                    end
                end
            end
        end)
    end
    
    local cache = Axiom.BossCache[targetName]
    if cache and cache.Humanoid and cache.Humanoid.Parent and cache.Humanoid.Health > 0 then
        return cache.Model, cache.Humanoid, cache.RootPart
    end

    return nil, nil, nil
end

-- Quét tìm Trái Ác Quỷ rơi trên mặt đất trong Server
local function FindDroppedFruit()
    ExpandStreamingRadius()
    local hrp = GetHRP()
    local bestFruit, bestHandle, minDist = nil, nil, math.huge

    for _, obj in ipairs(workspace:GetChildren()) do
        if (obj:IsA("Tool") or obj:IsA("Model")) and not Players:GetPlayerFromCharacter(obj) then
            local nameLower = obj.Name:lower()
            local isFruit = nameLower:find("fruit") or obj:FindFirstChild("Fruit") or obj:GetAttribute("IsFruit")
            if isFruit then
                local handle = obj:FindFirstChild("Handle") or obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true)
                if handle and handle:IsA("BasePart") then
                    local d = hrp and (hrp.Position - handle.Position).Magnitude or 0
                    if d < minDist then
                        minDist = d
                        bestFruit = obj
                        bestHandle = handle
                    end
                end
            end
        end
    end

    local playafs = workspace:FindFirstChild("Playability") or workspace:FindFirstChild("DroppedFruits")
    if playafs then
        for _, obj in ipairs(playafs:GetChildren()) do
            local handle = obj:FindFirstChild("Handle") or obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true)
            if handle and handle:IsA("BasePart") then
                local d = hrp and (hrp.Position - handle.Position).Magnitude or 0
                if d < minDist then
                    minDist = d
                    bestFruit = obj
                    bestHandle = handle
                end
            end
        end
    end

    return bestFruit, bestHandle
end

