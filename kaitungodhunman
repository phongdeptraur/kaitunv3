local CurrentFarmSpot = ""

local lastQuestClaimTick = 0



local function AutoClaimQuest(questName, questLevel, mobName)

    if not questName or not questLevel then return end

    local spotKey = tostring(questName) .. "_" .. tostring(questLevel)

    local hasQ = HasQuest()



    -- TRƯỜNG HỢP 1: Chuyển sang một bãi farm / mục tiêu quest mới

    if CurrentFarmSpot ~= spotKey then

        CurrentFarmSpot = spotKey

        if hasQ then

            local activeTitle = GetActiveQuestTitle():lower()

            local mobKeyword = mobName and tostring(mobName):lower() or ""

            local isMatching = (mobKeyword ~= "" and string.find(activeTitle, mobKeyword, 1, true) ~= nil)

            

            -- Nếu đang ôm quest của bãi cũ không khớp với bãi mới -> Hủy quest ngay lập tức

            -- [BẢO VỆ]: Tuyệt đối không hủy nếu đang ôm một trong các quest bone ở Haunted Castle

            local isBoneQuestHolding = string.find(activeTitle, "skeleton") or string.find(activeTitle, "zombie") 

                or string.find(activeTitle, "demonic") or string.find(activeTitle, "mummy") 

                or string.find(activeTitle, "posessed") or string.find(activeTitle, "haunted")

            if not isMatching and not isBoneQuestHolding then

                pcall(function()

                    if CommF_ then

                        CommF_:InvokeServer("AbandonQuest")

                    end

                end)

                task.wait(0.25)

                hasQ = HasQuest()

            end

        end

        

        -- Lập tức nhận quest của bãi mới nếu hiện tại không còn quest nào

        if not hasQ then

            lastQuestClaimTick = os.clock()

            pcall(function()

                if CommF_ then

                    CommF_:InvokeServer("StartQuest", questName, questLevel)

                end

            end)

        end

        return

    end



    -- TRƯỜNG HỢP 2: Đang farm tại cùng một bãi

    -- Nếu đang có quest (HasQuest = true) -> TUYỆT ĐỐI KHÔNG NHẬN THÊM, BỎ QUA NGAY

    if hasQ then

        return

    end



    -- Đã hết/mất quest -> Nhận lại quest mới với debounce 2.5s chống spam Remote

    local now = os.clock()

    if now - lastQuestClaimTick >= 2.5 then

        lastQuestClaimTick = now

        pcall(function()

            if CommF_ then

                CommF_:InvokeServer("StartQuest", questName, questLevel)

            end

        end)

    end

end



