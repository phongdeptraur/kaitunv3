_G.AxiomUnload = function()

    ResetCharacterState()

    SetAntiGravity(false)

    local myChar = game:GetService("Players").LocalPlayer and game:GetService("Players").LocalPlayer.Character

    local hrp = myChar and myChar:FindFirstChild("HumanoidRootPart")

    if hrp then

        local bv = hrp:FindFirstChild("__AxiomHoverStabilizer")

        if bv then bv:Destroy() end

    end

    workspace.Gravity = 196.2

    Axiom.Running = false

    Axiom.AutoGodhuman = false

    SetAntiGravity(false)

    ClearAllMagnetMobs()

    

    -- 1. Hủy toàn bộ kết nối RunService / Event

    for _, conn in pairs(Axiom.Connections) do

        pcall(function() conn:Disconnect() end)

    end

    table.clear(Axiom.Connections)

    

    -- [AXIOM] Clean Quest Watchers & Signals

    if Axiom.QuestEngine then

        pcall(function() Axiom.QuestEngine:Destroy() end)

        Axiom.QuestEngine = nil

    end

    

    -- 2. Hủy Tween và BodyMovers

    if Axiom.TweenInstance then

        pcall(function() Axiom.TweenInstance:Cancel() end)

    end

    

    local hrp = GetHRP()

    if hrp then

        for _, obj in pairs(hrp:GetChildren()) do

            if obj:IsA("BodyVelocity") or obj:IsA("BodyGyro") or string.find(obj.Name, "Axiom") then

                obj:Destroy()

            end

        end

    end

    

    -- 3. Phục hồi Humanoid

    local hum = GetHum()

    if hum then

        hum.PlatformStand = false

    end

    

    -- 4. Xóa ScreenGui khỏi hệ thống

