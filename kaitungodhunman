local function EquipMelee(meleeName, allowNpcTravel)
    local char = GetChar()
    if not char or not meleeName then return false end
    local held = char:FindFirstChildOfClass("Tool")
    if held and (MatchMeleeName(held.Name, meleeName) or held.Name:lower():find(meleeName:lower(), 1, true)) then return true end

    local bp = LocalPlayer:FindFirstChild("Backpack")
    if bp then
        for _, t in ipairs(bp:GetChildren()) do
            if t:IsA("Tool") and (MatchMeleeName(t.Name, meleeName) or t.Name:lower():find(meleeName:lower(), 1, true)) then
                if GetHum() then GetHum():EquipTool(t); return true end
            end
        end
    end

    if (meleeName == "Yama" or meleeName == "Tushita") and CommF_ then
        pcall(function() CommF_:InvokeServer("LoadItem", meleeName) end)
        task.wait(0.2)
        if bp then
            for _, t in ipairs(bp:GetChildren()) do
                if t:IsA("Tool") and t.Name:lower():find(meleeName:lower(), 1, true) then
                    if GetHum() then GetHum():EquipTool(t); return true end
                end
            end
        end
    end

    if allowNpcTravel ~= false and MeleeRegistry[meleeName] then
        local reg = MeleeRegistry[meleeName]
        if GetCurrentSea() ~= 3 then TravelToSea(3); task.wait(2.5); return false end
        SetLog("Equip/Buy " .. meleeName, "Tweening to " .. reg.NPC)
        if TweenTo(reg.CFrame + Vector3.new(0, 4, 0)) then
            task.wait(0.3)
            if GetHum() then pcall(function() GetHum():UnequipTools() end) end
            if reg.BuyRemote == "BlackbeardReward" then
                CommF_:InvokeServer("BlackbeardReward", "DragonClaw", "1")
                CommF_:InvokeServer("BlackbeardReward", "DragonClaw", "2")
            elseif reg.BuyRemote then
                CommF_:InvokeServer(reg.BuyRemote)
            end
            task.wait(0.4)
            return EquipMelee(meleeName, false)
        end
    end
    return false
end

