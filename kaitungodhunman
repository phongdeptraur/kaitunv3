local function RunAutoGodhumanStep()
    if not Axiom.Running or not Axiom.AutoGodhuman or isAutoGodhumanStepBusy or Axiom.IsTweening or IsHopping or IsTyrantHopping or isWaitingTyrantHop then return end
    isAutoGodhumanStepBusy = true

    pcall(function()
        if not GetChar() or not GetHRP() then EnsureTeamSelected(); return end
        local owned = FetchOwnedMastery()
        local beli = GetCurrency("Beli")
        local frags = GetCurrency("Fragments")
        local lvl = GetPlayerLevel()

        -- [ƯU TIÊN KHẨN CẤP]: NẾU ĐANG CẦM FIRE ESSENCE TRONG NGƯỜI -> NỘP NGAY LẬP TỨC, CẤM HOP!
        if CheckHasFireEssence() and not owned["Dragon Talon"] and not FireEssenceDelivered and UzothStatus ~= "0" and UzothStatus ~= "1" then
            DeliverFireEssenceToUzoth()
            return
        end

        -- ======================================================================
        -- GIAI ĐOẠN 1: LEVEL < 1975 -> CHỈ SĂN TYRANT OF THE SKIES LẤY CẤP & FRAGS
        -- ======================================================================
        if lvl < 1975 then
            _G.RealKidMainActive = false
            if GetCurrentSea() ~= 3 then TravelToSea(3); task.wait(2.5); return end
            if not _G.AxiomPreTweenedTiki then
                local b, h = FindTyrantBoss()
                if not (b and h and h.Health > 0) then
                    local tikiCF = CFrame.new(-16204, 30, 479)
                    if (GetHRP().Position - tikiCF.Position).Magnitude > 80 then
                        SetLog("Pre-Tween Tiki (1x)", string.format("Lv %d/1975 | Moving to Tiki...", lvl))
                        TweenTo(tikiCF, true)
                    end
                end
                _G.AxiomPreTweenedTiki = true
            end
            local tBoss, tHum = FindTyrantBoss()
            if tBoss and tHum and tHum.Health > 0 then
                FarmTyrantRealtime(GetAnyUnmaxedOwnedMelee(owned))
            else
                SetLog("Tyrant Hop", string.format("Lv %d/1975 | Finding Tyrant...", lvl))
                TriggerRealKidHop()
            end
            return
        end

        -- ======================================================================
        -- BƯỚC 0: ĐÃ CÓ GODHUMAN -> CÀY LÊN 600 MASTERY
        -- ======================================================================
        if owned["Godhuman"] or GodhumanUnlocked or CheckGodhumanStatus() == "1" then
            GodhumanUnlocked = true
            local gMast = (owned["Godhuman"] and owned["Godhuman"].Mastery) or 1
            if gMast < 600 then
                FarmBoneMastery("Godhuman")
            else
                SetLog("🎉 GODHUMAN MAXED", "600/600 Mastery Complete!")
            end
            return
        end

        -- ======================================================================
        -- BƯỚC 1: SỞ HỮU MELEE V2 THEO THỨ TỰ ƯU TIÊN:
        -- Dragon Talon -> Electric Claw -> Sharkman Karate -> Death Step -> Superhuman
        -- ======================================================================
        local v2Order = { "Dragon Talon", "Electric Claw", "Sharkman Karate", "Death Step", "Superhuman" }
        local targetV2 = nil
        local isBonesOnCD, cdStr = CheckBoneCooldown()
        local uStat = CheckDragonTalonUzothStatus()

        for _, v2Name in ipairs(v2Order) do
            local isOwned = owned[v2Name] or (v2Name == "Dragon Talon" and tostring(uStat) == "1")
            if not isOwned then
                if v2Name == "Dragon Talon" then
                    local submitted = FireEssenceDelivered or tostring(uStat) == "0"
                    -- Nếu Dragon Claw đã đủ 400 Mastery, chưa nộp Fire Essence mà Bones đang dính CD -> Tạm Skip sang V2 tiếp theo!
                    if not submitted and not CheckHasFireEssence() and owned["Dragon Claw"] and owned["Dragon Claw"].Mastery >= 400 and isBonesOnCD then
                        continue
                    end
                end
                targetV2 = v2Name
                break
            end
        end

        if targetV2 then
            -- 1.1: DRAGON TALON
            if targetV2 == "Dragon Talon" then
                local dc = owned["Dragon Claw"]
                if not dc then
                    if frags < 1500 then FarmTyrantRealtime(GetAnyUnmaxedOwnedMelee(owned)); return end
                    EquipMelee("Dragon Claw", true); return
                end
                if dc.Mastery < 400 then FarmBoneMastery("Dragon Claw"); return end

                local submitted = FireEssenceDelivered or tostring(uStat) == "0"
                if not submitted then
                    -- Chưa nộp Essence và Bones đang không CD -> Cắm cọc Haunted Castle cày Mastery V2 sẵn có + Roll Bones 3s
                    FarmBoneMastery(GetAnyUnmaxedOwnedMelee(owned))
                    return
                end

                -- Đã nộp Fire Essence cho Uzoth -> Check Frags (Tyrant) & Beli (Chest Hop) rồi mua ngay
                if frags < 5000 then FarmTyrantRealtime(GetAnyUnmaxedOwnedMelee(owned)); return end
                if beli < 3000000 then FarmChestHop30("Need 3M Beli for Dragon Talon"); return end
                EquipMelee("Dragon Talon", true)
                return
            end

            -- 1.2: ELECTRIC CLAW
            if targetV2 == "Electric Claw" then
                local el = owned["Electro"]
                if not el then
                    if beli < 500000 then FarmChestHop30("Need 500K Beli for Electro"); return end
                    EquipMelee("Electro", true); return
                end
                if el.Mastery < 400 then FarmBoneMastery("Electro"); return end

                local ecStat = CommF_ and CommF_:InvokeServer("BuyElectricClaw", true)
                if tostring(ecStat) == "4" then
                    if GetCurrentSea() ~= 3 then TravelToSea(3); task.wait(2.5); return end
                    SetLog("Electric Claw Trial", "Tweening to Mansion...")
                    if TweenTo(CFrame.new(-12547.71, 320.14, -7487.06)) then
                        task.wait(0.3); CommF_:InvokeServer("BuyElectricClaw", "Start")
                    end
                    return
                end
                if frags < 5000 then FarmTyrantRealtime(GetAnyUnmaxedOwnedMelee(owned)); return end
                if beli < 3000000 then FarmChestHop30("Need 3M Beli for Electric Claw"); return end
                EquipMelee("Electric Claw", true)
                return
            end

            -- 1.3: SHARKMAN KARATE
            if targetV2 == "Sharkman Karate" then
                local fk = owned["Fishman Karate"]
                if not fk then
                    if beli < 750000 then FarmChestHop30("Need 750K Beli for Fishman Karate"); return end
                    EquipMelee("Fishman Karate", true); return
                end
                if fk.Mastery < 400 then FarmBoneMastery("Fishman Karate"); return end

                local bp = LocalPlayer:FindFirstChild("Backpack")
                local hasWK = (GetChar() and GetChar():FindFirstChild("Water Key")) or (bp and bp:FindFirstChild("Water Key"))
                if hasWK then
                    if TweenTo(MeleeRegistry["Sharkman Karate"].CFrame + Vector3.new(0, 4, 0)) then
                        CommF_:InvokeServer("BuySharkmanKarate", true); WaterKeyDelivered = true
                    end
                    return
                end
                if not WaterKeyDelivered then
                    local ok, res = pcall(function() return CommF_:InvokeServer("BuySharkmanKarate", true) end)
                    if ok and tostring(res):lower():find("key") then FarmTideKeeper(GetAnyUnmaxedOwnedMelee(owned)); return
                    else WaterKeyDelivered = true end
                end
                if frags < 5000 then FarmTyrantRealtime(GetAnyUnmaxedOwnedMelee(owned)); return end
                if beli < 2500000 then FarmChestHop30("Need 2.5M Beli for Sharkman Karate"); return end
                EquipMelee("Sharkman Karate", true)
                return
            end

            -- 1.4: DEATH STEP
            if targetV2 == "Death Step" then
                local bl = owned["Black Leg"]
                if not bl then
                    if beli < 150000 then FarmChestHop30("Need 150K Beli for Black Leg"); return end
                    EquipMelee("Black Leg", true); return
                end
                if bl.Mastery < 400 then FarmBoneMastery("Black Leg"); return end
                if frags < 5000 then FarmTyrantRealtime(GetAnyUnmaxedOwnedMelee(owned)); return end
                if beli < 2500000 then FarmChestHop30("Need 2.5M Beli for Death Step"); return end
                EquipMelee("Death Step", true)
                return
            end

            -- 1.5: SUPERHUMAN
            if targetV2 == "Superhuman" then
                for _, pName in ipairs({ "Black Leg", "Electro", "Fishman Karate", "Dragon Claw" }) do
                    local pData = owned[pName]
                    local reg = MeleeRegistry[pName]
                    if not pData then
                        if reg.Frags > 0 and frags < reg.Frags then FarmTyrantRealtime(GetAnyUnmaxedOwnedMelee(owned)); return end
                        if reg.Beli > 0 and beli < reg.Beli then FarmChestHop30("Need Beli for " .. pName); return end
                        EquipMelee(pName, true); return
                    elseif pData.Mastery < 300 then
                        FarmBoneMastery(pName); return
                    end
                end
                if beli < 3000000 then FarmChestHop30("Need 3M Beli for Superhuman"); return end
                EquipMelee("Superhuman", true)
                return
            end
        end

        -- ======================================================================
        -- BƯỚC 2: CÀY 400 MASTERY LẦN LƯỢT CÁC MELEE V2 ĐÃ CÓ (HOẶC TRONG LÚC ĐỢI CD BONES)
        -- ======================================================================
        for _, v2Name in ipairs(v2Order) do
            if owned[v2Name] and owned[v2Name].Mastery < 400 then
                FarmBoneMastery(v2Name)
                return
            end
        end

        -- Nếu vẫn chưa lấy được Dragon Talon (do đang đợi CD Bones) -> Tiếp tục cày Bones ở Haunted Castle để canh hết CD là Roll ngay
        if not owned["Dragon Talon"] and tostring(uStat) ~= "1" then
            FarmBoneMastery(GetAnyUnmaxedOwnedMelee(owned))
            return
        end

        -- ======================================================================
        -- BƯỚC 3: QUÉT NGUYÊN LIỆU GODHUMAN (KẾT HỢP CẦM VŨ KHÍ CHƯA MAX)
        -- ======================================================================
        if CheckGodhumanStatus() ~= "0" and not GodhumanMaterialsDelivered then
            for _, matName in ipairs({ "Dragon Scale", "Fish Tail", "Mystic Droplet", "Magma Ore" }) do
                local cfg = MaterialFarmTargets[matName]
                if GetMaterialCount(matName, cfg.ItemId) < cfg.Required then
                    FarmMaterial(matName, GetAnyUnmaxedOwnedMelee(owned))
                    return
                end
            end
        end

        -- ======================================================================
        -- BƯỚC 4: KIỂM TRA TÀI NGUYÊN CUỐI CÙNG & MUA GODHUMAN
        -- ======================================================================
        if frags < 5000 then FarmTyrantRealtime(GetAnyUnmaxedOwnedMelee(owned)); return end
        if beli < 5000000 then FarmChestHop30("Need 5M Beli for Godhuman"); return end

        if GetCurrentSea() ~= 3 then TravelToSea(3); task.wait(2.5); return end
        SetLog("Unlocking Godhuman", "Tweening to Ancient Monk...")
        if TweenTo(MeleeRegistry["Godhuman"].CFrame + Vector3.new(0, 3, 0)) then
            task.wait(0.5)
            if CommF_ then CommF_:InvokeServer("BuyGodhuman") end
        end
    end)

    isAutoGodhumanStepBusy = false
end

