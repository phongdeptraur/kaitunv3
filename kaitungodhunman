-- [10] UNLOAD & MAIN LOOP
-- ==============================================================================
_G.AxiomUnload = function()
    Axiom.Running = false
    Axiom.AutoGodhuman = false
    _G.AutoGodhuman = false
    _G.AxiomGodhumanLoaded = nil
    SetAntiGravity(false)
    if Axiom.TweenInstance then pcall(function() Axiom.TweenInstance:Cancel() end) end
    for _, c in ipairs(Axiom.Connections) do pcall(function() c:Disconnect() end) end
    if Axiom.ScreenGui then pcall(function() Axiom.ScreenGui:Destroy() end) end
end

CreateMinimalUI()
task.spawn(function()
    while Axiom.Running do
        if Axiom.AutoGodhuman then pcall(RunAutoGodhumanStep) end
        task.wait(0.4)
    end
end)
