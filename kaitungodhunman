local function SaveVisitedHistory()

    if not writefile then return end

    pcall(function()

        local now = os.time()

        local cleaned = {}

        for jId, ts in pairs(VisitedHistory) do

            if type(ts) == "number" and (now - ts < TYRANT_CONFIG.BlacklistTTL) then

                cleaned[tostring(jId)] = ts

            end

        end

