local SESSION_FILE = "godhumansession"

local SESSION_TTL = 60



local function GetActiveSessions()

    local sessions = {}

    if isfile and isfile(SESSION_FILE) then

        pcall(function()

            local raw = readfile(SESSION_FILE)

            if raw and raw ~= "" then

                local data = HttpService:JSONDecode(raw)

                local now = os.time()

                if type(data) == "table" then

                    for jId, info in pairs(data) do

                        local t = (type(info) == "table" and info.time) or tonumber(info)

                        if t and (now - t < SESSION_TTL) then

                            sessions[tostring(jId)] = info

                        end

                    end

                end

            end

        end)

    end

    return sessions

end



local function RegisterMySession()

    if not writefile or not game.JobId or game.JobId == "" then return end

    pcall(function()

        local sessions = GetActiveSessions()

        sessions[tostring(game.JobId)] = {

            time = os.time(),

            player = LocalPlayer.Name,

            jobId = tostring(game.JobId),

            activity = (Axiom and Axiom.MainLog) or "Farming"

        }

        writefile(SESSION_FILE, HttpService:JSONEncode(sessions))

    end)

end



local function IsServerOccupiedByClone(jobId)

    if not jobId or jobId == "" then return false end

    local sessions = GetActiveSessions()

    local occ = sessions[tostring(jobId)]

    if occ then

        local t = (type(occ) == "table" and occ.time) or tonumber(occ)

        local pName = type(occ) == "table" and occ.player or ""

        if t and (os.time() - t < SESSION_TTL) and pName ~= LocalPlayer.Name then

            return true

        end

    end

    return false

end



