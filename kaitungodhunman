local function EquipMelee(mName, allowTravel)
    local c = GetChar()
    if not c or not mName then return false end
    
    local h = c:FindFirstChildOfClass("Tool")
    if h and (MatchMelee(h.Name, mName) or h.Name:lower():find(mName:lower(), 1, true)) then return true end

    if GetHum() then pcall(function() GetHum():UnequipTools() end) end
    task.wait(0.1)

    local bp = LocalPlayer:FindFirstChild("Backpack")
    if bp then
        for _, t in ipairs(bp:GetChildren()) do
            if t:IsA("Tool") and (MatchMelee(t.Name, mName) or t.Name:lower():find(mName:lower(), 1, true)) then
                if GetHum() then GetHum():EquipTool(t); return true end
            end
        end
    end
    
    if allowTravel ~= false and MeleeReg[mName] then
        local r = MeleeReg[mName]
        if GetCurrentSea() ~= 3 then TravelToSea(3); task.wait(2.5); return false end
        SetLog("Equip/Buy " .. mName, "Tweening directly to NPC...")
        
        if TweenTo(r.CF + Vector3.new(0, 4, 0)) then
            task.wait(0.3)
            if GetHum() then pcall(function() GetHum():UnequipTools() end) end
            
            if r.Buy == "BlackbeardReward" then 
                CommF_:InvokeServer("BlackbeardReward", "DragonClaw", "1")
                CommF_:InvokeServer("BlackbeardReward", "DragonClaw", "2")
            elseif r.Buy then 
                CommF_:InvokeServer(r.Buy) 
            end
            
            task.wait(0.4); return EquipMelee(mName, false)
        end
    end
    return false
end

