local function IsTyrantVisited(jobId)

    if not jobId or jobId == "" then return true end

    local jStr = tostring(jobId)

    local ts = VisitedHistory[jStr]

    if not ts then return false end

    if os.time() - ts >= TYRANT_CONFIG.BlacklistTTL then

        VisitedHistory[jStr] = nil

        SaveVisitedHistory()

        return false

    end

    return true

end



local function MarkTyrantVisited(jobId)

    if not jobId or jobId == "" then return end

    local jStr = tostring(jobId)

