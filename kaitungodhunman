local function FarmTyrantRealtime(meleeName)
    _G.RealKidMainActive = false
    if meleeName and not EquipMelee(meleeName, true) then return end
    if GetCurrentSea() ~= 3 then TravelToSea(3); task.wait(2.5); return end
    EquipBuso()

