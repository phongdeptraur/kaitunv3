-- ==============================================================================
local function RunAutoGodhumanStep()
    if not Axiom.Running or not Axiom.AutoGodhuman or isAutoGodhumanStepBusy or Axiom.IsTweening or IsHopping or IsTyrantHopping or isWaitingTyrantHop then return end
    isAutoGodhumanStepBusy = true
    pcall(function()
        if not GetChar() or not GetHRP() then EnsureTeamSelected(); return end
        local o, b, f, l = FetchOwnedMastery(), GetCurrency("Beli"), GetCurrency("Fragments"), GetPlayerLevel()

        -- Ưu tiên 1: Nếu đã có Godhuman -> Không farm Mastery mà đi farm Tyrant tới Max Level -> Sau đó Hop Fruits & Nhặt Fruit
        if o["Godhuman"] or GodhumanUnlocked or CheckGodhumanStatus() == "1" then
            GodhumanUnlocked = true
            if not IsPlayerMaxLevel() then
                _G.RealKidMainActive = false
                if GetCurrentSea() ~= 3 then TravelToSea(3); task.wait(2.5); return end
                if not _G.AxiomPreTweenedTiki then
                    local bo, hu = FindBossDeepScan("Tyrant")
                    if not (bo and hu and hu.Health > 0) then
                        local tkCF = CFrame.new(-16204, 30, 479)
                        if (GetHRP().Position - tkCF.Position).Magnitude > 80 then
                            SetLog("Pre-Tween Tiki (GH)", "Lv " .. l .. " | Moving to Tiki...")
                            TweenTo(tkCF)
                        end
                    end
                    _G.AxiomPreTweenedTiki = true
                end
                local tB, tH = FindBossDeepScan("Tyrant")
                if tB and tH and tH.Health > 0 then
                    FarmTyrantRealtime("Godhuman")
                else
                    SetLog("Tyrant Hop (To Max Lv)", "Lv " .. l .. " | Finding Tyrant...")
                    TriggerRealKidHop("Tyrant of Skies")
                end
            else
                -- Đã Max Level + Có Godhuman -> Quét Fruit rơi trên map để Tween nhặt & Hop "Fruits"
                CollectAndHopFruitRoutine()
            end
            return
        end

        if CheckHasFireEssence() and not o["Dragon Talon"] and not FireEssenceDelivered and UzothStatus ~= "0" and UzothStatus ~= "1" then
            DeliverFireEssenceToUzoth(); return
        end

        if l < 1975 then
            _G.RealKidMainActive = false
            if GetCurrentSea() ~= 3 then TravelToSea(3); task.wait(2.5); return end
            if not _G.AxiomPreTweenedTiki then
                local bo, hu = FindBossDeepScan("Tyrant")
                if not (bo and hu and hu.Health > 0) then
                    local tkCF = CFrame.new(-16204, 30, 479)
                    if (GetHRP().Position - tkCF.Position).Magnitude > 80 then SetLog("Pre-Tween Tiki", "Lv " .. l .. " | Moving..."); TweenTo(tkCF) end
                end
                _G.AxiomPreTweenedTiki = true
            end
            local tB, tH = FindBossDeepScan("Tyrant")
            if tB and tH and tH.Health > 0 then FarmTyrantRealtime(GetAnyUnmaxedOwnedMelee(o))
            else SetLog("Tyrant Hop", "Lv " .. l .. " | Finding Tyrant..."); TriggerRealKidHop("Tyrant of Skies") end
            return
        end

        local uStat, isBOnCd = CheckUzothStatus(), CheckBoneCooldown()
        local tV2 = nil
        for _, v in ipairs({ "Dragon Talon", "Electric Claw", "Sharkman Karate", "Death Step", "Superhuman" }) do
            local isO = o[v] or (v == "Dragon Talon" and tostring(uStat) == "1")
            if not isO then
                if v == "Dragon Talon" and not (FireEssenceDelivered or tostring(uStat) == "0") and not CheckHasFireEssence() and o["Dragon Claw"] and o["Dragon Claw"].Mastery >= 400 and isBOnCd then
                    continue
                end
                tV2 = v; break
            end
        end

        if tV2 then
            if tV2 == "Dragon Talon" then
                if not o["Dragon Claw"] then
                    if f < 1500 then FarmTyrantRealtime(GetAnyUnmaxedOwnedMelee(o)); return end
                    EquipMelee("Dragon Claw", true); return
                end
                if o["Dragon Claw"].Mastery < 400 then FarmMasteryRoutine("Dragon Claw"); return end
                if not (FireEssenceDelivered or tostring(uStat) == "0") then FarmMasteryRoutine(GetAnyUnmaxedOwnedMelee(o)); return end
                if f < 5000 then FarmTyrantRealtime(GetAnyUnmaxedOwnedMelee(o)); return end
                if b < 3000000 then FarmChestHop30("Need 3M for DT"); return end
                EquipMelee("Dragon Talon", true); return
            end
            if tV2 == "Electric Claw" then
                if not o["Electro"] then if b < 500000 then FarmChestHop30("Need 500K for Electro"); return end; EquipMelee("Electro", true); return end
                if o["Electro"].Mastery < 400 then FarmMasteryRoutine("Electro"); return end
                
                if tostring(CommF_ and CommF_:InvokeServer("BuyElectricClaw", true)) == "4" then
                    if GetCurrentSea() ~= 3 then TravelToSea(3); task.wait(2.5); return end
                    SetLog("E-Claw Trial", "Tweening to Mansion..."); if TweenTo(CFrame.new(-12547.71, 320.14, -7487.06)) then task.wait(0.3); CommF_:InvokeServer("BuyElectricClaw", "Start") end
                    return
                end
                if f < 5000 then FarmTyrantRealtime(GetAnyUnmaxedOwnedMelee(o)); return end
                if b < 3000000 then FarmChestHop30("Need 3M for EC"); return end
                EquipMelee("Electric Claw", true); return
            end
            if tV2 == "Sharkman Karate" then
                if not o["Fishman Karate"] then if b < 750000 then FarmChestHop30("Need 750K for Fishman Karate"); return end; EquipMelee("Fishman Karate", true); return end
                if o["Fishman Karate"].Mastery < 400 then FarmMasteryRoutine("Fishman Karate"); return end
                
                local bp = LocalPlayer:FindFirstChild("Backpack")
                local char = GetChar()
                if (char and char:FindFirstChild("Water Key")) or (bp and bp:FindFirstChild("Water Key")) then
                    pcall(function() CommF_:InvokeServer("BuySharkmanKarate", true) end)
                    WaterKeyDelivered = true
                end
                
                if not WaterKeyDelivered then
                    local ok, res = pcall(function() return CommF_:InvokeServer("BuySharkmanKarate", true) end)
                    if ok and (tostring(res) == "2" or tostring(res):lower():find("lost")) then 
                        FarmTideKeeper(GetAnyUnmaxedOwnedMelee(o))
                        return
                    else 
                        WaterKeyDelivered = true 
                    end
                end

                if f < 5000 then FarmTyrantRealtime(GetAnyUnmaxedOwnedMelee(o)); return end
                if b < 2500000 then FarmChestHop30("Need 2.5M for Sharkman"); return end
                
                EquipMelee("Sharkman Karate", true); return
            end
            if tV2 == "Death Step" then
                if not o["Black Leg"] then if b < 150000 then FarmChestHop30("Need 150K for Black Leg"); return end; EquipMelee("Black Leg", true); return end
                if o["Black Leg"].Mastery < 400 then FarmMasteryRoutine("Black Leg"); return end
                
                local bp = LocalPlayer:FindFirstChild("Backpack")
                local char = GetChar()
                if (char and char:FindFirstChild("Library Key")) or (bp and bp:FindFirstChild("Library Key")) then
                    pcall(function() CommF_:InvokeServer("BuyDeathStep", true) end)
                    LibraryKeyDelivered = true
                end

                if not LibraryKeyDelivered then
                    local ok, res = pcall(function() return CommF_:InvokeServer("BuyDeathStep", true) end)
                    if ok and (tostring(res) == "2" or tostring(res):lower():find("library") or tostring(res):lower():find("key")) then 
                        FarmAwakenedIceAdmiral(GetAnyUnmaxedOwnedMelee(o))
                        return
                    else
                        LibraryKeyDelivered = true
                    end
                end

                if f < 5000 then FarmTyrantRealtime(GetAnyUnmaxedOwnedMelee(o)); return end
                if b < 2500000 then FarmChestHop30("Need 2.5M for Death Step"); return end
                
                EquipMelee("Death Step", true); return
            end
            if tV2 == "Superhuman" then
                for _, pN in ipairs({ "Black Leg", "Electro", "Fishman Karate", "Dragon Claw" }) do
                    if not o[pN] then
                        if MeleeReg[pN].F > 0 and f < MeleeReg[pN].F then FarmTyrantRealtime(GetAnyUnmaxedOwnedMelee(o)); return end
                        if MeleeReg[pN].B > 0 and b < MeleeReg[pN].B then FarmChestHop30("Need Beli for " .. pN); return end
                        EquipMelee(pN, true); return
                    elseif o[pN].Mastery < 300 then FarmMasteryRoutine(pN); return end
                end
                if b < 3000000 then FarmChestHop30("Need 3M for Superhuman"); return end
                EquipMelee("Superhuman", true); return
            end
        end

        for _, v in ipairs({ "Dragon Talon", "Electric Claw", "Sharkman Karate", "Death Step", "Superhuman" }) do
            if o[v] and o[v].Mastery < 400 then FarmMasteryRoutine(v); return end
        end
        if not o["Dragon Talon"] and tostring(uStat) ~= "1" then FarmMasteryRoutine(GetAnyUnmaxedOwnedMelee(o)); return end

        if CheckGodhumanStatus() ~= "0" and not GodhumanMaterialsDelivered then
            local mat = NeedGodhumanMaterials()
            if mat then FarmMaterial(mat, GetAnyUnmaxedOwnedMelee(o)); return end
        end

        if f < 5000 then FarmTyrantRealtime(GetAnyUnmaxedOwnedMelee(o)); return end
        if b < 5000000 then FarmChestHop30("Need 5M for Godhuman"); return end
        if GetCurrentSea() ~= 3 then TravelToSea(3); task.wait(2.5); return end
        
        SetLog("Unlocking Godhuman", "Tweening to Ancient Monk...")
        if TweenTo(MeleeReg["Godhuman"].CF + Vector3.new(0, 3, 0)) then
            task.wait(0.5)
            if CommF_ then
                local res = CommF_:InvokeServer("BuyGodhuman")
                if tostring(res) == "1" or res == true then
                    GodhumanUnlocked = true
                end
            end
        end
    end)
    isAutoGodhumanStepBusy = false
end

