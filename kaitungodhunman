local function MatchMeleeName(toolName, targetName)

    if not toolName or not targetName then return false end

    local tClean = string.lower(toolName):gsub("[%s%-_]", "")

    local targetClean = string.lower(targetName):gsub("[%s%-_]", "")



    -- Chống xung đột alias chéo giữa Melee V1 và V2

    if targetClean == "electro" and string.find(tClean, "claw") then return false end

    if targetClean == "dragonclaw" and string.find(tClean, "talon") then return false end

    if targetClean == "fishmankarate" and string.find(tClean, "sharkman") then return false end

    if targetClean == "blackleg" and string.find(tClean, "death") then return false end



    if tClean == targetClean or string.find(tClean, targetClean, 1, true) then

        return true

    end



    local aliases = MeleeAliases[targetName]

    if aliases then

        for _, alias in ipairs(aliases) do

            local aClean = string.lower(alias):gsub("[%s%-_]", "")

            if string.find(tClean, aClean, 1, true) then

                return true

            end

        end

    end

    return false

end



