    if char then

        for _, t in ipairs(char:GetChildren()) do

            if t:IsA("Tool") and string.find(string.lower(t.Name), string.lower(swordName), 1, true) then

                tool = t

                break

            end

        end

    end



    if not tool and bp then

        for _, t in ipairs(bp:GetChildren()) do

            if t:IsA("Tool") and string.find(string.lower(t.Name), string.lower(swordName), 1, true) then

                tool = t

                break

            end

        end

    end



    local owned = false

    local mastery = CachedSwordMastery[swordName] or 0



    if tool then

        owned = true

        local lvlObj = tool:FindFirstChild("Level") or tool:FindFirstChild("Mastery")

        if lvlObj and tonumber(lvlObj.Value) and tonumber(lvlObj.Value) > 0 then

            mastery = tonumber(lvlObj.Value)

        elseif char and char:FindFirstChildOfClass("Tool") == tool then

            local liveM = GetCurrentEquippedMastery()

            if liveM and liveM > 0 then mastery = liveM end

        end

    end



    if CommF_ and (not owned or mastery == 0) then

        pcall(function()

            local inv = CommF_:InvokeServer("getInventory")

            if type(inv) == "table" then

                for _, item in pairs(inv) do

                    if type(item) == "table" and item.Name and string.find(string.lower(item.Name), string.lower(swordName), 1, true) then

                        owned = true

                        local m = tonumber(item.Mastery) or tonumber(item.Value) or tonumber(item.Level)

                        if m and m > 0 then

                            mastery = math.max(mastery, m)

                        end

                        break

                    end

                end

            end

        end)

    end



    if owned and mastery > 0 then

        CachedSwordMastery[swordName] = math.max(CachedSwordMastery[swordName] or 0, mastery)

    end



    return owned, (CachedSwordMastery[swordName] or mastery)

end



