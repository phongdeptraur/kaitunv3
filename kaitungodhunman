local SESSION_FILE, SESSION_TTL, VisitedServers = "godhumansession", 60, {}
local function GetActiveSessions()
    local s = {}
    if isfile and isfile(SESSION_FILE) then
        pcall(function()
            for jId, info in pairs(HttpService:JSONDecode(readfile(SESSION_FILE)) or {}) do
                local t = (type(info) == "table" and info.time) or tonumber(info)
                if t and (os.time() - t < SESSION_TTL) then s[tostring(jId)] = info end
            end
        end)
    end
    return s
end

local function IsServerOccupied(jobId)
    local occ = GetActiveSessions()[tostring(jobId)]
    if occ then
        local t, p = (type(occ) == "table" and occ.time) or tonumber(occ), type(occ) == "table" and occ.player or ""
        if t and (os.time() - t < SESSION_TTL) and p ~= LocalPlayer.Name then return true end
    end
    return false
end

local function HopLowServer()
    if IsHopping then return end
    IsHopping = true; SetLog("Hop Low Server", "Scanning for least populated server...")
    
    task.spawn(function()
        while Axiom.Running and IsHopping do
            local sb = ReplicatedStorage:FindFirstChild("__ServerBrowser")
            local rawServers = {}
            local pagesCompleted = 0
            local targetPages = 150
            local startScrape = os.clock()

            if sb then
                for page = 1, targetPages do
                    task.spawn(function()
                        for attempt = 1, 2 do
                            local ok, res = pcall(function() return sb:InvokeServer(page) end)
                            if ok and type(res) == "table" then
                                for jId, data in pairs(res) do
                                    local c = (type(data) == "table" and tonumber(data.Count)) or tonumber(data) or 99
                                    local jStr = tostring(jId)
                                    if c <= 5 and jStr ~= tostring(game.JobId) and not table.find(VisitedServers, jStr) then
                                        rawServers[jStr] = c
                                    end
                                end
                                break
                            end
                            task.wait(0.04)
                        end
                        pagesCompleted = pagesCompleted + 1
                    end)
                end
                
                repeat task.wait(0.05) until pagesCompleted >= targetPages or (os.clock() - startScrape >= 3.5)

                local bestJob, minP = nil, 6
                for jStr, c in pairs(rawServers) do
                    if c < minP and not IsServerOccupied(jStr) then
                        bestJob = jStr
                        minP = c
                    end
                end
                
                if bestJob then
                    table.insert(VisitedServers, bestJob)
                    pcall(function()
                        local s = GetActiveSessions()
                        s[bestJob] = { time = os.time(), player = LocalPlayer.Name, jobId = bestJob }
                        if writefile then writefile(SESSION_FILE, HttpService:JSONEncode(s)) end
                    end)
                    SetLog("Hopping", string.format("Job: %s | P: %d", bestJob:sub(1,8), minP))
                    
                    if not pcall(function() sb:InvokeServer("teleport", bestJob) end) then
                        TeleportService:TeleportToPlaceInstance(game.PlaceId, bestJob, LocalPlayer)
                    end
                    task.wait(6)
                end
            end
            
            local cursor = ""
            local loopCount = 0
            local bestApiJob, minApiP = nil, 6
            while cursor and loopCount < 5 do
                loopCount = loopCount + 1
                local url = string.format("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100%s", game.PlaceId, (cursor ~= "" and "&cursor=" .. cursor or ""))
                local ok, res = pcall(function() return game:HttpGet(url) end)
                if ok and res then
                    local okJson, data = pcall(function() return HttpService:JSONDecode(res) end)
                    if okJson and data and data.data then
                        for _, s in ipairs(data.data) do
                            local sId = tostring(s.id)
                            local sCount = tonumber(s.playing) or 0
                            if sCount <= 5 and sId ~= tostring(game.JobId) and not table.find(VisitedServers, sId) and not IsServerOccupied(sId) then
                                if sCount < minApiP then
                                    minApiP = sCount
                                    bestApiJob = sId
                                end
                            end
                        end
                        cursor = data.nextPageCursor
                        if not cursor or cursor == "" then break end
                    else
                        break
                    end
                else
                    break
                end
            end
            
            if bestApiJob then
                table.insert(VisitedServers, bestApiJob)
                pcall(function()
                    local sData = GetActiveSessions()
                    sData[bestApiJob] = { time = os.time(), player = LocalPlayer.Name, jobId = bestApiJob }
                    if writefile then writefile(SESSION_FILE, HttpService:JSONEncode(sData)) end
                end)
                SetLog("Hopping (API)", string.format("Job: %s | P: %d", bestApiJob:sub(1,8), minApiP))
                TeleportService:TeleportToPlaceInstance(game.PlaceId, bestApiJob, LocalPlayer)
                task.wait(6)
            end
            task.wait(1)
        end
    end)
end

