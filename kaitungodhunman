                local m = desc.Text:match("Mastery%s*([%d,]+)") or desc.Text:match("Lv%.?%s*([%d,]+)")

                if m then

                    local n = tonumber((m:gsub(",", "")))

                    if n and n > 0 then return n end

                end

            end

        end

    end

    return nil

end



