local function TweenTo(targetCFrame, speed)

    -- [AXIOM MANDATE]: Khi RealKid Main đang hoạt động -> TUYỆT ĐỐI KHÔNG ĐƯỢC PHÉP TỰ TWEEN!

    -- Nếu có lệnh tween, bắt buộc Hop Low để refresh vị trí nhân vật

    if _G.RealKidMainActive then

        warn("[AXIOM] RealKid Main đang chạy -> Nghiêm cấm tự tween! Tiến hành HopLowServer() để refresh...")

        task.spawn(HopLowServer)

        return false

    end



    speed = 190 -- [AXIOM ENFORCED] Strictly locked at 190 stud/s with zero exceptions

    if not Axiom.Running or not Axiom.AutoGodhuman then

        Axiom.IsTweening = false

        Axiom.CurrentTweenTarget = nil

        return false

    end



    local targetCF = typeof(targetCFrame) == "CFrame" and targetCFrame 

        or (typeof(targetCFrame) == "Vector3" and CFrame.new(targetCFrame)) 

        or (typeof(targetCFrame) == "Instance" and targetCFrame:IsA("BasePart") and targetCFrame.CFrame)

    if not targetCF then return false end



    speed = speed or 190

    local hrp = GetHRP()

    if not hrp then return false end

    

    local dist = (hrp.Position - targetCF.Position).Magnitude

    if dist <= 4 then

        Axiom.IsTweening = false

        Axiom.CurrentTweenTarget = nil

        return true

    end



    -- Chi cho phep tiep tuc neu thuc su co 1 TweenInstance dang hoat dong toi cung mot dich den

    if Axiom.IsTweening and Axiom.TweenInstance and Axiom.TweenInstance.PlaybackState == Enum.PlaybackState.Playing 

        and Axiom.CurrentTweenTarget and (Axiom.CurrentTweenTarget.Position - targetCF.Position).Magnitude <= 12 then

        return true

    end



    Axiom.IsTweening = true

    Axiom.CurrentTweenTarget = targetCF

    

    -- Giai phong BodyVelocity khong cho can tro TweenService

    local bv = hrp:FindFirstChild("__AxiomHoverStabilizer")

    if bv then

        bv.MaxForce = Vector3.zero

    end



    EnableNoclip()



    if Axiom.TweenInstance then

        pcall(function() Axiom.TweenInstance:Cancel() end)

        Axiom.TweenInstance = nil

    end



    local duration = dist / speed

    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)

    Axiom.TweenInstance = TweenService:Create(hrp, tweenInfo, { CFrame = targetCF })

    Axiom.TweenInstance:Play()

    

    local completed = false

    local conn

    conn = Axiom.TweenInstance.Completed:Connect(function()

        completed = true

        if conn then conn:Disconnect() end

    end)



    -- [AXIOM ANTI-LAGBACK WATCHDOG INITIALIZATION]

    local lastDist = dist

    local lagbackStrikes = 0



    while not completed and Axiom.Running and Axiom.AutoGodhuman do

        EnableNoclip()

        task.wait(0.08)

        

        local curHRP = GetHRP()

        if not curHRP then break end

        

        local curDist = (curHRP.Position - targetCF.Position).Magnitude

        if curDist <= 4 then

            if Axiom.TweenInstance then

                pcall(function() Axiom.TweenInstance:Cancel() end)

            end

            break

        end



        -- [AXIOM ANTI-LAGBACK MECHANISM]

        -- Khi bi giat lui ve vi tri cu (khoang cach tang vot >= 5 studs): ghi nhan strike

        if curDist > lastDist + 5 then

            lagbackStrikes = lagbackStrikes + 1

            if lagbackStrikes >= 5 then

                warn(string.format("[AXIOM ANTI-LAGBACK] Phat hien giat lui %d lan! Ngung tween, reset ve trang thai ban dau va cho 1s...", lagbackStrikes))

                if Axiom.TweenInstance then

                    pcall(function() Axiom.TweenInstance:Cancel() end)

                    Axiom.TweenInstance = nil

                end



                -- Phuc hoi trang thai vat ly goc cua nhan vat

                if curHRP and curHRP.Parent then

                    local activeBv = curHRP:FindFirstChild("__AxiomHoverStabilizer")

                    if activeBv then

                        activeBv.Velocity = Vector3.zero

                        activeBv.MaxForce = Vector3.new(1e9, 1e9, 1e9)

                    end

                    curHRP.AssemblyLinearVelocity = Vector3.zero

                    curHRP.AssemblyAngularVelocity = Vector3.zero

                end



                Axiom.IsTweening = false

                Axiom.CurrentTweenTarget = nil

                task.wait(1.0) -- Cho 1s on dinh ket noi server truoc khi cho phep tween tiep

                break

            end

        else

            if curDist < lastDist - 2 and lagbackStrikes > 0 then

                lagbackStrikes = math.max(0, lagbackStrikes - 1)

            end

        end

        lastDist = curDist



        if not Axiom.TweenInstance or Axiom.TweenInstance.PlaybackState ~= Enum.PlaybackState.Playing then

            break

        end

    end

    

    if conn then pcall(function() conn:Disconnect() end) end

    if Axiom.TweenInstance then Axiom.TweenInstance = nil end

    

    Axiom.IsTweening = false

    Axiom.CurrentTweenTarget = nil

    

    -- Chi phuc hoi luc giu vi tri khi van dang o che do Auto

    if Axiom.Running and Axiom.AutoGodhuman then

        local curHRP = GetHRP()

        if curHRP and curHRP.Parent then

            local activeBv = curHRP:FindFirstChild("__AxiomHoverStabilizer")

            if activeBv then

                activeBv.Velocity = Vector3.zero

                activeBv.MaxForce = Vector3.new(1e9, 1e9, 1e9)

            end

            curHRP.AssemblyLinearVelocity = Vector3.zero

            curHRP.AssemblyAngularVelocity = Vector3.zero

        end

    end

    

    return true

end



