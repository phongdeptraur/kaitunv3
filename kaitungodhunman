--!strict



type Connection = {

    Disconnect: (self: Connection) -> ()

}



type Signal<T...> = {

    Connect: (self: Signal<T...>, fn: (T...) -> ()) -> Connection,

    Fire: (self: Signal<T...>, T...) -> (),

    Destroy: (self: Signal<T...>) -> ()

}



local function FastSignal<T...>(): Signal<T...>

    local callbacks: { [(T...) -> ()]: boolean } = {}

    return {

        Connect = function(_, fn: (T...) -> ()): Connection

            callbacks[fn] = true

            return {

                Disconnect = function()

                    callbacks[fn] = nil

                end

            }

        end,

        Fire = function(_, ...)

            for cb in pairs(callbacks) do

                task.spawn(cb, ...)

            end

        end,

        Destroy = function()

            table.clear(callbacks)

        end

    }

end



export type QuestPayload = {

    IsActive: boolean,

    Title: string,

    Current: number,

    Target: number,

    ProgressText: string,

    Source: "TrackedQuestFrame" | "MainQuest" | "None"

}



local QuestManager = {}

QuestManager.__index = QuestManager



function QuestManager.new()

    local self = setmetatable({}, QuestManager)



    self._connections = {} :: { RBXScriptConnection }

    self._current = {

        IsActive = false,

        Title = "",

        Current = 0,

        Target = 0,

        ProgressText = "",

        Source = "None"

    } :: QuestPayload



    self.OnQuestUpdated = FastSignal() :: Signal<QuestPayload>

    self.OnQuestStateToggled = FastSignal() :: Signal<boolean, QuestPayload>



    self:_boot()

    return self

end



function QuestManager:_parseCounter(raw: string): (number, number)

    local cur, max = string.match(raw, "(%d+)%s*/%s*(%d+)")

    return tonumber(cur) or 0, tonumber(max) or 0

end



function QuestManager:Evaluate(): QuestPayload

    local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")

    if not playerGui then

        return {

            IsActive = false,

            Title = "",

            Current = 0,

            Target = 0,

            ProgressText = "",

            Source = "None"

        }

    end



    -- Layer 1: Modern Blox Fruits TrackedQuestFrame

    local trackedGui = playerGui:FindFirstChild("TrackedQuestFrame")

    if trackedGui and trackedGui:IsA("ScreenGui") and trackedGui.Enabled then

        local frame = trackedGui:FindFirstChild("Frame")

        if frame and frame:IsA("Frame") and frame.Visible then

            local header = frame:FindFirstChild("header")

            local titleText = ""

            if header then

                local label = header:FindFirstChild("textLabel")

                if label and label:IsA("TextLabel") then

                    titleText = label.Text

                end

            end



            local progressText = ""

            local progressLabel = frame:FindFirstChild("progress")

            if progressLabel and progressLabel:IsA("TextLabel") then

                progressText = progressLabel.Text

            end



            local cur, target = self:_parseCounter(progressText)

            if titleText ~= "" or cur > 0 or target > 0 then

                return {

                    IsActive = true,

                    Title = titleText,

                    Current = cur,

                    Target = target,

                    ProgressText = progressText,

                    Source = "TrackedQuestFrame"

                }

            end

        end

    end



    -- Layer 2: Legacy Main.Quest fallback

    local mainGui = playerGui:FindFirstChild("Main")

    if mainGui and mainGui:IsA("ScreenGui") then

        local legacyQuest = mainGui:FindFirstChild("Quest")

        if legacyQuest and legacyQuest:IsA("Frame") and legacyQuest.Visible then

            local container = legacyQuest:FindFirstChild("Container")

            local title = ""

            local progress = ""



            if container then

                local tObj = container:FindFirstChild("QuestTitle")

                if tObj then

                    local inner = tObj:FindFirstChild("Title") or tObj

                    if inner:IsA("TextLabel") then title = inner.Text end

                end



                local pObj = container:FindFirstChild("QuestProgress")

                if pObj and pObj:IsA("TextLabel") then

                    progress = pObj.Text

                end

            end



            local cur, target = self:_parseCounter(progress ~= "" and progress or title)

            return {

                IsActive = true,

                Title = title,

                Current = cur,

                Target = target,

                ProgressText = progress,

                Source = "MainQuest"

            }

        end

    end



    return {

        IsActive = false,

        Title = "",

        Current = 0,

        Target = 0,

        ProgressText = "",

        Source = "None"

    }

end



function QuestManager:_sync()

    local nextState = self:Evaluate()

    local prevState = self._current



    local stateChanged = (nextState.IsActive ~= prevState.IsActive)

    local dataChanged = (nextState.Current ~= prevState.Current) 

        or (nextState.Target ~= prevState.Target)

        or (nextState.Title ~= prevState.Title)



    self._current = nextState



    if stateChanged then

        self.OnQuestStateToggled:Fire(nextState.IsActive, nextState)

    end



    if nextState.IsActive and dataChanged then

        self.OnQuestUpdated:Fire(nextState)

    end

end



function QuestManager:_attachWatchers()

    for _, conn in ipairs(self._connections) do

        conn:Disconnect()

    end

    table.clear(self._connections)



    local playerGui = LocalPlayer:WaitForChild("PlayerGui", 30)

    if not playerGui then return end



    local function wireTracked(tracked: Instance)

        if not tracked:IsA("ScreenGui") then return end

        table.insert(self._connections, tracked:GetPropertyChangedSignal("Enabled"):Connect(function()

            self:_sync()

        end))



        local frame = tracked:WaitForChild("Frame", 5)

        if frame and frame:IsA("Frame") then

            table.insert(self._connections, frame:GetPropertyChangedSignal("Visible"):Connect(function()

                self:_sync()

            end))



            local progress = frame:WaitForChild("progress", 5)

            if progress and progress:IsA("TextLabel") then

                table.insert(self._connections, progress:GetPropertyChangedSignal("Text"):Connect(function()

                    self:_sync()

                end))

            end



            local header = frame:WaitForChild("header", 5)

            if header then

                local label = header:WaitForChild("textLabel", 5)

                if label and label:IsA("TextLabel") then

                    table.insert(self._connections, label:GetPropertyChangedSignal("Text"):Connect(function()

                        self:_sync()

                    end))

                end

            end

        end

    end



    local existingTracked = playerGui:FindFirstChild("TrackedQuestFrame")

    if existingTracked then

        wireTracked(existingTracked)

    end



    table.insert(self._connections, playerGui.ChildAdded:Connect(function(child)

        if child.Name == "TrackedQuestFrame" then

            wireTracked(child)

            task.wait(0.1)

            self:_sync()

        end

    end))



    -- Wire legacy Main.Quest

    local main = playerGui:FindFirstChild("Main")

    if main and main:IsA("ScreenGui") then

        local q = main:FindFirstChild("Quest")

        if q and q:IsA("Frame") then

            table.insert(self._connections, q:GetPropertyChangedSignal("Visible"):Connect(function()

                self:_sync()

            end))

        end

    end



    self:_sync()

end



function QuestManager:_boot()

    self:_attachWatchers()



    LocalPlayer.CharacterAdded:Connect(function()

        task.wait(1.5)

        self:_attachWatchers()

    end)

end



function QuestManager:HasQuest(): boolean

    return self:Evaluate().IsActive

end



function QuestManager:GetQuest(): QuestPayload

    return self:Evaluate()

end



function QuestManager:Destroy()

    for _, conn in ipairs(self._connections) do

        pcall(function() conn:Disconnect() end)

    end

    table.clear(self._connections)

    self.OnQuestUpdated:Destroy()

    self.OnQuestStateToggled:Destroy()

end



