local function FetchTyrantServers()

    local currentJob = tostring(game.JobId)

    local currentSea = workspace:GetAttribute("MAP")



    for _, ep in ipairs(TYRANT_CONFIG.Endpoints) do

        local url = string.format("%s/%s", TYRANT_CONFIG.BaseUrl, ep)

        local raw = nil



        if req_fn then

            local ok, res = pcall(function()

                return req_fn({

                    Url = url,

                    Method = "GET",

                    Headers = { ["Accept"] = "application/json", ["Cache-Control"] = "no-cache" }

                })

            end)

            if ok and res and (res.StatusCode == 200 or res.status == 200) then

                raw = res.Body or res.body

            end

        end



        if not raw and game.HttpGet then

            pcall(function() raw = game:HttpGet(url) end)

        end



        if raw and raw ~= "" then

            local ok, payload = pcall(HttpService.JSONDecode, HttpService, raw)

            if ok and type(payload) == "table" then

                local list = payload.data or payload.servers or payload.Servers or payload

                local valid = {}



                if type(list) == "table" then

                    for _, entry in ipairs(list) do

                        if type(entry) == "table" and (entry.JobId or entry.job_id) then

                            local jId = entry.JobId or entry.job_id

                            local decrypted = DecryptTyrantJobId(jId) or jId

                            local players = tonumber(entry.Players or entry.players or entry.count) or 0

                            local sea = entry.Sea or entry.sea or 3

                            local placeId = entry.PlaceId or entry.placeId or 7449423635



                            if decrypted and decrypted ~= currentJob and not IsTyrantVisited(decrypted) and players < TYRANT_CONFIG.MaxCapacity then

                                if not currentSea or not sea or sea == currentSea or sea == 3 then

                                    table.insert(valid, {

                                        JobId = tostring(decrypted),

                                        Players = players,

                                        PlaceId = placeId

                                    })

                                end

                            end

                        end

                    end

                end



                if #valid > 0 then

                    -- Bottom-up sort: tu it nguoi nhat den nhieu nguoi nhat

                    table.sort(valid, function(a, b) return a.Players < b.Players end)

                    return valid

                end

            end

        end

    end

    return nil

end



local function Hop(server)

    local JOB_ID = type(server) == "table" and (server.JobId or server.job_id) or tostring(server)

    if not JOB_ID or JOB_ID == "" then return false end

