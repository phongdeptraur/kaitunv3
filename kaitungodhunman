local IsTyrantHopping = false

local function HopTyrantServer()

    if IsTyrantHopping or IsHopping then return end

    IsTyrantHopping = true



    local hopCfg = _G.AxiomHopConfig or { UseNightApi = true, UseRealKidHop = true, BossDestination = "Tyrant of Skies" }

    local useNight = hopCfg.UseNightApi ~= false

    local useRealKid = hopCfg.UseRealKidHop == true



    SetLog("Tyrant Radar", string.format("Hop Engine: NightApi=%s | RealKid=%s | Dest=%s", tostring(useNight), tostring(useRealKid), tostring(hopCfg.BossDestination or "Tyrant of Skies")))



    task.spawn(function()

        -- 1. Nếu cấu hình chỉ dùng duy nhất RealKid Hop

        if useRealKid and not useNight then

            TriggerRealKidHop()

            task.wait(10)

            IsTyrantHopping = false

            return

        end



        -- 2. Nếu dùng Night API hoặc kết hợp cả 2: Ưu tiên Night API, fallback sang RealKid Hop

        while Axiom.Running and IsTyrantHopping do

            local serverQueue = nil

            if useNight then

                serverQueue = FetchTyrantServers()

            end



            if serverQueue and #serverQueue > 0 then

                local connected = false

                for idx, s in ipairs(serverQueue) do

                    if not Axiom.Running or not IsTyrantHopping then break end

                    SetLog("Tyrant Radar", string.format("[%d/%d] Joining Job %s (%d p)...", idx, #serverQueue, s.JobId:sub(1, 8), s.Players))

                    warn(string.format("[Axiom] Dispatching join: %s (%d players)", s.JobId, s.Players))

                    local success = Hop(s)

                    if success then

                        connected = true

                        task.wait(9)

                        break

                    else

                        task.wait(1)

                    end

                end



                if not connected and IsTyrantHopping then

                    if useRealKid then

                        SetLog("Tyrant Radar", "Night API servers full/failed. Switching to RealKid Hop...")

                        TriggerRealKidHop()

                        task.wait(10)

                    else

                        SetLog("Tyrant Radar", string.format("All %d servers full/failed. Waiting %ds to retry...", #serverQueue, TYRANT_CONFIG.RetryDelay))

                        task.wait(TYRANT_CONFIG.RetryDelay)

                    end

                end

            else

                -- Khi Night API hết server khả dụng -> Chuyển ngay sang RealKid Hop nếu bật kết hợp

                if useRealKid then

                    SetLog("Tyrant Radar", "No Night API server. Fallback to RealKid Hop...")

                    TriggerRealKidHop()

                    task.wait(10)

                else

                    SetLog("Tyrant Radar", string.format("No available Tyrant server (<%d p). Retrying in %ds...", TYRANT_CONFIG.MaxCapacity, TYRANT_CONFIG.RetryDelay))

                    task.wait(TYRANT_CONFIG.RetryDelay)

                end

            end

        end

        IsTyrantHopping = false

    end)

end



local function FindTyrantBoss()

    local searchContainers = {

