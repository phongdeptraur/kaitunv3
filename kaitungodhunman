local function TweenTo(targetCF, allowWhenRealKidActive)
    -- [QUY TẮC BẮT BUỘC]: RealKid đang chạy mà cần Tween (trừ khi nộp khẩn cấp Fire Essence) -> Phải Hop Low Server!
    if not allowWhenRealKidActive and (_G.RealKidMainActive or _G.RealKidMainLoaded or _G.RealKidHopLoaded) then
        SetLog("Refreshing Server", "RealKid active -> Hopping before Tween...")
        task.spawn(HopLowServer)
        return false
    end
    local hrp = GetHRP()
    if not hrp or not Axiom.Running or not Axiom.AutoGodhuman then return false end
    local cf = typeof(targetCF) == "CFrame" and targetCF or CFrame.new(targetCF)
    local dist = (hrp.Position - cf.Position).Magnitude
    if dist <= 5 then Axiom.IsTweening = false; return true end

    Axiom.IsTweening = true
    if Axiom.TweenInstance then pcall(function() Axiom.TweenInstance:Cancel() end) end
    Axiom.TweenInstance = TweenService:Create(hrp, TweenInfo.new(dist / 190, Enum.EasingStyle.Linear), { CFrame = cf })
    Axiom.TweenInstance:Play()

    local lastDist, strikes = dist, 0
    while Axiom.Running and Axiom.AutoGodhuman and Axiom.TweenInstance and Axiom.TweenInstance.PlaybackState == Enum.PlaybackState.Playing do
        task.wait(0.08)
        hrp = GetHRP()
        if not hrp then break end
        local curDist = (hrp.Position - cf.Position).Magnitude
        if curDist <= 5 then pcall(function() Axiom.TweenInstance:Cancel() end); break end
        if curDist > lastDist + 5 then
            strikes = strikes + 1
            if strikes >= 5 then
                pcall(function() Axiom.TweenInstance:Cancel() end)
                Axiom.IsTweening = false; task.wait(1); return false
            end
        end
        lastDist = curDist
    end
    Axiom.IsTweening = false
    return GetHRP() and (GetHRP().Position - cf.Position).Magnitude <= 25
end

