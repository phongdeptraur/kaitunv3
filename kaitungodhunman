    pcall(function()
        local rf = ReplicatedStorage:FindFirstChild("RF/GetAllItemValues", true)
        if rf and mId > 0 then
            for _, i in pairs(rf:InvokeServer() or {}) do
                if type(i) == "table" and tonumber(i.ItemId) == mId and tonumber(i.Value) then c = tonumber(i.Value); return end
