local function MatchMelee(tName, tgtName)
    if not tName or not tgtName then return false end
    local t, tg = tName:lower():gsub("[%s%-_]", ""), tgtName:lower():gsub("[%s%-_]", "")
    if tg == "electro" and t:find("claw") then return false end
    if tg == "dragonclaw" and t:find("talon") then return false end
    if tg == "fishmankarate" and t:find("sharkman") then return false end
    if tg == "blackleg" and t:find("death") then return false end
    if t == tg or t:find(tg, 1, true) then return true end
    for _, a in ipairs(MeleeAlias[tgtName] or {}) do if t:find(a, 1, true) then return true end end
    return false
end

local CachedMast, LastMastTick = nil, 0
local function FetchOwnedMastery()
    if CachedMast and (os.clock() - LastMastTick < 1.0) then return CachedMast end
    LastMastTick = os.clock(); local owned, raw = {}, {}
    pcall(function()
        local rf = ReplicatedStorage:FindFirstChild("RF/GetAllItemValues", true)
        if rf then
            for _, i in pairs(rf:InvokeServer() or {}) do
                if type(i) == "table" and i.ItemId and (i.Key == "Mastery" or i.Key == "CombatData") then raw[tonumber(i.ItemId)] = tonumber(i.Value) end
            end
        end
    end)
    for n, r in pairs(MeleeReg) do
        local m = r.ID and raw[r.ID]
        if m and m > 0 then owned[n] = { Name = n, Mastery = m, Req = r.Req }; Axiom.PersistentOwnedMelees[n] = m end
    end
    pcall(function()
        local t = GetChar() and GetChar():FindFirstChildOfClass("Tool")
        if t then
            for n, r in pairs(MeleeReg) do
                if MatchMelee(t.Name, n) then
                    local lvl = t:FindFirstChild("Level") and tonumber(t.Level.Value)
                    if lvl and lvl > 0 then
                        owned[n] = { Name = n, Mastery = math.max(lvl, (owned[n] and owned[n].Mastery) or 0), Req = r.Req }
                        Axiom.PersistentOwnedMelees[n] = owned[n].Mastery
                    end
                end
            end
        end
    end)
    for pN, pV in pairs(Axiom.PersistentOwnedMelees) do if not owned[pN] and MeleeReg[pN] then owned[pN] = { Name = pN, Mastery = pV, Req = MeleeReg[pN].Req } end end
    CachedMast = owned; return owned
end

local function GetMatCount(mName, mId)
