local SESSION_FILE, SESSION_TTL = "godhumansession", 60
local VisitedServers = {}

local function GetActiveSessions()
    local s = {}
    if isfile and isfile(SESSION_FILE) then
        pcall(function()
            local d = HttpService:JSONDecode(readfile(SESSION_FILE))
            local now = os.time()
            for jId, info in pairs(d or {}) do
                local t = (type(info) == "table" and info.time) or tonumber(info)
                if t and (now - t < SESSION_TTL) then s[tostring(jId)] = info end
            end
        end)
    end
    return s
end

local function IsServerOccupiedByClone(jobId)
    local occ = GetActiveSessions()[tostring(jobId)]
    if occ then
        local t = (type(occ) == "table" and occ.time) or tonumber(occ)
        local p = type(occ) == "table" and occ.player or ""
        if t and (os.time() - t < SESSION_TTL) and p ~= LocalPlayer.Name then return true end
    end
    return false
end

local function AttemptServerJoin(jobId)
    if not jobId or jobId == "" or jobId == tostring(game.JobId) or IsServerOccupiedByClone(jobId) then return end
    table.insert(VisitedServers, jobId)
    pcall(function()
        local s = GetActiveSessions()
        s[jobId] = { time = os.time(), player = LocalPlayer.Name, jobId = jobId }
        if writefile then writefile(SESSION_FILE, HttpService:JSONEncode(s)) end
    end)
    SetLog("Hopping Server", "Job: " .. tostring(jobId):sub(1, 8))
    local sb = ReplicatedStorage:FindFirstChild("__ServerBrowser")
    if not (sb and pcall(function() sb:InvokeServer("teleport", jobId) end)) then
        TeleportService:TeleportToPlaceInstance(game.PlaceId, jobId, LocalPlayer)
    end
    task.wait(5)
end

local function HopLowServer()
    if IsHopping then return end
    IsHopping = true
    SetLog("Hop Low Server", "Scanning low-player servers...")
    task.spawn(function()
        while Axiom.Running and IsHopping do
            local sb = ReplicatedStorage:FindFirstChild("__ServerBrowser")
            if sb then
                for page = 1, 50 do
                    local ok, res = pcall(function() return sb:InvokeServer(page) end)
                    if ok and type(res) == "table" then
                        for jId, data in pairs(res) do
                            local c = (type(data) == "table" and tonumber(data.Count)) or 99
                            if c <= 8 and tostring(jId) ~= tostring(game.JobId) and not table.find(VisitedServers, tostring(jId)) then
                                AttemptServerJoin(tostring(jId))
                            end
                        end
                    end
                end
            end
            task.wait(1)
        end
    end)
end

