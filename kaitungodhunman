local HopCFG = {

    MaxPages       = 150,

    MaxPlayers     = 8,

    PageRetries    = 2,

    PageStartDelay = 0.02,

    RetryDelay     = 0.05,

    ScanTimeout    = 3.5,

    BrowserWait    = 1.25,

    TeleportWait   = 6

}

local VisitedServers = {}

local IsHopping = false



-- Quét song song 150 pages từ ServerBrowser (chuẩn script hop nâng cấp)

local function ScanBrowserPages()

    local browser = ReplicatedStorage:FindFirstChild("__ServerBrowser")

    if not browser then return nil end



    local byJob = {}

    local completed = 0



    for page = 1, HopCFG.MaxPages do

        task.spawn(function()

            for attempt = 1, HopCFG.PageRetries do

                local ok, result = pcall(function() return browser:InvokeServer(page) end)

                if ok and type(result) == "table" then

                    for jobId, data in pairs(result) do

                        local count = (type(data) == "table" and tonumber(data.Count)) or tonumber(data) or 99

                        local id = tostring(jobId)

                        local reg = (type(data) == "table" and tostring(data.Region or "Unknown")) or "Unknown"



                        -- Lọc: Khác current server, chưa join lần này, không bị clone chiếm (TTL 60s), số người <= MaxPlayers

                        if id ~= tostring(game.JobId) 

                            and not table.find(VisitedServers, id) 

                            and not IsServerOccupiedByClone(id) 

                            and count <= HopCFG.MaxPlayers then



                            local numericPing = 90

                            if reg:find("Sing") then numericPing = 35

                            elseif reg:find("Japan") then numericPing = 90

                            elseif reg:find("Germ") then numericPing = 185

                            elseif reg:find("United States") or reg:find("US") then numericPing = 220

                            end



                            if not byJob[id] or count < byJob[id].Count then

                                byJob[id] = { JobId = id, Count = count, Region = reg, Ping = numericPing }

                            end

                        end

                    end

                    break

                end

                if attempt < HopCFG.PageRetries then task.wait(HopCFG.RetryDelay) end

            end

            completed = completed + 1

        end)

    end



    local deadline = os.clock() + HopCFG.ScanTimeout

    repeat task.wait(0.04) until completed >= HopCFG.MaxPages or os.clock() >= deadline



    local pool = {}

    for _, server in pairs(byJob) do pool[#pool + 1] = server end



    -- Ưu tiên ít người nhất -> Ping thấp nhất

    table.sort(pool, function(a, b)

        if a.Count == b.Count then return a.Ping < b.Ping end

        return a.Count < b.Count

    end)

    return pool

end



local function AttemptServerJoin(server)

    local JOB_ID = type(server) == "table" and (server.JobId or server.job_id or server.id) or tostring(server)

    if not JOB_ID or JOB_ID == "" or JOB_ID == tostring(game.JobId) then return end

    if IsServerOccupiedByClone(JOB_ID) then return end



    table.insert(VisitedServers, JOB_ID)



    -- Khóa chỗ trong file godhumansession ngay trước khi teleport

    pcall(function()

        local sessions = GetActiveSessions()

        sessions[JOB_ID] = {

            time = os.time(),

            player = LocalPlayer.Name,

            jobId = JOB_ID,

            activity = "Hopping"

        }

        if writefile then writefile(SESSION_FILE, HttpService:JSONEncode(sessions)) end

    end)



    Axiom.StatusText = string.format("Hop: Connecting Job %s...", tostring(JOB_ID):sub(1, 8))

    repeat task.wait() until game:IsLoaded()



    -- Cách Join chuẩn của Blox Fruits

    local sb = ReplicatedStorage:FindFirstChild("__ServerBrowser")

    if not (sb and pcall(function() sb:InvokeServer("teleport", JOB_ID) end)) then

        TeleportService:TeleportToPlaceInstance(PlaceId, JOB_ID, LocalPlayer)

    end

    task.wait(6)

end



local function HopLowServer()

    if IsHopping then return end

    IsHopping = true

    Axiom.StatusText = "Scanning full servers with Anti-Collision (<= 8 players)..."

    task.spawn(function()

        while Axiom.Running and IsHopping do

            local pool = ScanBrowserPages()

            if pool and #pool > 0 then

                for _, s in ipairs(pool) do

                    if not IsServerOccupiedByClone(s.JobId) then

                        AttemptServerJoin(s)

                        task.wait(0.5)

                    end

                end

            else

                local okApi, response = pcall(function()

                    return game:HttpGet(string.format("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100", game.PlaceId))

                end)

                if okApi and response then

                    local okJson, data = pcall(function() return HttpService:JSONDecode(response) end)

                    if okJson and data and data.data then

                        for _, sData in ipairs(data.data) do

                            local sId = tostring(sData.id)

                            local sCount = tonumber(sData.playing) or 0

                            if sCount <= HopCFG.MaxPlayers 

                                and sId ~= tostring(game.JobId) 

                                and not table.find(VisitedServers, sId) 

                                and not IsServerOccupiedByClone(sId) then

                                AttemptServerJoin({ JobId = sId, Count = sCount })

                                task.wait(1)

                            end

                        end

                    end

                end

            end

            task.wait(1)

        end

    end)

end



local function CheckPlayerNear(radius)

    radius = radius or 350

    local char = LocalPlayer.Character

    local myRoot = char and char:FindFirstChild("HumanoidRootPart")

    if not myRoot then return false, nil, 0 end



    for _, p in ipairs(Players:GetPlayers()) do

        if p ~= LocalPlayer and p.Character then

            local pRoot = p.Character:FindFirstChild("HumanoidRootPart")

            local pHum = p.Character:FindFirstChildOfClass("Humanoid")

            if pRoot and pHum and pHum.Health > 0 then

                local dist = (pRoot.Position - myRoot.Position).Magnitude

                if dist <= radius then

                    return true, p.DisplayName or p.Name, dist

                end

            end

        end

    end

    return false, nil, 0

end



