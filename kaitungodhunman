    local parent = (gethui and gethui()) or game:GetService("CoreGui"):FindFirstChild("RobloxGui") or LocalPlayer:WaitForChild("PlayerGui")
    local sg = Instance.new("ScreenGui", parent)
    sg.Name = "Axiom_Minimal_HUD"; sg.ResetOnSpawn = false
    Axiom.ScreenGui = sg

    local main = Instance.new("Frame", sg)
    main.Size = UDim2.new(0, 320, 0, 290)
    main.Position = UDim2.new(0.5, -160, 0.5, -145)
    main.BackgroundColor3 = Color3.fromRGB(16, 18, 25)
    main.Active = true; main.Draggable = true
    Instance.new("UICorner", main).CornerRadius = UDim.new(0, 8)

    local title = Instance.new("TextLabel", main)
    title.Size = UDim2.new(1, -140, 0, 28); title.Position = UDim2.new(0, 10, 0, 4)
    title.Text = "⚡ AXIOM GODHUMAN"; title.Font = Enum.Font.GothamBold; title.TextSize = 11
    title.TextColor3 = Color3.fromRGB(255, 215, 0); title.BackgroundTransparency = 1
    title.TextXAlignment = Enum.TextXAlignment.Left

    local toggleBtn = Instance.new("TextButton", main)
    toggleBtn.Size = UDim2.new(0, 60, 0, 22); toggleBtn.Position = UDim2.new(1, -130, 0, 7)
    toggleBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 95); toggleBtn.Text = "ON"
    toggleBtn.Font = Enum.Font.GothamBold; toggleBtn.TextSize = 10; toggleBtn.TextColor3 = Color3.new(1, 1, 1)
    Instance.new("UICorner", toggleBtn).CornerRadius = UDim.new(0, 4)

    local unloadBtn = Instance.new("TextButton", main)
    unloadBtn.Size = UDim2.new(0, 58, 0, 22); unloadBtn.Position = UDim2.new(1, -65, 0, 7)
    unloadBtn.BackgroundColor3 = Color3.fromRGB(180, 45, 55); unloadBtn.Text = "UNLOAD"
    unloadBtn.Font = Enum.Font.GothamBold; unloadBtn.TextSize = 10; unloadBtn.TextColor3 = Color3.new(1, 1, 1)
    Instance.new("UICorner", unloadBtn).CornerRadius = UDim.new(0, 4)

    local mainLog = Instance.new("TextLabel", main)
    mainLog.Size = UDim2.new(1, -20, 0, 18); mainLog.Position = UDim2.new(0, 10, 0, 34)
    mainLog.Font = Enum.Font.GothamBold; mainLog.TextSize = 10; mainLog.TextColor3 = Color3.fromRGB(255, 215, 0)
    mainLog.BackgroundTransparency = 1; mainLog.TextXAlignment = Enum.TextXAlignment.Left
    Axiom.MainLogLabel = mainLog

    local subLog = Instance.new("TextLabel", main)
    subLog.Size = UDim2.new(1, -20, 0, 18); subLog.Position = UDim2.new(0, 10, 0, 52)
    subLog.Font = Enum.Font.Gotham; subLog.TextSize = 10; subLog.TextColor3 = Color3.fromRGB(0, 215, 255)
    subLog.BackgroundTransparency = 1; subLog.TextXAlignment = Enum.TextXAlignment.Left
    Axiom.SubLogLabel = subLog

    local boneLbl = Instance.new("TextLabel", main)
    boneLbl.Size = UDim2.new(1, -20, 0, 20); boneLbl.Position = UDim2.new(0, 10, 0, 72)
    boneLbl.Font = Enum.Font.GothamBold; boneLbl.TextSize = 10; boneLbl.TextColor3 = Color3.fromRGB(0, 255, 150)
    boneLbl.BackgroundTransparency = 1; boneLbl.TextXAlignment = Enum.TextXAlignment.Left
    boneLbl.Text = "🦴 Bones: ... | CD: Ready"

    local scroll = Instance.new("ScrollingFrame", main)
    scroll.Size = UDim2.new(1, -20, 0, 182); scroll.Position = UDim2.new(0, 10, 0, 96)
    scroll.BackgroundColor3 = Color3.fromRGB(22, 25, 36); scroll.BorderSizePixel = 0; scroll.ScrollBarThickness = 3
    Instance.new("UICorner", scroll).CornerRadius = UDim.new(0, 6)
    local layout = Instance.new("UIListLayout", scroll); layout.Padding = UDim.new(0, 4)

    toggleBtn.MouseButton1Click:Connect(function()
        Axiom.AutoGodhuman = not Axiom.AutoGodhuman
        _G.AutoGodhuman = Axiom.AutoGodhuman
        toggleBtn.Text = Axiom.AutoGodhuman and "ON" or "OFF"
        toggleBtn.BackgroundColor3 = Axiom.AutoGodhuman and Color3.fromRGB(0, 170, 95) or Color3.fromRGB(70, 75, 90)
        if not Axiom.AutoGodhuman then SetAntiGravity(false) end
    end)

    unloadBtn.MouseButton1Click:Connect(function() if _G.AxiomUnload then _G.AxiomUnload() end end)

    task.spawn(function()
        while Axiom.Running do
            local bCount = GetBonesCount()
            local onCd, cdTime = CheckBoneCooldown()
            boneLbl.Text = string.format("🦴 Bones: %d | %s | GH: %s", bCount, onCd and ("CD: " .. tostring(cdTime)) or "CD: Ready", tostring(CheckGodhumanStatus()))
            boneLbl.TextColor3 = onCd and Color3.fromRGB(255, 170, 60) or Color3.fromRGB(0, 255, 150)

            local owned = FetchOwnedMastery()
            for name, lbl in pairs(Axiom.Cards) do
                if not owned[name] then pcall(function() lbl:Destroy() end); Axiom.Cards[name] = nil end
            end
            for name, d in pairs(owned) do
                local lbl = Axiom.Cards[name]
                if not lbl then
                    lbl = Instance.new("TextLabel", scroll)
                    lbl.Size = UDim2.new(1, -10, 0, 22); lbl.BackgroundTransparency = 1
                    lbl.Font = Enum.Font.GothamBold; lbl.TextSize = 10
                    lbl.TextXAlignment = Enum.TextXAlignment.Left
                    Axiom.Cards[name] = lbl
                end
                lbl.Text = string.format("  🥋 %s: %d / %d", name, d.Mastery, d.Req)
                lbl.TextColor3 = (d.Mastery >= d.Req) and Color3.fromRGB(0, 255, 140) or Color3.fromRGB(255, 200, 70)
            end
            scroll.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 8)
            task.wait(0.6)
        end
    end)
end

