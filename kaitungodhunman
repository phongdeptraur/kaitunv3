    local ok1, count1 = pcall(function()

        local rep = require(ReplicatedStorage.Util.ItemReplication)

        local itemIdMod = require(ReplicatedStorage.Util.ItemId)

        local qKey = (rep.KEYS and rep.KEYS.QUANTITY) or (rep.KEYS and rep.KEYS.Quantity) or rep.Quantity

        if qKey then

            local items = rep:GetItems(qKey)

            if items then

                for _, item in pairs(items) do

                    local meta = itemIdMod.getDataFromId(item.ItemId):unwrap()

                    if meta and (meta.StorageKey == matName or meta.Name == matName) and item.Value and item.Value >= 1 then

                        return item.Value

                    end

                end

            end

        end

        return nil

    end)

    if ok1 and count1 then 

        CachedMaterialCounts[matName] = count1

        return count1 

    end



    -- Tier 2: Quét mảng RF/GetAllItemValues

    local ok2, count2 = pcall(function()

        local rf = ReplicatedStorage:FindFirstChild("RF/GetAllItemValues", true)

        if rf and matId then

            local res = rf:InvokeServer()

            if type(res) == "table" then

                for _, item in pairs(res) do

                    if type(item) == "table" and tonumber(item.ItemId) == matId then

                        local val = tonumber(item.Value)

                        if val and val > 0 then return val end

                    end

                end

            end

        end

        return nil

    end)

    if ok2 and count2 then 

        CachedMaterialCounts[matName] = count2

        return count2 

