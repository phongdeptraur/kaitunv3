local function SetAntiGravity(enable)
    local hrp = GetHRP()
    if enable then
        workspace.Gravity = 0
        if hrp then
            local bv = hrp:FindFirstChild("__AxiomHoverStabilizer") or Instance.new("BodyVelocity")
